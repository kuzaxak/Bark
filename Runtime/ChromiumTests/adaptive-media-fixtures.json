  "configuration": {
    "hls.js": {
      "entry": "media/master.m3u8",
      "construction": "Illustrative, browser-unverified: new Hls({autoStartLoad:false,startLevel:0}); register MANIFEST_PARSED listener first (set currentLevel=0; startLoad(0)), then attachMedia(video) and loadSource(url). enableWorker retains default true.",
      "manual_switch": "hls.currentLevel = 1 (or 0); never use native-HLS fallback for this MSE case"
    },
    "dash.js": {
      "entry": "media/manifest.mpd",
      "construction": "Illustrative, browser-unverified: dashjs.MediaPlayer().create(); updateSettings({streaming:{abr:{autoSwitchBitrate:{video:false,audio:false}}}}); register STREAM_INITIALIZED listener first (setRepresentationForTypeById(\"video\",\"0\",true)), then initialize(video,url,false).",
      "manual_switch": "player.setRepresentationForTypeById(\"video\",\"1\",true) (or \"0\")"
    }
  },
  "expected_sequence": [
    "User starts playback on 320x180 rendition (representation/level 0); observe advancing video and 440 Hz stereo audio.",
    "At media time 2 seconds request 640x360 (1), require player confirmation plus a decoded 640x360 frame before media time 6 seconds; no fatal error, monotonic media time and continuous audio.",
    "Pause, seek to 7.25 seconds; require seek completion/currentTime within 1/24 second and resumed frames from the 6\u20138 second segment; no new document/bootstrap.",
    "At media time 8 seconds request 320x180 (0), require confirmation plus decoded 320x180 frame before 12 seconds; reach ended once, total duration approximately 12 seconds."
  ],
  "coverage_limits": [
    "Video keyframes/segment boundaries exactly aligned at 0,2,4,6,8,10 seconds; shared AAC audio segments follow 1024-sample packet boundaries, not exact 2-second video cuts.",
    "This fixed synthetic VOD does not cover live latency, encryption/CDM, captions, discontinuities, network adaptation, intended commercial services, long-duration stability, native HLS, hardware decoding or either native architecture.",
    "Player initialization and switch APIs source-inspected only; no browser, server, playback, seek/switch or performance execution performed."
  ],
