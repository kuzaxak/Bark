# The engine recipe builds the locked Rust matcher with Cargo's macOS target
# triple. The link and both runtime copies consume the same architecture.
assert(is_mac)
assert(current_cpu == "x64" || current_cpu == "arm64")
if (current_cpu == "arm64") {
  rust_target = "aarch64-apple-darwin"
} else {
  rust_target = "x86_64-apple-darwin"
}
matcher = "//out/BarkCargo/$rust_target/release/libnook_adblock.dylib"

source_set("native_content_blocker") {
  sources = [
    "native_content_blocker.cc",
    "native_content_blocker.h",
  ]
  public_deps = [
    "//base",
    "//components/keyed_service/core",
    "//url",
  ]
  deps = [
    ":nook_adblock",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui/browser_window",
    "//chrome/common:mojo_bindings",
    "//chrome/common:resources",
    "//components/back_forward_cache",
    "//components/tabs:public",
    "//content/public/browser",
    "//crypto",
    "//net",
    "//services/network/public/cpp",
    "//ui/base",
  ]
}
source_set("nook_adblock") {
  sources = [ "nook_adblock/nook_adblock.h" ]
  libs = [ matcher ]
  data_deps = [ ":nook_adblock_runtime" ]
}

copy("nook_adblock_runtime") {
  sources = [ matcher ]
  outputs = [ "$root_out_dir/Libraries/{{source_file_part}}" ]
}

bundle_data("nook_adblock_library") {
  sources = [ "$root_out_dir/Libraries/libnook_adblock.dylib" ]
  outputs = [ "{{bundle_contents_dir}}/Libraries/{{source_file_part}}" ]
  public_deps = [ ":nook_adblock_runtime" ]
}
