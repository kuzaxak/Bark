+void ChromeExtensionsBrowserClient::NativeNavigationBlocked(
+    content::BrowserContext* context, const content::WeakDocumentPtr& document,
+    const WebRequestInfo& request) {
+#if BUILDFLAG(IS_MAC)
+  auto* frame = document.AsRenderFrameHostIfValid();
+  if (!frame || frame->GetBrowserContext() != context || !request.navigation_id ||
+      !request.is_navigation_request ||
+      request.web_request_type != WebRequestResourceType::MAIN_FRAME) return;
+  barc::RecordNativeNavigationBlock(content::WebContents::FromRenderFrameHost(frame),
+                                   *request.navigation_id, request.url);
+#endif
+}
