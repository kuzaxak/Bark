+void BrowserWidget::OnClosingAllBrowsers(bool closing) {
+  if (closing && HasPhysicalClosePending() && !IsPhysicalCloseCommitted()) {
+    // Reset the local-purpose controller callbacks before application shutdown
+    // installs its own. Local cancellation must not broadcast quit
+    // cancellation.
+    CancelPhysicalClose();
