+void BrowserWidget::RemoveLogicalBrowserView(BrowserView* closing) {
+  CHECK(closing);
+  CHECK_EQ(closing->browser_widget(), this);
+  const bool native_gone = !browser_native_widget_;
+  auto clients = GetLogicalBrowserViews();
+  CHECK_GT(clients.size(), 1u);
+  BrowserView* survivor = nullptr;
+  for (BrowserView* candidate : clients) {
+    if (candidate != closing &&
+        (!survivor || candidate == selected_browser_view())) {
+      survivor = candidate;
+    }
+  }
+  CHECK(survivor);
+  auto alive = GetWeakPtr();
+  auto closing_alive = closing->weak_ptr_factory_.GetWeakPtr();
+  auto survivor_alive = survivor->weak_ptr_factory_.GetWeakPtr();
+  if (!native_gone && closing->ShouldSaveWindowPlacement()) {
+    gfx::Rect bounds;
+    ui::mojom::WindowShowState state;
+    GetWindowPlacement(&bounds, &state);
+    closing->SaveWindowPlacement(bounds, state);
+  }
+  if (!alive || !closing_alive || !survivor_alive) {
+    return;
+  }
+  // The accepted close callback runs while this browser's controllers live.
+  if (!native_gone) {
+    NotifyClientWillClose(closing);
+  }
+  if (!alive || !closing_alive || !survivor_alive) {
+    return;
+  }
+  if (closing->owned_browser_widget_) {
+    closing->TransferPhysicalWidgetOwnershipTo(survivor);
+  }
+  const bool was_selected = closing == selected_browser_view();
+  if (was_selected && native_gone) {
+    // Widget::OnNativeWidgetDestroyed already finalized every delegate. Do not
+    // reattach one or touch Cocoa state after the native window is gone.
+    browser_view_ = survivor;
+    browser_frame_view_ = survivor->GetFrameView();
+    root_view_->SelectBrowserView(survivor);
+    const bool selected = non_client_view()->SelectClientFrame(survivor);
+    if (!alive || !closing_alive || !survivor_alive) {
+      return;
+    }
+    CHECK(selected);
+  } else if (was_selected) {
+    const bool selected = SelectLogicalBrowserViewInternal(survivor, true);
+    if (!alive || !closing_alive || !survivor_alive) {
+      return;
+    }
+    CHECK(selected);
+  }
+  // Stop outgoing callbacks before destroying the extension/exclusive-access
+  // controllers they consult. Deactivation already happened during handoff.
+  closing->paint_as_active_subscription_ = {};
+  closing->focus_manager_observation_.Reset();
+  if (closing->widget_observation_.IsObservingSource(this)) {
+    closing->OnWidgetDestroying(this);
+  }
+  closing->browser()->GetFeatures().TearDownPreBrowserWindowDestruction();
+  if (!alive || !closing_alive || !survivor_alive) {
+    return;
+  }
+  auto released = non_client_view()->ReleaseClientFrame(closing);
+  CHECK(released);
+  if (!native_gone) {
+    FinalizeClientDelegate(closing, closing);
+  }
+  released.reset();
+  if (!alive || !survivor_alive) {
+    return;
+  }
+  if (was_selected && !native_gone && !IsPhysicalCloseCommitted()) {
+    // Own prompts/controllers are gone; refresh survivor metadata and only then
+    // restore its logical activation and focus using the normal selected path.
+    RefreshSelectedLogicalBrowserView();
+  }
+}
+
+bool BrowserWidget::IsPhysicalCloseCommitted() const {
+  return physical_close_phase_ == PhysicalClosePhase::kCommitted;
+}
+
+views::CloseRequestResult BrowserWidget::PreparePhysicalClose() {
+  if (physical_close_phase_ == PhysicalClosePhase::kIdle) {
+    if (browser_shutdown::IsTryingToQuit() ||
+        tab_drag_kind_ != TabDragKind::kNone) {
+      return views::CloseRequestResult::kCannotClose;
+    }
+    for (BrowserView* view : GetLogicalBrowserViews()) {
+      auto* controller = UnloadController::From(view->browser());
+      if (!controller->AcquireNativeWindowGroupClose(
+              base::BindOnce(&BrowserWidget::CancelPhysicalClose,
+                             physical_close_weak_factory_.GetWeakPtr()))) {
+        CancelPhysicalClose();
+        return views::CloseRequestResult::kCannotClose;
+      }
+      physical_close_participants_.push_back(view->browser()->GetWeakPtr());
+    }
+    physical_close_phase_ = PhysicalClosePhase::kWarnings;
+    physical_close_index_ = 0;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&BrowserWidget::ContinuePhysicalClose,
+                                  physical_close_weak_factory_.GetWeakPtr()));
+  }
+  // Committed closes drain each real Browser through its existing controller;
+  // final owner destruction performs the physical native-window teardown.
+  return views::CloseRequestResult::kCannotClose;
+}
+
+bool BrowserWidget::ValidatePhysicalCloseParticipants() const {
+  const auto current = GetLogicalBrowserViews();
+  if (current.size() != physical_close_participants_.size()) {
+    return false;
+  }
+  for (const auto& browser : physical_close_participants_) {
+    if (!browser || browser->IsDeleteScheduled()) {
+      return false;
+    }
+    auto* view = BrowserView::GetBrowserViewForBrowser(browser.get());
+    if (!view || view->browser_widget() != this ||
+        std::ranges::find(current, view) == current.end() ||
+        UnloadController::From(browser.get())->GetBrowserClosingStatus() ==
+            BrowserWindowInterface::ClosingStatus::kDeniedByPolicy) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void BrowserWidget::CancelPhysicalClose() {
+  physical_close_weak_factory_.InvalidateWeakPtrs();
+  for (const auto& browser : physical_close_participants_) {
+    if (browser && !browser->IsDeleteScheduled()) {
+      UnloadController::From(browser.get())->CancelNativeWindowGroupClose();
+    }
+  }
+  physical_close_participants_.clear();
+  physical_close_index_ = 0;
+  physical_close_waiting_ = false;
+  physical_close_phase_ = PhysicalClosePhase::kIdle;
+}
+
+void BrowserWidget::ContinuePhysicalClose() {
+  if (physical_close_phase_ == PhysicalClosePhase::kIdle ||
+      physical_close_phase_ == PhysicalClosePhase::kCommitted ||
+      physical_close_waiting_) {
+    return;
+  }
+  if (!ValidatePhysicalCloseParticipants()) {
+    CancelPhysicalClose();
+    return;
+  }
+  auto alive = physical_close_weak_factory_.GetWeakPtr();
+  while (physical_close_index_ < physical_close_participants_.size()) {
+    const size_t index = physical_close_index_++;
+    auto browser = physical_close_participants_[index];
+    if (physical_close_phase_ == PhysicalClosePhase::kWarnings) {
+      bool profile_warned = false;
+      for (size_t previous = 0; previous < index; ++previous) {
+        profile_warned |=
+            physical_close_participants_[previous]->GetProfile() ==
+            browser->GetProfile();
+      }
+      if (profile_warned) {
+        continue;
+      }
+      auto* controller = UnloadController::From(browser.get());
+      // Only this synchronous call sees raw participants. Nothing is captured.
+      std::vector<BrowserWindowInterface*> group;
+      for (const auto& participant : physical_close_participants_) {
+        group.push_back(participant.get());
+      }
