+void ChromeRenderFrameObserver::ResetNookTranslation() {
+  nook_translation_weak_.InvalidateWeakPtrs();
+  nook_translation_client_.reset();
+  nook_translation_object_.Reset();
+  nook_translation_document_.reset();
+  nook_translation_generation_ = 0;
+}
+
+void ChromeRenderFrameObserver::NookTranslationDisconnected() {
+  auto* frame = render_frame()->GetWebFrame();
+  if (frame && nook_translation_document_ &&
+      frame->GetDocument().Token() == *nook_translation_document_ && !nook_translation_object_.IsEmpty()) {
+    auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+    v8::HandleScope handles(isolate);
+    v8::TryCatch errors(isolate);
+    auto context = frame->GetScriptContextFromWorldId(isolate, ISOLATED_WORLD_ID_NOOK_TRANSLATE);
+    if (!context.IsEmpty()) {
+      v8::Context::Scope scope(context);
+      auto object = nook_translation_object_.Get(isolate);
+      v8::Local<v8::Value> method;
+      if (object->Get(context, v8::String::NewFromUtf8Literal(isolate, "restore")).ToLocal(&method) &&
+          method->IsFunction()) {
+        // Rebinding the same document must wait for this old instance's
+        // restoration; otherwise a suspended cleanup could overwrite new work.
+        const auto document = *nook_translation_document_;
+        nook_translation_cleanup_document_ = document;
+        ResetNookTranslation();
+        frame->RequestExecuteV8Function(context, method.As<v8::Function>(), object, 0, nullptr,
+            base::BindOnce([](base::WeakPtr<ChromeRenderFrameObserver> self,
+                              blink::DocumentToken document,
+                              std::optional<base::Value>, base::TimeTicks) {
+              if (self && self->nook_translation_cleanup_document_ == document)
+                self->nook_translation_cleanup_document_.reset();
+            }, nook_translation_weak_.GetWeakPtr(), document));
+        return;
+      }
+    }
+  }
+  ResetNookTranslation();
+}
+
+void ChromeRenderFrameObserver::NookTranslationNodes(gin::Arguments* arguments) {
+  auto* frame = render_frame()->GetWebFrame();
+  if (!frame || !render_frame()->IsMainFrame() ||
+      !nook_translation_document_ ||
+      frame->GetDocument().Token() != *nook_translation_document_ ||
+      !nook_translation_client_.is_bound()) return;
+  v8::Local<v8::Value> input;
+  if (!arguments->GetNext(&input)) return;
+  if (input->IsNull()) {
+    nook_translation_client_->NodesChanged(*nook_translation_document_, nook_translation_generation_, true, {});
+    nook_translation_client_.reset();
+    return;
+  }
+  auto value = content::V8ValueConverter::Create()->FromV8Value(
+      input, frame->GetScriptContextFromWorldId(arguments->isolate(),
+                                              ISOLATED_WORLD_ID_NOOK_TRANSLATE));
+  if (!value) return;
+  auto nodes = NookTranslationNodesFromValue(*value);
+  if (!nodes.empty()) nook_translation_client_->NodesChanged(
+      *nook_translation_document_, nook_translation_generation_, false, std::move(nodes));
+}
+
+void ChromeRenderFrameObserver::NookTranslate(
+    const blink::DocumentToken& document, uint64_t generation, int32_t operation,
+    std::vector<chrome::mojom::NookTranslationNodePtr> pairs,
+    mojo::PendingAssociatedRemote<chrome::mojom::NookTranslationClient> client,
+    NookTranslateCallback callback) {
+  // Creating the isolated context evaluates no page/controller code. Actual
+  // factory and operation calls run through Blink's suspension-aware executor.
+  auto* frame = render_frame()->GetWebFrame();
+  if (!frame || !render_frame()->IsMainFrame() ||
+      frame->GetDocument().Token() != document || !generation ||
+      !GURL(frame->GetDocument().Url()).SchemeIsHTTPOrHTTPS()) {
+    std::move(callback).Run(false, "", "", {});
+    return;
+  }
+  auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handles(isolate);
+  auto context = frame->GetScriptContextFromWorldId(
+      isolate, ISOLATED_WORLD_ID_NOOK_TRANSLATE);
+  if (context.IsEmpty()) {
+    std::ignore = frame->ExecuteScriptInIsolatedWorldAndReturnValue(
+        ISOLATED_WORLD_ID_NOOK_TRANSLATE,
+        blink::WebScriptSource(blink::WebString::FromUtf8("void 0")),
+        blink::BackForwardCacheAware::kAllow);
+    context = frame->GetScriptContextFromWorldId(
+        isolate, ISOLATED_WORLD_ID_NOOK_TRANSLATE);
+  }
+  if (context.IsEmpty()) {
+    std::move(callback).Run(false, "", "", {});
+    return;
+  }
+  struct PendingOperation {
+    std::vector<chrome::mojom::NookTranslationNodePtr> pairs;
+    mojo::PendingAssociatedRemote<chrome::mojom::NookTranslationClient> client;
+    NookTranslateCallback callback;
+  };
+  auto pending = std::make_shared<PendingOperation>(
+      PendingOperation{std::move(pairs), std::move(client), std::move(callback)});
+  const uint64_t request = ++nook_translation_request_;
+  v8::Context::Scope context_scope(context);
+  v8::MicrotasksScope microtasks_scope(
+      context, v8::MicrotasksScope::kDoNotRunMicrotasks);
+  v8::Local<v8::Function> execute;
+  if (!gin::CreateFunctionTemplate(isolate, base::BindRepeating(
+          [](base::WeakPtr<ChromeRenderFrameObserver> self,
+             blink::DocumentToken document, uint64_t generation,
+             uint64_t request, int32_t operation,
+             std::shared_ptr<PendingOperation> pending,
+             gin::Arguments* arguments) {
+            if (!self || !pending->callback ||
+                self->nook_translation_request_ != request) return;
+            auto* frame = self->render_frame()->GetWebFrame();
+            if (!frame || frame->GetDocument().Token() != document ||
+                frame->GetScriptContextFromWorldId(arguments->isolate(),
+                    ISOLATED_WORLD_ID_NOOK_TRANSLATE) !=
+                    arguments->isolate()->GetCurrentContext()) return;
+            self->NookTranslateNow(document, generation, operation,
+                std::move(pending->pairs), std::move(pending->client),
+                std::move(pending->callback));
+          }, nook_translation_weak_.GetWeakPtr(), document, generation,
+          request, operation, pending))->GetFunction(context).ToLocal(&execute)) {
+    std::move(pending->callback).Run(false, "", "", {});
+    return;
+  }
+  frame->RequestExecuteV8Function(context, execute, context->Global(), 0, nullptr,
+      base::BindOnce([](std::shared_ptr<PendingOperation> pending,
+                        std::optional<base::Value>, base::TimeTicks) {
+        // Context destruction, supersession and rejected execution still own
+        // the exact Mojo response, even when the observer has gone away.
+        if (pending->callback)
+          std::move(pending->callback).Run(false, "", "", {});
+      }, std::move(pending)));
+}
+
+void ChromeRenderFrameObserver::NookTranslateNow(
+    const blink::DocumentToken& document, uint64_t generation, int32_t operation,
+    std::vector<chrome::mojom::NookTranslationNodePtr> pairs,
+    mojo::PendingAssociatedRemote<chrome::mojom::NookTranslationClient> client,
+    NookTranslateCallback callback) {
+  auto fail = [&] { std::move(callback).Run(false, "", "", {}); };
+  auto* frame = render_frame()->GetWebFrame();
+  if (!frame || !render_frame()->IsMainFrame() || operation < 0 || operation > 3 ||
+      !generation || nook_translation_cleanup_document_ == document || frame->GetDocument().IsNull() ||
+      frame->GetDocument().Token() != document ||
+      !GURL(frame->GetDocument().Url()).SchemeIsHTTPOrHTTPS() || pairs.size() > 128) {
+    fail(); return;
+  }
+  // Only sampling may establish a fresh document/generation. Delayed translated
+  // text never creates a replacement instance in a new document.
+  if (nook_translation_document_ != document || nook_translation_generation_ != generation) {
+    if (operation != 0) { fail(); return; }
+    ResetNookTranslation();
+    nook_translation_document_ = document;
+    nook_translation_generation_ = generation;
+  }
+  auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handles(isolate);
+  v8::TryCatch errors(isolate);
+  if (nook_translation_object_.IsEmpty()) {
+    const auto source = ui::ResourceBundle::GetSharedInstance().LoadDataResourceString(IDR_NOOK_PAGE_TRANSLATE);
+    auto factory = frame->ExecuteScriptInIsolatedWorldAndReturnValue(
+        ISOLATED_WORLD_ID_NOOK_TRANSLATE,
+        blink::WebScriptSource(blink::WebString::FromUtf8(source)),
+        blink::BackForwardCacheAware::kAllow);
+    if (factory.IsEmpty() || !factory->IsFunction()) { fail(); return; }
+    auto context = frame->GetScriptContextFromWorldId(isolate, ISOLATED_WORLD_ID_NOOK_TRANSLATE);
+    if (context.IsEmpty()) { fail(); return; }
+    v8::Context::Scope scope(context);
+    v8::Local<v8::Function> notify;
+    if (!gin::CreateFunctionTemplate(isolate, base::BindRepeating(
+          &ChromeRenderFrameObserver::NookTranslationNodes, nook_translation_weak_.GetWeakPtr()))
+          ->GetFunction(context).ToLocal(&notify)) { fail(); return; }
+    v8::Local<v8::Value> argument = notify;
+    v8::Local<v8::Value> object;
+    if (!factory.As<v8::Function>()->Call(context, context->Global(), 1, &argument).ToLocal(&object) ||
+        !object->IsObject()) { fail(); return; }
+    nook_translation_object_.Reset(isolate, object.As<v8::Object>());
+  }
+  auto context = frame->GetScriptContextFromWorldId(isolate, ISOLATED_WORLD_ID_NOOK_TRANSLATE);
+  if (context.IsEmpty()) { fail(); return; }
+  v8::Context::Scope scope(context);
+  auto object = nook_translation_object_.Get(isolate);
+  constexpr std::array<const char*, 4> names = {"sample", "start", "apply", "restore"};
+  v8::Local<v8::Value> method;
+  if (!object->Get(context, v8::String::NewFromUtf8(isolate, names[operation]).ToLocalChecked()).ToLocal(&method) ||
+      !method->IsFunction()) { fail(); return; }
+  if (operation == 1) {
+    if (client.is_valid()) {
+      nook_translation_client_.reset();
+      nook_translation_client_.Bind(std::move(client));
+      nook_translation_client_.set_disconnect_handler(base::BindOnce(
+          &ChromeRenderFrameObserver::NookTranslationDisconnected, nook_translation_weak_.GetWeakPtr()));
+    } else if (!nook_translation_client_.is_bound() || !nook_translation_client_.is_connected()) {
+      fail(); return;
+    }
+  }
+  base::ListValue translated;
+  size_t bytes = 0;
+  for (const auto& pair : pairs) {
+    bytes += pair->id.size() + pair->text.size();
+    if (pair->id.size() > 32 || pair->text.size() > 131072 || bytes > 512 * 1024) { fail(); return; }
+    base::ListValue entry;
+    entry.Append(pair->id); entry.Append(pair->text);
+    translated.Append(std::move(entry));
+  }
+  auto argument = content::V8ValueConverter::Create()->ToV8Value(base::Value(std::move(translated)), context);
+  v8::Local<v8::Value> result;
+  if (!method.As<v8::Function>()->Call(context, object, operation == 2 ? 1 : 0, &argument).ToLocal(&result)) {
+    // start() restored locally before throwing. Drop queued old batches and
+    // cancel its disconnect handler rather than scheduling redundant cleanup.
+    if (operation == 1) nook_translation_client_.reset();
+    fail(); return;
+  }
+  auto value = content::V8ValueConverter::Create()->FromV8Value(result, context);
+  std::string text, language;
+  std::vector<chrome::mojom::NookTranslationNodePtr> nodes;
+  if (operation == 0 && value && value->is_dict()) {
+    const auto* sample = value->GetDict().FindString("text");
+    const auto* lang = value->GetDict().FindString("lang");
+    if (!sample || !lang || sample->size() > 8192 || lang->size() > 256) { fail(); return; }
+    text = *sample; language = *lang;
+  } else if (operation == 1 && value) nodes = NookTranslationNodesFromValue(*value);
+  if (operation == 3) nook_translation_client_.reset();
+  std::move(callback).Run(true, text, language, std::move(nodes));
+}
