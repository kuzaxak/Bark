+std::vector<chrome::mojom::NookTranslationNodePtr> NookTranslationNodesFromValue(
+    const base::Value& value) {
+  std::vector<chrome::mojom::NookTranslationNodePtr> nodes;
+  if (!value.is_list() || value.GetList().size() > 128) return nodes;
+  size_t bytes = 0;
+  for (const auto& entry : value.GetList()) {
+    if (!entry.is_dict()) return {};
+    const auto* id = entry.GetDict().FindString("id");
+    const auto* text = entry.GetDict().FindString("text");
+    if (!id || !text || id->size() > 32 || text->size() > 131072) return {};
+    bytes += id->size() + text->size();
+    if (bytes > 512 * 1024) return {};
+    nodes.push_back(chrome::mojom::NookTranslationNode::New(*id, *text));
+  }
+  return nodes;
+}
