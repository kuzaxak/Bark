+class TestNativeShellParts(unittest.TestCase):
+    def test_native_parts_are_explicit_and_nested_ordered(self):
+        products = parts.get_parts(test_config.TestConfigNonChromeBranded())
+        names = [name for name in products if name.startswith('native-')]
+        self.assertEqual(names, [
+            'native-sparkle-downloader', 'native-sparkle-installer',
+            'native-sparkle-updater', 'native-sparkle-autoupdate',
+            'native-sparkle-framework', 'native-shell'])
+        for name in names:
+            self.assertIsNone(products[name].entitlements)
+            self.assertEqual(name != 'native-shell', products[name].replace_existing_signature)
+            self.assertEqual(name != 'native-shell', products[name].preserve_entitlements)
+            if name not in ('native-shell', 'native-sparkle-framework'):
+                self.assertEqual(model.CodeSignOptions.FULL_HARDENED_RUNTIME_OPTIONS,
+                                 products[name].options)
+        self.assertFalse(products['native-shell'].sign_with_identifier)
+        self.assertEqual('ee.qdo.nook.NativeShell',
+                         products['native-shell'].identifier)
+        self.assertEqual('App Product.app/Contents/Frameworks/NookNativeShell.framework',
+                         products['native-shell'].path)
+        self.assertEqual('App Product.app/Contents/Frameworks/Product Framework.framework',
+                         products['framework'].path)
+        self.assertEqual('org.sparkle-project.DownloaderService',
+                         products['native-sparkle-downloader'].identifier)
