+bool BrowserWidget::SelectLogicalBrowserView(BrowserView* view) {
+#if BUILDFLAG(IS_MAC)
+  CHECK(!selecting_logical_view_);
+  if (!view || IsClosed() || view->browser_widget() != this ||
+      view->browser()->IsDeleteScheduled()) {
+    return false;
+  }
+  if (browser_view_->browser()->IsDeleteScheduled() ||
+      browser_view_->suppress_layout_for_teardown_ ||
+      view->suppress_layout_for_teardown_ ||
+      browser_view_->browser()->GetType() !=
+          BrowserWindowInterface::Type::TYPE_NORMAL ||
+      view->browser()->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return false;
+  }
+  if (view == browser_view_) {
+    return true;
+  }
+  // CURRENTLY UNQUALIFIED: switching with fullscreen/transitions or visible
+  // native child prompts/popups needs profile-correct responder/anchor proof.
+  // These are temporary admission gates, not the product's final scope.
+  // Active drag ownership likewise must finish before selecting another client.
+  if (tab_drag_kind_ != TabDragKind::kNone ||
+      !browser_native_widget_->CanSelectBrowserView()) {
+    return false;
+  }
+  for (views::Widget* child : GetAllOwnedWidgets(GetNativeView())) {
+    if (child != this && child->IsVisible()) {
+      return false;
+    }
+  }
+  const auto clients = GetLogicalBrowserViews();
+  if (std::ranges::find(clients, view) == clients.end()) {
+    return false;
+  }
+  CHECK_EQ(view->GetFrameView()->GetWidget(), this);
+  selecting_logical_view_ = true;
+  auto alive = GetWeakPtr();
+  BrowserView* previous = browser_view_;
+  auto previous_alive = previous->weak_ptr_factory_.GetWeakPtr();
+  auto incoming_alive = view->weak_ptr_factory_.GetWeakPtr();
+  auto intact = [&] {
+    if (alive && previous_alive && incoming_alive) {
+      return true;
+    }
+    if (alive) {
+      selecting_logical_view_ = false;
+    }
+    return false;
+  };
+  if (auto* contents = previous->GetActiveWebContents()) {
+    contents->StoreFocus();
+    if (!intact()) {
+      return false;
+    }
+  }
+  previous->OnWidgetActivationChanged(this, false);
+  if (!intact()) {
+    return false;
+  }
+  previous->OnWidgetVisibilityChanged(this, false);
+  if (!intact()) {
+    return false;
+  }
+  menu_runner_.reset();
+  if (!intact()) {
+    return false;
+  }
+  menu_model_builder_.reset();
+  if (!intact()) {
+    return false;
+  }
+  browser_view_ = view;
+  browser_frame_view_ = view->GetFrameView();
+  SelectClientDelegate(view);
+  SetNativeWindowProperty(BrowserView::kBrowserViewKey, view);
+  SetNativeWindowProperty(Profile::kProfileKey, view->GetProfile());
+  root_view_->SelectBrowserView(view);
+  if (!intact()) {
+    return false;
+  }
+  browser_native_widget_->SelectBrowserView(view);
+  if (!intact()) {
+    return false;
+  }
+  previous->PaintAsActiveChanged();
+  if (!intact()) {
+    return false;
+  }
+  const bool selected = non_client_view()->SelectClientFrame(view);
+  if (!intact()) {
+    return false;
+  }
+  CHECK(selected);  // Membership was verified before the selection transaction.
+  view->PaintAsActiveChanged();
+  if (!intact()) {
+    return false;
+  }
+  view->OnWidgetVisibilityChanged(this, IsVisible());
+  if (!intact()) {
+    return false;
+  }
+  view->OnWidgetActivationChanged(this, IsActive());
+  if (!intact()) {
+    return false;
+  }
+  glass_frame_subscription_ = {};
+  if (auto* service = GlassFrameService::GetInstance()) {
+    glass_frame_subscription_ =
+        service->RegisterGlassFrameEligibilityChangedCallback(
+            view->browser(),
+            base::BindRepeating(&BrowserWidget::OnGlassFrameEligibilityChanged,
+                                base::Unretained(this)));
+  }
+  SelectNativeTheme();
+  ResetLastColorProviderKey();
+  // Widget::ThemeChanged repaints/color-refreshes existing trees. It does not
+  // call UserChangedTheme/RegenerateFrameOnThemeChange or replay
+  // initialization.
+  ThemeChanged();
+  if (!intact()) {
+    return false;
+  }
+  UpdateWindowTitle();
+  if (!intact()) {
+    return false;
+  }
+  UpdateWindowIcon();
+  if (!intact()) {
+    return false;
+  }
+  if (auto* contents = view->GetActiveWebContents()) {
+    view->UpdateAccessibleURLForRootView(contents->GetURL());
+    if (!intact()) {
+      return false;
+    }
+  }
+  view->UpdateAccessibleNameForRootView();
+  if (!intact()) {
+    return false;
+  }
+  if (IsActive()) {
+    view->RestoreFocus();
+    if (!intact()) {
+      return false;
+    }
+  }
+  selecting_logical_view_ = false;
+  return true;
+#else
+  return view == browser_view_;
+#endif
+}
