+namespace {
+constexpr size_t kNookScriptSourceLimit = 128 * 1024;
+constexpr size_t kNookScriptResultLimit = 1024 * 1024;
+chrome::mojom::NookScriptResultPtr NookScriptFailure(
+    chrome::mojom::NookScriptStatus status) {
