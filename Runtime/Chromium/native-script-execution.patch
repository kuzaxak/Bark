+void ChromeRenderFrameObserver::ResetNookScript() {
+  nook_script_weak_.InvalidateWeakPtrs();
+  auto pending = std::move(nook_script_);
+  nook_script_.reset();
+  nook_script_sink_.Reset();
+  nook_script_document_.reset();
+  nook_script_queued_ = 0;
+  if (pending) std::move(pending->callback).Run(
+      NookScriptFailure(chrome::mojom::NookScriptStatus::kCancelled));
+}
+
+void ChromeRenderFrameObserver::NookCancelScript(
+    const blink::DocumentToken& document, uint64_t owner, uint64_t request) {
+  if (!nook_script_ || nook_script_->document != document ||
+      nook_script_->owner != owner || nook_script_->request != request) return;
+  auto callback = std::move(nook_script_->callback);
+  nook_script_.reset();
+  // Keep the suspended-thunk gate until Blink retires that exact thunk.
+  std::move(callback).Run(NookScriptFailure(
+      chrome::mojom::NookScriptStatus::kCancelled));
+}
+
+void ChromeRenderFrameObserver::NookScriptThunk(
+    const v8::FunctionCallbackInfo<v8::Value>& info) {
+  auto context = info.GetIsolate()->GetCurrentContext();
+  auto data = info.Data().As<v8::Array>();
+  v8::Local<v8::Value> sink, generation, phase;
+  if (!data->Get(context, 0).ToLocal(&sink) || !sink->IsFunction() ||
+      !data->Get(context, 1).ToLocal(&generation) ||
+      !data->Get(context, 2).ToLocal(&phase)) return;
+  v8::Local<v8::Value> args[] = {
+      generation, phase, info.Length() ? info[0] :
+          v8::Undefined(info.GetIsolate()).As<v8::Value>()};
+  v8::Local<v8::Value> ignored;
+  std::ignore = sink.As<v8::Function>()->Call(context, v8::Undefined(
+      info.GetIsolate()), 3, args).ToLocal(&ignored);
+}
+
+void ChromeRenderFrameObserver::NookEvaluateScript(
+    const blink::DocumentToken& document, uint64_t owner, uint64_t request,
+    int32_t mode, int32_t world, const std::string& source,
+    NookEvaluateScriptCallback callback) {
+  using Status = chrome::mojom::NookScriptStatus;
+  auto* frame = render_frame()->GetWebFrame();
+  if (nook_script_ || nook_script_queued_) {
+    std::move(callback).Run(NookScriptFailure(Status::kBusy)); return;
+  }
+  if (!frame || !render_frame()->IsMainFrame() ||
+      frame->GetDocument().Token() != document || !owner || !request ||
+      !GURL(frame->GetDocument().Url()).SchemeIsHTTPOrHTTPS() ||
+      source.size() > kNookScriptSourceLimit || (mode != 0 && mode != 1) ||
+      (world != 0 && world != 1)) {
+    std::move(callback).Run(NookScriptFailure(Status::kUnavailable)); return;
+  }
+  auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handles(isolate);
+  auto context = frame->MainWorldScriptContext();
+  if (context.IsEmpty()) {
+    std::move(callback).Run(NookScriptFailure(Status::kUnavailable)); return;
+  }
+  v8::Context::Scope entered(context);
+  if (!nook_script_document_ || *nook_script_document_ != document ||
+      nook_script_sink_.IsEmpty()) {
+    v8::Local<v8::Function> sink;
+    if (!gin::CreateFunctionTemplate(isolate, base::BindRepeating(
+            &ChromeRenderFrameObserver::NookScriptDispatch,
+            nook_script_weak_.GetWeakPtr(), document))
+            ->GetFunction(context).ToLocal(&sink)) {
+      std::move(callback).Run(NookScriptFailure(Status::kUnavailable)); return;
+    }
+    nook_script_sink_.Reset(isolate, sink);
+    nook_script_document_ = document;
+  }
+  const uint64_t generation = ++nook_script_generation_;
+  nook_script_.emplace(NookPendingScript{document, owner, request, generation,
+                                       mode, world, source, false, std::move(callback)});
+  v8::Local<v8::Value> metadata[] = {nook_script_sink_.Get(isolate),
+      v8::BigInt::NewFromUnsigned(isolate, generation), v8::Integer::New(isolate, 0)};
+  auto data = v8::Array::New(isolate, metadata, 3);
+  v8::Local<v8::Function> thunk;
+  if (!v8::Function::New(context, NookScriptThunk, data).ToLocal(&thunk)) {
+    NookScriptComplete(Status::kUnavailable); return;
+  }
+  nook_script_queued_ = generation;
+  frame->RequestExecuteV8Function(context, thunk, context->Global(), 0, nullptr,
+      base::BindOnce([](base::WeakPtr<ChromeRenderFrameObserver> self,
+          blink::DocumentToken document, uint64_t generation,
+          std::optional<base::Value>, base::TimeTicks) {
+        if (!self || self->nook_script_document_ != document) return;
+        if (self->nook_script_queued_ == generation)
+          self->nook_script_queued_ = 0;
+        // A thunk that ran has either completed or installed promise reactions.
+        if (self->nook_script_ &&
+            self->nook_script_->generation == generation &&
+            !self->nook_script_->ran)
+          self->NookScriptComplete(Status::kUnavailable);
+      }, nook_script_weak_.GetWeakPtr(), document, generation));
+}
+
+void ChromeRenderFrameObserver::NookScriptDispatch(
+    const blink::DocumentToken& document, gin::Arguments* arguments) {
+  v8::Local<v8::Value> id, phase, value;
+  if (!arguments->GetNext(&id) || !id->IsBigInt() ||
+      !arguments->GetNext(&phase) || !phase->IsInt32() ||
+      !arguments->GetNext(&value)) return;
+  auto* frame = render_frame()->GetWebFrame();
+  const uint64_t generation = id.As<v8::BigInt>()->Uint64Value();
+  if (!frame || frame->GetDocument().Token() != document ||
+      !nook_script_ || nook_script_->document != document ||
+      nook_script_->generation != generation) return;
+  const int operation = phase.As<v8::Int32>()->Value();
+  auto context = frame->MainWorldScriptContext();
+  if (context.IsEmpty()) { NookScriptComplete(
+      chrome::mojom::NookScriptStatus::kUnavailable); return; }
+  v8::Context::Scope page(context);
+  if (!operation) {
+    NookScriptRun(generation, context);
+  } else {
+#if BUILDFLAG(IS_MAC)
+    if (nook_script_->world == 1) context = frame->GetScriptContextFromWorldId(
+        arguments->isolate(), ISOLATED_WORLD_ID_NOOK_AUTOMATION);
+#endif
+    if (context.IsEmpty()) { NookScriptComplete(
+        chrome::mojom::NookScriptStatus::kUnavailable); return; }
+    v8::Context::Scope requested_world(context);
+    NookScriptComplete(operation == 1 ? chrome::mojom::NookScriptStatus::kValue
+                                     : chrome::mojom::NookScriptStatus::kRejected,
+                       value);
+  }
+}
+
+void ChromeRenderFrameObserver::NookScriptRun(
+    uint64_t generation, v8::Local<v8::Context> context) {
+  using Status = chrome::mojom::NookScriptStatus;
+  auto* frame = render_frame()->GetWebFrame();
+  auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  const auto alive = nook_script_weak_.GetWeakPtr();
+  // Enter the actual page context for Blink's normal sandbox/content policy
+  // probe, even when the requested execution world is isolated.
+  auto main = frame->MainWorldScriptContext();
+  if (main.IsEmpty()) { NookScriptComplete(Status::kUnavailable); return; }
+  {
+    v8::Context::Scope page(main);
+    const auto& settings = frame->GetContentSettings();
+    if (!render_frame()->GetBlinkPreferences().javascript_enabled ||
+        (settings && !settings->allow_script)) {
+      NookScriptComplete(Status::kUnavailable); return;
+    }
+    auto allowed = frame->ExecuteScriptAndReturnValue(
+        blink::WebScriptSource(blink::WebString::FromUtf8("true")));
+    if (!alive) return;
+    if (allowed.IsEmpty() || !allowed->IsTrue()) {
+      NookScriptComplete(Status::kUnavailable); return;
+    }
+  }
+  if (!nook_script_ || nook_script_->generation != generation ||
+      frame->GetDocument().Token() != nook_script_->document) return;
+  if (nook_script_->world == 1) {
+#if BUILDFLAG(IS_MAC)
+    context = frame->GetScriptContextFromWorldId(
+        isolate, ISOLATED_WORLD_ID_NOOK_AUTOMATION);
+    if (context.IsEmpty()) {
+      std::ignore = frame->ExecuteScriptInIsolatedWorldAndReturnValue(
+          ISOLATED_WORLD_ID_NOOK_AUTOMATION,
+          blink::WebScriptSource(blink::WebString::FromUtf8("void 0")),
+          blink::BackForwardCacheAware::kAllow);
+      if (!alive || !nook_script_ || nook_script_->generation != generation ||
+          frame->GetDocument().Token() != nook_script_->document) return;
+      context = frame->GetScriptContextFromWorldId(
+          isolate, ISOLATED_WORLD_ID_NOOK_AUTOMATION);
+    }
+#else
+    context = {};
+#endif
+  }
+  if (context.IsEmpty()) { NookScriptComplete(Status::kUnavailable); return; }
+  nook_script_->ran = true;
+  std::string source = std::move(nook_script_->source);
+  nook_script_->source.clear();
+  if (nook_script_->mode == 1) source = "(async () => {\n" + source + "\n})()";
+  v8::Context::Scope entered(context);
+  v8::TryCatch caught(isolate);
+  v8::Local<v8::String> text;
+  v8::Local<v8::Script> script;
+  v8::Local<v8::Value> value;
+  if (!v8::String::NewFromUtf8(isolate, source.data(), v8::NewStringType::kNormal,
+                             source.size()).ToLocal(&text)) {
+    NookScriptComplete(Status::kUnavailable); return;
+  }
+  v8::ScriptCompiler::Source input(text);
+  if (!v8::ScriptCompiler::Compile(context, &input).ToLocal(&script) ||
+      !script->Run(context).ToLocal(&value)) {
+    if (alive) NookScriptComplete(Status::kException, caught.Exception());
+    return;
+  }
+  if (!alive) return;
+  if (!nook_script_ || nook_script_->generation != generation) return;
+  // Promise resolution also handles thenables, preserving async-body semantics.
+  v8::Local<v8::Promise::Resolver> resolver;
+  if (!v8::Promise::Resolver::New(context).ToLocal(&resolver) ||
+      resolver->Resolve(context, value).IsNothing()) {
+    if (alive && nook_script_ && nook_script_->generation == generation)
+      NookScriptComplete(Status::kException, caught.Exception());
+    return;
+  }
+  if (!alive || !nook_script_ || nook_script_->generation != generation ||
+      frame->GetDocument().Token() != nook_script_->document) return;
+  std::array<v8::Local<v8::Function>, 2> reactions;
+  for (int i = 0; i < 2; ++i) {
+    v8::Local<v8::Value> metadata[] = {nook_script_sink_.Get(isolate),
+        v8::BigInt::NewFromUnsigned(isolate, generation),
+        v8::Integer::New(isolate, i + 1)};
+    auto data = v8::Array::New(isolate, metadata, 3);
+    if (!v8::Function::New(context, NookScriptThunk, data).ToLocal(&reactions[i])) {
+      NookScriptComplete(Status::kUnavailable); return;
+    }
+  }
+  v8::Local<v8::Promise> ignored;
+  if (!resolver->GetPromise()->Then(context, reactions[0], reactions[1])
+           .ToLocal(&ignored) && alive) NookScriptComplete(Status::kUnavailable);
+}
+
+void ChromeRenderFrameObserver::NookScriptComplete(
+    chrome::mojom::NookScriptStatus status, v8::Local<v8::Value> value) {
+  if (!nook_script_) return;
+  const auto alive = nook_script_weak_.GetWeakPtr();
+  const auto document = nook_script_->document;
+  const uint64_t generation = nook_script_->generation;
+  auto callback = std::move(nook_script_->callback);
+  nook_script_.reset();
+  // Serialization may invoke page hooks. Keep admission busy until it retires.
+  nook_script_queued_ = generation;
+  auto result = NookScriptFailure(status);
+  auto* isolate = render_frame()->GetWebFrame()->GetAgentGroupScheduler()->Isolate();
+  auto context = isolate->GetCurrentContext();
+  const auto current = [&]() {
+    return alive && alive->render_frame()->GetWebFrame() &&
+        alive->render_frame()->GetWebFrame()->GetDocument().Token() == document;
+  };
+  v8::TryCatch caught(isolate);
+  auto copy = [&](v8::Local<v8::String> string, std::string& target) {
+    if (string->Utf8Length(isolate) > static_cast<int>(kNookScriptResultLimit)) {
+      result->status = chrome::mojom::NookScriptStatus::kUnserializable;
+      return;
+    }
+    v8::String::Utf8Value utf8(isolate, string);
+    target.assign(*utf8, utf8.length());
+  };
+  if (!value.IsEmpty()) {
+    if (status == chrome::mojom::NookScriptStatus::kValue && value->IsUndefined())
+      result->status = chrome::mojom::NookScriptStatus::kUndefined;
+    result->is_string = value->IsString();
+    if (value->IsString() && value.As<v8::String>()->Utf8Length(isolate) >
+            static_cast<int>(kNookScriptResultLimit)) {
+      result->status = chrome::mojom::NookScriptStatus::kUnserializable;
+      if (alive && alive->nook_script_queued_ == generation)
+        alive->nook_script_queued_ = 0;
+      std::move(callback).Run(std::move(result));
+      return;
+    }
+    // Match DevMCP's JSON-first formatting; do not invoke a page toString hook
+    // when JSON already represents the value. Raw strings retain saveTo bytes.
+    if (status == chrome::mojom::NookScriptStatus::kValue && !value->IsUndefined()) {
+      v8::Local<v8::String> json;
+      if (v8::JSON::Stringify(context, value,
+          v8::String::NewFromUtf8Literal(isolate, "  ")).ToLocal(&json))
+        copy(json, result->json);
+      else caught.Reset();  // Legacy formatting falls back for cyclic values.
+    }
+    if (current() && (result->is_string || result->json.empty() || value->IsNumber())) {
+      v8::Local<v8::String> text;
+      if (value->ToString(context).ToLocal(&text)) copy(text, result->text);
+      else result->status = chrome::mojom::NookScriptStatus::kUnserializable;
+    }
+  }
+  if (!current()) result = NookScriptFailure(
+      chrome::mojom::NookScriptStatus::kCancelled);
+  if (alive && alive->nook_script_queued_ == generation)
+    alive->nook_script_queued_ = 0;
+  std::move(callback).Run(std::move(result));
+}
