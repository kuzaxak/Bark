+void ChromeRenderFrameObserver::SetNookBoostStyle(
+    const blink::DocumentToken& expected, const std::string& css,
+    SetNookBoostStyleCallback callback) {
+  auto* frame = render_frame()->GetWebFrame();
+  auto document = frame->GetDocument();
+  if (!render_frame()->IsMainFrame() || document.IsNull() ||
+      document.Token() != expected ||
+      !GURL(document.Url()).SchemeIsHTTPOrHTTPS() || css.size() > 16 * 1024 * 1024) {
+    std::move(callback).Run(false);
+    return;
+  }
+  if (!nook_boost_style_.IsEmpty()) {
+    document.RemoveInsertedStyleSheet(nook_boost_style_);
+    nook_boost_style_ = blink::WebString();
+  }
+  if (!css.empty()) {
+    nook_boost_style_ = document.InsertStyleSheet(blink::WebString::FromUtf8(css));
+  }
+  std::move(callback).Run(true);
 }
 
