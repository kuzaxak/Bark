+    barc_peek_->underlay->SetBoundsRect(bounds);
+    if (!alive || !root || !barc_peek_ || barc_peek_->generation != generation) return;
+    barc_peek_->underlay->DeprecatedLayoutImmediately();
+    if (!alive || !root || !barc_peek_ || barc_peek_->generation != generation) return;
