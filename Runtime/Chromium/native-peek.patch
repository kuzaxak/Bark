+      barc_peek_->header == header && barc_peek_->actions == actions &&
+      barc_peek_->header_host->native_view() == header &&
+      barc_peek_->actions_host->native_view() == actions &&
+      barc::IsPeekPair(source, peek) && barc_peek_->source_owner && barc_peek_->peek_owner &&
+      source->GetBrowserWindowInterface() == barc_peek_->source_owner->browser() &&
+      peek->GetBrowserWindowInterface() == barc_peek_->peek_owner->browser() &&
+      selected_browser_view() == barc_peek_->peek_owner.get() &&
+      selected_browser_view()->barc_native_shell() && barc_peek_->sidebar &&
+      selected_browser_view()->barc_native_shell()->native_view() == barc_peek_->sidebar &&
+      peek->IsActivated();
