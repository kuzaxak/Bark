+uint64_t BrowserWidget::PresentBarcPeek(tabs::TabInterface* source,
+    tabs::TabInterface* peek, gfx::NativeView sidebar, gfx::NativeView header,
+    gfx::NativeView actions) {
+#if !BUILDFLAG(IS_MAC)
+  return 0;
+#else
+  if (barc_peek_) {
+    return IsBarcPeekPresented(source, peek, barc_peek_->generation, header, actions)
+        ? barc_peek_->generation : 0;
+  }
+  if (IsClosed() || changing_barc_peek_ || changing_barc_presentation_ ||
+      clearing_barc_presentation_ || !sidebar || !header || !actions ||
+      !barc::IsPeekPair(source, peek) || !source->IsActivated() ||
+      HasPhysicalClosePending() || browser_shutdown::IsTryingToQuit()) return 0;
+  auto* source_view = BrowserView::GetBrowserViewForBrowser(source->GetBrowserWindowInterface());
+  auto* peek_view = BrowserView::GetBrowserViewForBrowser(peek->GetBrowserWindowInterface());
+  if (!source_view || !peek_view || source_view == peek_view ||
+      source_view != selected_browser_view() || source_view->browser_widget() != this ||
+      peek_view->browser_widget() != this || !source_view->barc_native_shell() ||
+      !peek_view->barc_native_shell() ||
+      source_view->barc_native_shell()->native_view() != sidebar ||
+      peek_view->barc_native_shell()->native_view()) return 0;
+  auto* previous_peer_tab = peek_view->browser()->GetTabStripModel()->GetActiveTab();
+  if (!previous_peer_tab) return 0;
+  auto previous_peer_active = previous_peer_tab->GetWeakPtr();
+  auto expected_peer_active = previous_peer_active;
+  bool activated_peek = false;
+  auto mutation = barc::ProtectNativeViewMutation();
+  auto alive = GetWeakPtr();
+  auto source_alive = source->GetWeakPtr();
+  auto peek_alive = peek->GetWeakPtr();
+  auto source_view_alive = source_view->GetAsWeakPtr();
+  auto peek_view_alive = peek_view->GetAsWeakPtr();
+  const uint64_t before = barc_selection_epoch_;
+  uint64_t expected_epoch = before;
+  auto expected_owner = source_view->GetAsWeakPtr();
+  changing_barc_peek_ = true;
+  base::ScopedClosureRunner reset(base::BindOnce([](base::WeakPtr<views::Widget> widget) {
+    if (widget) static_cast<BrowserWidget*>(widget.get())->changing_barc_peek_ = false;
+  }, alive));
+  auto retirement = std::make_shared<std::vector<std::unique_ptr<views::View>>>();
+  auto state = std::make_shared<BarcPeekPresentation>();
+  state->retirement = retirement;
+  state->source = source_alive; state->peek = peek_alive;
+  state->source_owner = source_view_alive; state->peek_owner = peek_view_alive;
+  state->sidebar = sidebar; state->header = header; state->actions = actions;
+  CHECK_NE(++barc_peek_generation_, 0u);
+  state->generation = barc_peek_generation_;
+  auto root = std::make_unique<views::View>();
+  root->SetVisible(false);
+  state->root = root.get();
+  views::ViewTracker tracked_root(root.get());
+  state->shade_host = root->AddChildView(std::make_unique<views::NativeViewHost>());
+  state->contents = root->AddChildView(std::make_unique<MultiContentsView>(
+      std::make_unique<BarcPresentedContentsDelegate>(this)));
+  state->header_host = root->AddChildView(std::make_unique<views::NativeViewHost>());
+  state->actions_host = root->AddChildView(std::make_unique<views::NativeViewHost>());
+  const uint64_t generation = state->generation;
+  barc_peek_ = std::move(state);
+  non_client_view()->AddChildView(std::move(root));
+  auto current = [&] {
+    return alive && tracked_root && barc_peek_ && barc_peek_->generation == generation &&
+        expected_owner && selected_browser_view() == expected_owner.get() &&
+        barc_selection_epoch_ == expected_epoch && source_alive && peek_alive &&
+        source_view_alive && peek_view_alive &&
+        source_alive->GetBrowserWindowInterface() == source_view_alive->browser() &&
+        peek_alive->GetBrowserWindowInterface() == peek_view_alive->browser() &&
+        source_view_alive->browser_widget() == this && peek_view_alive->browser_widget() == this &&
+        !HasPhysicalClosePending() && !browser_shutdown::IsTryingToQuit() &&
+        expected_peer_active && peek_view_alive->browser()->GetTabStripModel()->GetActiveTab() == expected_peer_active.get() &&
+        barc::IsPeekPair(source_alive.get(), peek_alive.get()) && source_alive->IsActivated();
+  };
+  auto fail = [&]() -> uint64_t {
+    const bool owned = alive && expected_owner && peek_view_alive && peek_alive &&
+        selected_browser_view() == expected_owner.get() && barc_selection_epoch_ == expected_epoch &&
+        peek_alive->GetBrowserWindowInterface() == peek_view_alive->browser() && peek_alive->IsActivated();
+    if (alive && barc_peek_ && barc_peek_->generation == generation)
+      ClearBarcPeek(false, true);
+    const bool still_owned = alive && ((expected_owner &&
+        selected_browser_view() == expected_owner.get() && barc_selection_epoch_ == expected_epoch) ||
+        (source_view_alive && expected_owner.get() == peek_view_alive.get() &&
+         selected_browser_view() == source_view_alive.get() && barc_selection_epoch_ == expected_epoch + 1));
+    if (owned && still_owned && activated_peek && previous_peer_active && peek_alive && peek_view_alive &&
+        peek_alive->GetBrowserWindowInterface() == peek_view_alive->browser() && peek_alive->IsActivated() &&
+        previous_peer_active->GetBrowserWindowInterface() == peek_view_alive->browser()) {
+      auto* model = peek_view_alive->browser()->GetTabStripModel();
+      model->ActivateTabAt(model->GetIndexOfWebContents(previous_peer_active->GetContents()));
+    }
+    return 0;
+  };
+  if (!current() || before != barc_selection_epoch_ || selected_browser_view() != source_view)
+    return fail();
+  std::vector<base::WeakPtr<tabs::TabInterface>> watched;
+  auto watch = [&](base::WeakPtr<tabs::TabInterface> tab) {
+    if (!tab || std::ranges::any_of(watched, [&tab](const auto& prior) { return prior.get() == tab.get(); }))
+      return;
+    watched.push_back(tab);
+    barc_peek_->subscriptions.push_back(tab->RegisterWillDetach(base::BindRepeating(
+        [](base::WeakPtr<views::Widget> widget, tabs::TabInterface*, tabs::TabInterface::DetachReason) {
+          if (widget) static_cast<BrowserWidget*>(widget.get())->ClearBarcPeek(false, true);
+        }, alive)));
+    barc_peek_->subscriptions.push_back(tab->RegisterWillDiscardContents(base::BindRepeating(
+        [](base::WeakPtr<views::Widget> widget, tabs::TabInterface*, content::WebContents*, content::WebContents*) {
+          if (widget) static_cast<BrowserWidget*>(widget.get())->ClearBarcPeek(false, true);
+        }, alive)));
+  };
+  watch(source_alive);
+  watch(peek_alive);
+  if (previous_peer_active.get() != peek_alive.get()) {
+    auto* model = peek_view_alive->browser()->GetTabStripModel();
+    const int index = model->GetIndexOfWebContents(peek_alive->GetContents());
+    if (index == TabStripModel::kNoTab) return fail();
+    model->ActivateTabAt(index);
+    activated_peek = true;
+    expected_peer_active = peek_alive;
+    if (!current()) return fail();
+  }
+  auto* container = peek_view_alive->GetContentsContainerViewFor(peek_alive->GetContents());
+  if (!container || container->parent() != peek_view_alive->multi_contents_view()) return fail();
+  if (barc_presented_contents_) {
+    barc_peek_->base_tabs = barc_presented_tabs_;
+    for (const auto& tab : barc_peek_->base_tabs) watch(tab);
+  } else {
+    std::vector<ContentsContainerView*> base;
+    for (const auto& candidate : source_view->multi_contents_view()->contents_container_views()) {
+      if (candidate->GetVisible() && candidate->contents_view()->web_contents()) {
+        base.push_back(candidate.get());
+        auto* tab = tabs::TabInterface::GetFromContents(candidate->contents_view()->web_contents());
+        if (!tab || tab->GetBrowserWindowInterface() != source_view->browser()) return fail();
+        barc_peek_->base_tabs.push_back(tab->GetWeakPtr());
+      }
+    }
+    if (base.empty() || base.size() > 4) return fail();
+    for (const auto& tab : barc_peek_->base_tabs) watch(tab);
+    auto underlay = std::make_unique<MultiContentsView>(
+        std::make_unique<BarcPresentedContentsDelegate>(this));
+    views::ViewTracker underlay_alive(underlay.get());
+    auto* added_underlay = non_client_view()->AddChildView(std::move(underlay));
+    if (!current()) {
+      if (alive && underlay_alive && underlay_alive.view()->parent() == non_client_view())
+        retirement->push_back(non_client_view()->RemoveChildViewT(underlay_alive.view()));
+      return fail();
+    }
+    barc_peek_->underlay = added_underlay;
+    // Keep the current Chrome collection intact; only its real containers move.
+    for (auto* item : base) {
+      if (!barc_peek_->underlay->AddPresentedContainer(item) || !current()) return fail();
+    }
+    if (base.size() > 1) {
+      std::vector<double> dividers;
+      for (size_t i = 0; i + 1 < base.size(); ++i)
+        dividers.push_back(source_view->multi_contents_view()->GetDividerRatio(i));
+      barc_peek_->underlay->ShowSplitView(split_tabs::SplitTabVisualData(
+          source_view->multi_contents_view()->GetSplitLayout(), dividers));
+      if (!current()) return fail();
+    }
+    barc_peek_->underlay->SetActiveContents(source_alive->GetContents());
+    if (!current()) return fail();
+    non_client_view()->ReorderChildView(barc_peek_->root, -1);
+  }
+  for (const auto& tab : barc_peek_->base_tabs) {
+    if (!tab) return fail();
+    barc_peek_->input_tokens.push_back(tab->GetContents()->IgnoreInputEvents(std::nullopt));
+  }
+  barc::AttachPeekBackdrop(barc_peek_->shade_host, source_alive.get(), peek_alive.get());
+  if (!current()) return fail();
+  if (!barc_peek_->contents->AddPresentedContainer(container) || !current()) return fail();
+  barc_peek_->contents->SetActiveIndex(0);
+  if (!current()) return fail();
+  barc_peek_->contents->SetBackgroundRadii(gfx::RoundedCornersF(0, 0, 16, 16));
+  if (!current()) return fail();
+  UpdateBarcPresentedScreenshotPolicy();
+  if (!current()) return fail();
+  const bool selected = SelectLogicalBrowserView(peek_view);
+  if (!alive || !selected || !source_alive || !peek_alive ||
+      selected_browser_view() != peek_view || barc_selection_epoch_ != before + 1) return fail();
+  expected_owner = peek_view->GetAsWeakPtr();
+  expected_epoch = barc_selection_epoch_;
+  if (!current() || source_view->barc_native_shell()->native_view() != sidebar ||
+      !barc::MovePeekNativeShell(source_view->browser(), peek_view->browser())) return fail();
+  if (!current() || peek_view->barc_native_shell()->native_view() != sidebar) return fail();
+  barc_peek_->header_host->Attach(header);
+  if (!current()) return fail();
+  barc_peek_->actions_host->Attach(actions);
+  if (!current()) return fail();
+  LayoutBarcPeek();
+  if (!current()) return fail();
+  barc_peek_->root->SetVisible(true);
+  if (!current()) return fail();
+  peek_alive->GetContents()->WasShown();
+  if (!current()) return fail();
+  if (IsActive()) peek_alive->GetContents()->Focus();
+  if (!current()) return fail();
+  barc::BrowserDiscoveryChanged();
+  return generation;
+#endif
+}
