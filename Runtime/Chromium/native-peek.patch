+  if (!alive || !root || !barc_peek_ || barc_peek_->generation != generation) return;
+  barc_peek_->contents->SetBounds(x, 40, width, std::max(0, height - 32));
+  if (!alive || !root || !barc_peek_ || barc_peek_->generation != generation) return;
+  barc_peek_->actions_host->SetBounds(x + width + 8, 14, 28, std::max(0, std::min(96, height - 6)));
+  if (!alive || !root || !barc_peek_ || barc_peek_->generation != generation) return;
+  barc_peek_->contents->DeprecatedLayoutImmediately();
