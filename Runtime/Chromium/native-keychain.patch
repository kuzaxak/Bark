 }  // namespace
+
+#if defined(ALLOW_RUNTIME_CONFIGURABLE_KEY_STORAGE)
+namespace {
+class RecordingKeychain : public FakeKeychainV2 {
+ public:
+  RecordingKeychain() : FakeKeychainV2("isolated-native-test") {}
+  base::expected<std::vector<uint8_t>, OSStatus> FindGenericPassword(
+      std::string_view service,
+      std::string_view account) override {
+    lookups.emplace_back(service, account);
+    return FakeKeychainV2::FindGenericPassword(service, account);
+  }
+  OSStatus AddGenericPassword(std::string_view service,
+                              std::string_view account,
+                              base::span<const uint8_t> password) override {
+    additions.emplace_back(service, account);
+    return FakeKeychainV2::AddGenericPassword(service, account, password);
+  }
+  std::vector<std::pair<std::string, std::string>> lookups;
+  std::vector<std::pair<std::string, std::string>> additions;
+};
+
+TEST(KeychainPasswordTest, DedicatedNativeNamespaceCreatesOnlyItsOwnPassword) {
+  base::AutoReset<std::string> service(&KeychainPassword::GetServiceName(),
+                                       "NookChromium Safe Storage");
+  base::AutoReset<std::string> account(&KeychainPassword::GetAccountName(),
+                                       "NookChromium");
+  RecordingKeychain keychain;
+  keychain.set_find_generic_result(errSecItemNotFound);
+  EXPECT_EQ(24u, KeychainPassword(keychain).GetPassword().size());
+  ASSERT_EQ(1u, keychain.lookups.size());
+  ASSERT_EQ(1u, keychain.additions.size());
+  EXPECT_EQ(keychain.lookups[0],
+            std::make_pair(std::string("NookChromium Safe Storage"),
+                           std::string("NookChromium")));
+  EXPECT_EQ(keychain.lookups, keychain.additions);
+}
+
+TEST(KeychainPasswordTest, DedicatedNativeNamespaceDenialNeverFallsBack) {
+  base::AutoReset<std::string> service(&KeychainPassword::GetServiceName(),
+                                       "NookChromium Safe Storage");
+  base::AutoReset<std::string> account(&KeychainPassword::GetAccountName(),
+                                       "NookChromium");
+  RecordingKeychain keychain;
+  keychain.set_find_generic_result(errSecAuthFailed);
+  EXPECT_TRUE(KeychainPassword(keychain).GetPassword().empty());
+  ASSERT_EQ(1u, keychain.lookups.size());
+  EXPECT_EQ(keychain.lookups[0],
+            std::make_pair(std::string("NookChromium Safe Storage"),
+                           std::string("NookChromium")));
+  EXPECT_TRUE(keychain.additions.empty());
+}
+}  // namespace
+#endif  // ALLOW_RUNTIME_CONFIGURABLE_KEY_STORAGE
