+bool BrowserWidget::CanAcceptLogicalBrowser() {
+#if BUILDFLAG(IS_MAC)
+  if (IsClosed() || HasPhysicalClosePending() || !browser_view_ ||
+      browser_view_->browser()->IsDeleteScheduled() ||
+      browser_view_->browser()->GetType() !=
+          BrowserWindowInterface::Type::TYPE_NORMAL ||
+      tab_drag_kind_ != TabDragKind::kNone || !browser_native_widget_ ||
+      !browser_native_widget_->CanSelectBrowserView()) {
+    return false;
+  }
+  for (views::Widget* child : GetAllOwnedWidgets(GetNativeView())) {
+    if (child != this && child->IsVisible()) {
+      return false;
+    }
+  }
+  return true;
+#else
+  return false;
+#endif
+}
+
+bool BrowserWidget::AttachLogicalBrowserView(BrowserView* view) {
+  if (!CanAcceptLogicalBrowser()) {
+    return false;
+  }
+  CHECK(view);
+  CHECK_EQ(view->browser()->GetType(),
+           BrowserWindowInterface::Type::TYPE_NORMAL);
+  view->BindPhysicalBrowserWidget(this);
+  auto frame = chrome::CreateBrowserFrameView(this, view);
+  view->SetOwnFrameView(frame.get());
+  RetainClientFrame(std::move(frame), std::unique_ptr<views::ClientView>(view),
+                    view);
+  return true;
+}
+
 bool BrowserWidget::SelectLogicalBrowserView(BrowserView* view) {
   return SelectLogicalBrowserViewInternal(view, false);
 }
