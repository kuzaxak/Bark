+bool BrowserWindow::CanCreateInNativeWindow(const SessionID& owner) {
+#if BUILDFLAG(IS_MAC)
+  if (!base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "barc-shared-native-window") ||
+      webui_browser::IsWebUIBrowserEnabled()) {
+    return false;
+  }
+  auto* collection = GlobalBrowserCollection::GetInstance();
+  auto* browser = collection ? collection->FindBrowserWithID(owner) : nullptr;
+  auto* view = browser && !browser->IsDeleteScheduled()
+                   ? BrowserView::GetBrowserViewForBrowser(browser)
+                   : nullptr;
+  return view && view->browser_widget()->CanAcceptLogicalBrowser();
+#else
+  return false;
+#endif
+}
