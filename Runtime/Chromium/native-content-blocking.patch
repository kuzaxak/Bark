@@ -763,6 +777,97 @@ bool ChromeExtensionsBrowserClient::IsWebUIAllowedToMakeNetworkRequests(
       origin);
 }
 
+base::ScopedClosureRunner ChromeExtensionsBrowserClient::ObserveNativeRequestBody(
+    content::BrowserContext* context,
+    const content::WeakDocumentPtr& document,
+    bool keepalive) {
+#if BUILDFLAG(IS_MAC)
+  // Keepalive can outlive client disconnection. Workers, SW interception and
+  // browser POSTs have no proven originating document at this hook.
+  auto* frame = document.AsRenderFrameHostIfValid();
+  if (!keepalive && frame && frame->GetBrowserContext() == context &&
+      frame->GetLifecycleState() == content::RenderFrameHost::LifecycleState::kActive &&
+      !frame->GetLastCommittedURL().is_empty() &&
+      performance_manager::features::IsNativeResourceProtectionHeld()) {
+    return performance_manager::PageLiveStateDecorator::ObserveDocumentRequestBody(document);
+  }
+#endif
+  return {};
+}
+
+bool ChromeExtensionsBrowserClient::HasNativeRequestPolicy(
+    content::BrowserContext* context) const {
+#if BUILDFLAG(IS_MAC)
+  if (!NativeContentBlocker::IsRegistered()) return false;
+  auto* profile = Profile::FromBrowserContext(context);
+  if (profile->ShutdownStarted())
+    return NativeContentBlocker::RequiresInterception();
+  // Even disabled contexts subscribe cheaply, without a matcher allocation.
+  // A future enable can reset their existing factories without an owner map.
+  auto* service = NativeContentBlocker::Get(profile, true);
+  return service && service->ShouldProxy();
+#else
+  return false;
+#endif
+}
+
+void ChromeExtensionsBrowserClient::CheckNativeRequestPolicy(
+    content::BrowserContext* context,
+    const content::WeakDocumentPtr& document,
+    const GURL& document_site,
+    const WebRequestInfo& request,
+    base::OnceCallback<void(int)> callback) {
+#if BUILDFLAG(IS_MAC)
+  if (!NativeContentBlocker::IsRegistered() || request.is_privileged) {
+    std::move(callback).Run(net::OK);
+    return;
+  }
+  const GURL initiator = request.initiator && !request.initiator->opaque()
+                            ? request.initiator->GetURL() : GURL();
+  // Extension background fetches are outside eligible website traffic. Real
+  // website navigations remain eligible even when opened by an extension.
+  if (!request.is_navigation_request &&
+      (initiator.SchemeIs(extensions::kExtensionScheme) ||
+       document_site.SchemeIs(extensions::kExtensionScheme))) {
+    std::move(callback).Run(net::OK);
+    return;
+  }
+  // Opaque/about:blank/data website documents can issue their first HTTP
+  // request before a committed HTTP URL exists. They must still wait for policy.
+  // Preserve browser UI traffic rather than treating it as website content.
+  if (!request.is_navigation_request &&
+      (content::HasWebUIScheme(initiator) ||
+       content::HasWebUIScheme(document_site) ||
+       initiator.SchemeIs(content::kChromeDevToolsScheme) ||
+       document_site.SchemeIs(content::kChromeDevToolsScheme))) {
+    std::move(callback).Run(net::OK);
+    return;
+  }
+  if (!NativeContentBlocker::RequiresInterception()) {
+    std::move(callback).Run(net::OK);
+    return;
+  }
+  auto* frame = document.AsRenderFrameHostIfValid();
+  if ((frame && frame->GetBrowserContext() != context) ||
+      Profile::FromBrowserContext(context)->ShutdownStarted()) {
+    std::move(callback).Run(net::ERR_ABORTED);
+    return;
+  }
+  auto* contents = frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr;
+  auto client = NativeContentBlocker::CaptureClient(
+      contents, frame, document_site.is_empty() ? initiator : document_site);
+  // Never consult a replacement WebContents URL after the extension delay.
+  client.document = document;
+  client.site = document_site.is_empty() ? initiator : document_site;
+  auto* service = NativeContentBlocker::Get(Profile::FromBrowserContext(context), true);
+  service->Check(request.url, initiator, std::move(client),
+                WebRequestResourceTypeToString(request.web_request_type),
+                request.method, std::move(callback));
+#else
+  std::move(callback).Run(net::OK);
+#endif
+}
+
 network::mojom::NetworkContext*
 ChromeExtensionsBrowserClient::GetSystemNetworkContext() {
   DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
