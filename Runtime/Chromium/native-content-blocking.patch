@@ -0,0 +1,25 @@
+# Native matcher proof links the exact pinned Intel Rust artifact recorded in
+# the handoff. Other architectures remain unqualified, not silently substituted.
+assert(is_mac)
+source_set("native_content_blocker") {
+  sources = [ "native_content_blocker.cc", "native_content_blocker.h" ]
+  public_deps = [ "//base", "//components/keyed_service/core", "//url" ]
+  deps = [
+    ":nook_adblock",
+    "//chrome/browser/profiles:profile",
+    "//chrome/browser/ui/browser_window",
+    "//components/tabs:public",
+    "//content/public/browser",
+    "//net",
+  ]
+}
+source_set("nook_adblock") {
+  sources = [ "nook_adblock/nook_adblock.h" ]
+  libs = [ "//chrome/browser/content_blocking/nook_adblock/libnook_adblock.dylib" ]
+  data_deps = [ ":nook_adblock_runtime" ]
+}
+
+copy("nook_adblock_runtime") {
+  sources = [ "nook_adblock/libnook_adblock.dylib" ]
+  outputs = [ "$root_out_dir/Libraries/{{source_file_part}}" ]
+}
