+TEST_F(SegregatedPrefStoreTest, InitializationFailureNotifiedOnce) {
+  for (bool fail_default : {false, true}) {
+    for (bool failure_first : {false, true}) {
+      SCOPED_TRACE(testing::Message() << "fail_default=" << fail_default
+                                      << " failure_first=" << failure_first);
+      auto failed = base::MakeRefCounted<FailedInitializationPrefStore>();
+      auto peer = base::MakeRefCounted<TestingPrefStore>();
+      failed->set_read_error(
+          PersistentPrefStore::PREF_READ_ERROR_FILE_NOT_SPECIFIED);
+      failed->SetBlockAsyncRead(true);
+      peer->SetBlockAsyncRead(true);
+      auto store = base::MakeRefCounted<SegregatedPrefStore>(
+          fail_default ? failed : peer, fail_default ? peer : failed,
+          PrefNameSet());
+      InitializationCountingObserver observer;
+      store->AddObserver(&observer);
+      MockReadErrorDelegate::Data error(
+          false, PersistentPrefStore::PREF_READ_ERROR_NONE);
+      store->ReadPrefsAsync(new MockReadErrorDelegate(&error));
+      EXPECT_TRUE(observer.completions.empty());
+      if (failure_first) {
+        failed->SetBlockAsyncRead(false);
+        EXPECT_EQ(std::vector<bool>({false}), observer.completions);
+        peer->SetBlockAsyncRead(false);
+      } else {
+        peer->SetBlockAsyncRead(false);
+        EXPECT_TRUE(observer.completions.empty());
+        failed->SetBlockAsyncRead(false);
+      }
+      EXPECT_EQ(std::vector<bool>({false}), observer.completions);
+      EXPECT_FALSE(store->IsInitializationComplete());
+      EXPECT_FALSE(error.invoked);
+      store->RemoveObserver(&observer);
+    }
+  }
+}
+
+TEST_F(SegregatedPrefStoreTest, FailureCallbackCanCompletePeerReentrantly) {
+  auto failed = base::MakeRefCounted<FailedInitializationPrefStore>();
+  auto peer = base::MakeRefCounted<TestingPrefStore>();
+  failed->SetBlockAsyncRead(true);
+  peer->SetBlockAsyncRead(true);
+  auto store =
+      base::MakeRefCounted<SegregatedPrefStore>(failed, peer, PrefNameSet());
+  InitializationCountingObserver observer;
+  observer.on_completion = base::BindRepeating(
+      [](TestingPrefStore* peer) { peer->SetBlockAsyncRead(false); },
+      base::Unretained(peer.get()));
+  store->AddObserver(&observer);
+  store->ReadPrefsAsync(nullptr);
+  failed->SetBlockAsyncRead(false);
+  EXPECT_EQ(std::vector<bool>({false}), observer.completions);
+  EXPECT_TRUE(peer->IsInitializationComplete());
+  store->RemoveObserver(&observer);
+}
+
+TEST_F(SegregatedPrefStoreTest, FailureCallbackCanReleaseStoreDuringRead) {
+  auto failed = base::MakeRefCounted<FailedInitializationPrefStore>();
+  auto peer = base::MakeRefCounted<TestingPrefStore>();
+  auto store =
+      base::MakeRefCounted<SegregatedPrefStore>(failed, peer, PrefNameSet());
+  InitializationCountingObserver observer;
+  observer.on_completion = base::BindLambdaForTesting([&] {
+    store->RemoveObserver(&observer);
+    store.reset();
+  });
+  store->AddObserver(&observer);
+  store->ReadPrefsAsync(nullptr);
+  EXPECT_FALSE(store);
+  EXPECT_EQ(std::vector<bool>({false}), observer.completions);
+  EXPECT_TRUE(peer->IsInitializationComplete());
 }

