+void ChromeRenderFrameObserver::ResetNookBoostPicker(bool cleanup_document) {
+  nook_boost_picker_weak_.InvalidateWeakPtrs();
+  auto pending = std::move(nook_boost_picker_);
+  nook_boost_picker_.reset();
+  v8::Global<v8::Object> controller = std::move(nook_boost_picker_controller_);
+#if BUILDFLAG(IS_MAC)
+  // OnDestruct has no Blink frame; idle resets need no frame access either.
+  // Retire native ownership before Blink execution or the reply can reenter us.
+  if (cleanup_document && pending && !controller.IsEmpty()) {
+    auto* frame = render_frame()->GetWebFrame();
+    if (frame && frame->GetDocument().Token() == pending->document) {
+      auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+      v8::HandleScope handles(isolate);
+      const auto frame_token = frame->GetLocalFrameToken();
+      auto context = frame->GetScriptContextFromWorldId(
+          isolate, ISOLATED_WORLD_ID_NOOK_BOOST_PICKER);
+      if (!context.IsEmpty()) {
+        v8::Context::Scope entered(context);
+        auto object = controller.Get(isolate);
+        v8::Local<v8::Value> stop;
+        if (object->Get(context, v8::String::NewFromUtf8Literal(isolate, "stop"))
+                .ToLocal(&stop) && stop->IsFunction()) {
+          frame = blink::WebLocalFrame::FromFrameToken(frame_token);
+          if (frame && frame->GetDocument().Token() == pending->document)
+            frame->RequestExecuteV8Function(context, stop.As<v8::Function>(),
+                                            object, 0, nullptr, {});
+        }
+      }
+    }
+  }
+#endif
+  if (pending) std::move(pending->callback).Run("");
+}
+
+void ChromeRenderFrameObserver::FinishNookBoostPicker(const std::string& selector) {
+  if (!nook_boost_picker_) return;
+  auto* frame = render_frame()->GetWebFrame();
+  const bool current = frame && frame->GetDocument().Token() == nook_boost_picker_->document;
+  auto callback = std::move(nook_boost_picker_->callback);
+  nook_boost_picker_.reset();
+  nook_boost_picker_controller_.Reset();
+  nook_boost_picker_weak_.InvalidateWeakPtrs();
+  std::move(callback).Run(current && selector.size() <= 2048 ? selector : "");
+}
+
+void ChromeRenderFrameObserver::NookCancelBoostPicker(
+    const blink::DocumentToken& document, uint64_t owner, uint64_t request) {
+  if (nook_boost_picker_ && nook_boost_picker_->document == document &&
+      nook_boost_picker_->owner == owner && nook_boost_picker_->request == request)
+    ResetNookBoostPicker();
+}
+
+void ChromeRenderFrameObserver::NookStartBoostPicker(
+    const blink::DocumentToken& document, uint64_t owner, uint64_t request,
+    NookStartBoostPickerCallback callback) {
+#if !BUILDFLAG(IS_MAC)
+  std::move(callback).Run("");
+#else
+  auto* frame = render_frame()->GetWebFrame();
+  if (nook_boost_picker_ || !frame || !render_frame()->IsMainFrame() || !owner || !request ||
+      frame->GetDocument().Token() != document ||
+      !GURL(frame->GetDocument().Url()).SchemeIsHTTPOrHTTPS() ||
+      !render_frame()->GetBlinkPreferences().javascript_enabled ||
+      (frame->GetContentSettings() && !frame->GetContentSettings()->allow_script)) {
+    std::move(callback).Run(""); return;
+  }
+  auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handles(isolate);
+  v8::TryCatch errors(isolate);
+  const auto frame_token = frame->GetLocalFrameToken();
+  auto alive = nook_boost_picker_weak_.GetWeakPtr();
+  // The ordinary Blink path enforces sandbox/script policy; no policy bypass.
+  auto allowed = frame->ExecuteScriptAndReturnValue(
+      blink::WebScriptSource(blink::WebString::FromUtf8("true")));
+  if (!alive) { std::move(callback).Run(""); return; }
+  frame = blink::WebLocalFrame::FromFrameToken(frame_token);
+  if (!frame || frame->GetDocument().Token() != document || allowed.IsEmpty() || !allowed->IsTrue()) {
+    std::move(callback).Run(""); return;
+  }
+  const auto source = ui::ResourceBundle::GetSharedInstance().LoadDataResourceString(IDR_NOOK_BOOST_PICKER);
+  auto factory = frame->ExecuteScriptInIsolatedWorldAndReturnValue(
+      ISOLATED_WORLD_ID_NOOK_BOOST_PICKER,
+      blink::WebScriptSource(blink::WebString::FromUtf8(source)),
+      blink::BackForwardCacheAware::kAllow);
+  if (!alive) { std::move(callback).Run(""); return; }
+  frame = blink::WebLocalFrame::FromFrameToken(frame_token);
+  if (!frame || frame->GetDocument().Token() != document || factory.IsEmpty() || !factory->IsFunction()) {
+    std::move(callback).Run(""); return;
+  }
+  auto context = frame->GetScriptContextFromWorldId(isolate, ISOLATED_WORLD_ID_NOOK_BOOST_PICKER);
+  if (context.IsEmpty()) { std::move(callback).Run(""); return; }
+  v8::Context::Scope entered(context);
+  nook_boost_picker_.emplace(NookBoostPicker{document, owner, request, std::move(callback)});
+  v8::Local<v8::Function> send, install;
+  if (!gin::CreateFunctionTemplate(isolate, base::BindRepeating(
+      [](base::WeakPtr<ChromeRenderFrameObserver> self, blink::DocumentToken document,
+         const std::string& selector) {
+        if (self && self->nook_boost_picker_ && self->nook_boost_picker_->document == document)
+          self->FinishNookBoostPicker(selector);
+      }, alive, document))->GetFunction(context).ToLocal(&send) ||
+      !gin::CreateFunctionTemplate(isolate, base::BindRepeating(
+      [](base::WeakPtr<ChromeRenderFrameObserver> self, blink::DocumentToken document,
+         gin::Arguments* args) {
+        if (!self || !self->nook_boost_picker_ || self->nook_boost_picker_->document != document) {
+          args->Return(false); return;
+        }
+        auto* frame = self->render_frame()->GetWebFrame();
+        if (!frame || frame->GetDocument().Token() != document ||
+            !self->render_frame()->GetBlinkPreferences().javascript_enabled ||
+            (frame->GetContentSettings() && !frame->GetContentSettings()->allow_script) ||
+            frame->GetScriptContextFromWorldId(args->isolate(), ISOLATED_WORLD_ID_NOOK_BOOST_PICKER)
+                != args->isolate()->GetCurrentContext()) { args->Return(false); return; }
+        v8::Local<v8::Value> object;
+        if (args->Length() && args->GetNext(&object) && object->IsObject())
+          self->nook_boost_picker_controller_.Reset(args->isolate(), object.As<v8::Object>());
+        args->Return(true);
+      }, alive, document))->GetFunction(context).ToLocal(&install)) {
+    ResetNookBoostPicker(); return;
+  }
+  v8::Local<v8::Value> args[] = {send, install};
+  frame->RequestExecuteV8Function(context, factory.As<v8::Function>(),
+      v8::Undefined(isolate), 2, args, base::BindOnce(
+      [](base::WeakPtr<ChromeRenderFrameObserver> self, std::optional<base::Value>, base::TimeTicks) {
+        if (self && self->nook_boost_picker_controller_.IsEmpty()) self->ResetNookBoostPicker();
+      }, alive));
+#endif
 }
 
