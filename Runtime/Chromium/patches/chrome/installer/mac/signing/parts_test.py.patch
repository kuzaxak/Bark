+class TestNativeShellParts(unittest.TestCase):
+    def test_native_parts_are_explicit_and_nested_ordered(self):
+        products = parts.get_parts(test_config.TestConfigNonChromeBranded())
+        names = [name for name in products if name.startswith('native-')]
+        self.assertEqual(names, [
+            'native-sparkle-downloader', 'native-sparkle-installer',
+            'native-sparkle-updater', 'native-sparkle-autoupdate',
+            'native-sparkle-framework', 'native-shell'])
+        for name in names:
+            self.assertIsNone(products[name].entitlements)
+            self.assertEqual(name != 'native-shell', products[name].replace_existing_signature)
+            self.assertEqual(name != 'native-shell', products[name].preserve_entitlements)
+            if name not in ('native-shell', 'native-sparkle-framework'):
+                self.assertEqual(model.CodeSignOptions.FULL_HARDENED_RUNTIME_OPTIONS,
+                                 products[name].options)
+        self.assertFalse(products['native-shell'].sign_with_identifier)
+        self.assertEqual('ee.qdo.nook.NativeShell',
+                         products['native-shell'].identifier)
+        self.assertEqual('App Product.app/Contents/Frameworks/NookNativeShell.framework',
+                         products['native-shell'].path)
+        self.assertEqual('App Product.app/Contents/Frameworks/Product Framework.framework',
+                         products['framework'].path)
+        self.assertEqual('org.sparkle-project.DownloaderService',
+                         products['native-sparkle-downloader'].identifier)
+
+    @mock.patch('signing.parts._sanity_check_version_keys')
+    @mock.patch('signing.signing.validate_app_geometry')
+    @mock.patch('signing.signing.validate_app', new_callable=mock.AsyncMock)
+    @mock.patch('signing.commands.copy_files')
+    @mock.patch('signing.signing.sign_part')
+    def test_native_failure_stops_before_outer_app(self, sign, *unused):
+        config = test_config.TestConfigNonChromeBranded()
+        sign.side_effect = RuntimeError('native signing refused')
+        with self.assertRaisesRegex(RuntimeError, 'native signing refused'):
+            asyncio.run(parts.sign_chrome(model.Paths('/i', '/o', '/w'), config,
+                                         sign_framework=False))
+        self.assertEqual(1, sign.call_count)
+        self.assertTrue(sign.call_args.args[2].path.endswith('Downloader.xpc'))
+
+    @mock.patch('signing.parts._sanity_check_version_keys')
+    @mock.patch('signing.signing.validate_app_geometry')
+    @mock.patch('signing.signing.validate_app', new_callable=mock.AsyncMock)
+    @mock.patch('signing.commands.copy_files')
+    @mock.patch('signing.signing.sign_part')
+    def test_native_signing_once_in_order_with_or_without_framework(self, sign, *unused):
+        root = 'App Product.app/Contents/Frameworks/'
+        expected = [root + 'Sparkle.framework/Versions/B/' + suffix for suffix in (
+            'XPCServices/Downloader.xpc', 'XPCServices/Installer.xpc',
+            'Updater.app', 'Autoupdate')]
+        expected += [root + 'Sparkle.framework', root + 'NookNativeShell.framework']
+        for sign_framework in (False, True):
+            with self.subTest(sign_framework=sign_framework):
+                sign.reset_mock()
+                config = test_config.TestConfigNonChromeBranded()
+                asyncio.run(parts.sign_chrome(model.Paths('/i', '/o', '/w'),
+                                             config, sign_framework=sign_framework))
+                paths = [call.args[2].path for call in sign.call_args_list]
+                self.assertEqual(expected, paths[:6])
+                for path in expected:
+                    self.assertEqual(1, paths.count(path))
+                self.assertEqual('App Product.app', paths[-1])
+                if not sign_framework:
+                    self.assertNotIn(config.framework_dir, paths)
