+void ChromeRenderFrameObserver::NookSponsorRequest(const std::string& video, const std::string& uuid) {
+#if BUILDFLAG(IS_MAC)
+  if (!nook_page_tweaks_ || nook_page_tweaks_->sponsor_block.empty() ||
+      !nook_page_tweaks_document_ || !nook_document_resources_ || video.size() != 11 || uuid.size() > 64) return;
+  auto* frame = render_frame()->GetWebFrame();
+  const auto document = *nook_page_tweaks_document_;
+  if (!frame || frame->GetDocument().Token() != document ||
+      !render_frame()->GetBlinkPreferences().javascript_enabled ||
+      (frame->GetContentSettings() && !frame->GetContentSettings()->allow_script)) return;
+  if (!uuid.empty()) { nook_document_resources_->ReportSponsorSegment(document, video, uuid); return; }
+  nook_document_resources_->GetSponsorSegments(document, video, base::BindOnce(
+      [](base::WeakPtr<ChromeRenderFrameObserver> self, blink::DocumentToken document,
+         chrome::mojom::NookSponsorReplyPtr reply) {
+        if (!self || !reply || self->nook_page_tweaks_document_ != document ||
+            !self->nook_page_tweaks_ || self->nook_page_tweaks_->sponsor_block.empty()) return;
+        auto* frame = self->render_frame()->GetWebFrame();
+        if (!frame || frame->GetDocument().Token() != document || self->nook_sponsor_controller_.IsEmpty()) return;
+        base::ListValue segments;
+        for (const auto& segment : reply->segments) {
+          base::DictValue item; item.Set("UUID", segment->uuid);
+          item.Set("segment", base::ListValue().Append(segment->start).Append(segment->end));
+          item.Set("category", segment->category); item.Set("actionType", segment->action);
+          segments.Append(std::move(item));
+        }
+        base::DictValue options;
+        for (const auto& [key, value] : reply->options) options.Set(key, value);
+        base::ListValue args; args.Append(std::move(segments)); args.Append(std::move(options)); args.Append(reply->video);
+        const auto source = "(function(){const a=" + base::WriteJson(args).value_or("[]") +
+            ";window.__nookSponsorBlock?.receiveSegments(...a)})()";
+        auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+        v8::HandleScope handles(isolate);
+        auto context = frame->MainWorldScriptContext();
+        if (context.IsEmpty()) return;
+        v8::Context::Scope entered(context);
+        v8::Local<v8::Function> gate;
+        if (!gin::CreateFunctionTemplate(isolate, base::BindRepeating(
+            [](base::WeakPtr<ChromeRenderFrameObserver> current, blink::DocumentToken document,
+               std::string source) {
+              if (!current || current->nook_page_tweaks_document_ != document ||
+                  current->nook_sponsor_controller_.IsEmpty()) return;
+              auto* frame = current->render_frame()->GetWebFrame();
+              if (!frame || frame->GetDocument().Token() != document ||
+                  !current->render_frame()->GetBlinkPreferences().javascript_enabled ||
+                  (frame->GetContentSettings() && !frame->GetContentSettings()->allow_script)) return;
+              const auto token = frame->GetLocalFrameToken();
+              auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+              v8::HandleScope handles(isolate);
+              auto allowed = frame->ExecuteScriptAndReturnValue(
+                  blink::WebScriptSource(blink::WebString::FromUtf8("true")));
+              if (!current || allowed.IsEmpty() || !allowed->IsTrue()) return;
+              frame = blink::WebLocalFrame::FromFrameToken(token);
+              if (!frame || frame->GetDocument().Token() != document) return;
+              const blink::WebScriptSource script(blink::WebString::FromUtf8(source));
+              frame->RequestExecuteScript(ISOLATED_WORLD_ID_NOOK_PAGE_TWEAKS, base::span_from_ref(script),
+                  blink::mojom::UserActivationOption::kDoNotActivate, blink::mojom::EvaluationTiming::kSynchronous,
+                  blink::mojom::LoadEventBlockingOption::kDoNotBlock, {}, blink::BackForwardCacheAware::kAllow,
+                  blink::mojom::WantResultOption::kNoResult, blink::mojom::PromiseResultOption::kDoNotWait, {});
+            }, self->nook_page_tweaks_weak_.GetWeakPtr(), document, source))->GetFunction(context).ToLocal(&gate)) return;
+        frame->RequestExecuteV8Function(context, gate, v8::Undefined(isolate), 0, nullptr, {});
+      }, nook_page_tweaks_weak_.GetWeakPtr(), document));
+#endif
+}
