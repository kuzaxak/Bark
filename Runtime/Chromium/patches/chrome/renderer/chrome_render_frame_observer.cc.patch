+
+void ChromeRenderFrameObserver::PrepareNookCosmetics() {
+#if BUILDFLAG(IS_MAC)
+  // ReadyToCommit runs before DidCreateNewDocument. Retire old native resources
+  // here, before obtaining the incoming document's one resource receiver.
+  ResetNookDocumentResources(false);
+  auto current = nook_page_tweaks_weak_.GetWeakPtr();
+  auto* frame = render_frame()->GetWebFrame();
+  if (!frame) return;
+  const auto frame_token = frame->GetLocalFrameToken();
+  const auto document = frame->GetDocument().Token();
+  ResetNookCosmetics();
+  // Cleanup may execute JavaScript and reenter preparation, even with a reused
+  // document token. Both the existing weak epoch and exact frame must survive.
+  if (!current) return;
+  frame = blink::WebLocalFrame::FromFrameToken(frame_token);
+  if (!frame || frame->GetDocument().Token() != document) return;
+  const GURL url(frame->GetDocument().Url());
+  if (!url.SchemeIsHTTPOrHTTPS()) return;
+  // Blink has installed the incoming Document before this observer callback.
+  // Browser authority checks its pending commit token, never only this URL.
+  auto alive = nook_cosmetic_weak_.GetWeakPtr();
+  mojo::Remote<chrome::mojom::NookCosmeticResourcesHost> host;
+  render_frame()->GetBrowserInterfaceBroker().GetInterface(
+      host.BindNewPipeAndPassReceiver());
+  chrome::mojom::NookCosmeticResourcesPtr resources;
+  if (!host->GetResources(document, &resources) || !alive || !resources)
+    return;
+  frame = blink::WebLocalFrame::FromFrameToken(frame_token);
+  if (!frame || frame->GetDocument().Token() != document) return;
+  nook_page_tweaks_ = std::move(resources->page_tweaks);
+  nook_page_tweaks_document_ = document;
+  nook_document_resources_ = std::move(host);
+  nook_cosmetics_ = std::move(resources);
+  nook_cosmetic_document_ = document;
+#endif
+}
+
+void ChromeRenderFrameObserver::ResetNookCosmetics() {
+#if BUILDFLAG(IS_MAC)
+  // Retire deferred installs/acks before cleanup can execute JS or reenter us.
+  nook_cosmetic_weak_.InvalidateWeakPtrs();
+  const auto reset_state = [this] {
+    nook_cosmetic_styles_.clear();
+    nook_cosmetic_observer_.Reset();
+    nook_cosmetic_ack_.Reset();
+    nook_cosmetic_selectors_.clear();
+    nook_cosmetic_generic_css_.clear();
+    nook_cosmetic_generic_style_ = blink::WebString();
+    nook_cosmetics_.reset();
+    nook_cosmetic_document_.reset();
+    nook_cosmetics_started_ = false;
+  };
+  auto* frame = render_frame()->GetWebFrame();
+  if (!frame) { reset_state(); return; }
+  auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handles(isolate);
+  v8::TryCatch errors(isolate);
+  const auto frame_token = frame->GetLocalFrameToken();
+  const auto document_token = nook_cosmetic_document_;
+  v8::Local<v8::Context> context;
+  v8::Local<v8::Object> object;
+  v8::Local<v8::Function> stop;
+  if (document_token && frame->GetDocument().Token() == *document_token) {
+    auto document = frame->GetDocument();
+    for (const auto& key : nook_cosmetic_styles_)
+      document.RemoveInsertedStyleSheet(key, blink::WebCssOrigin::kUser);
+    if (!nook_cosmetic_generic_style_.IsNull())
+      document.RemoveInsertedStyleSheet(nook_cosmetic_generic_style_,
+                                       blink::WebCssOrigin::kUser);
+    if (!nook_cosmetic_observer_.IsEmpty()) {
+      context = frame->GetScriptContextFromWorldId(
+          isolate, ISOLATED_WORLD_ID_NOOK_COSMETICS);
+      if (!context.IsEmpty()) {
+        v8::Context::Scope entered(context);
+        object = nook_cosmetic_observer_.Get(isolate);
+        v8::Local<v8::Value> method;
+        if (object->Get(context, v8::String::NewFromUtf8Literal(isolate, "stop"))
+                .ToLocal(&method) && method->IsFunction())
+          stop = method.As<v8::Function>();
+      }
+    }
+  }
+  reset_state();
+  // Blink retains this exact old ScriptState/function/object, not a later
+  // document's observer. Clear our state first: execution may be synchronous.
+  frame = blink::WebLocalFrame::FromFrameToken(frame_token);
+  if (frame && document_token && frame->GetDocument().Token() == *document_token &&
+      !context.IsEmpty() && !stop.IsEmpty())
+    frame->RequestExecuteV8Function(context, stop, object, 0, nullptr, {});
+  // No member access after entering JavaScript.
+#endif
+}
+
+void ChromeRenderFrameObserver::ClearNookCosmetics(
+    const blink::DocumentToken& document, uint64_t policy_generation) {
+#if BUILDFLAG(IS_MAC)
+  if (nook_cosmetic_document_ && *nook_cosmetic_document_ == document &&
+      (!nook_cosmetics_ || policy_generation > nook_cosmetics_->policy_generation))
+    ResetNookCosmetics();
+#endif
+}
+
+bool ChromeRenderFrameObserver::RunNookCosmeticsAtDocumentStart() {
+  if (!RunNookPageTweaksAtDocumentStart()) return false;
+#if BUILDFLAG(IS_MAC)
+  if (!nook_cosmetics_ || nook_cosmetics_started_ || !nook_cosmetic_document_)
+    return true;
+  auto* frame = render_frame()->GetWebFrame();
+  const auto document = *nook_cosmetic_document_;
+  const auto frame_token = frame->GetLocalFrameToken();
+  if (frame->GetDocument().Token() != document) return true;
+  nook_cosmetics_started_ = true;
+  if (!nook_cosmetics_->apply) return true;
+  if (!nook_cosmetics_->css.empty()) {
+    nook_cosmetic_styles_.push_back(frame->GetDocument().InsertStyleSheet(
+        blink::WebString::FromUtf8(nook_cosmetics_->css), nullptr,
+        blink::WebCssOrigin::kUser));
+  }
+  const auto& settings = frame->GetContentSettings();
+  if (!render_frame()->GetBlinkPreferences().javascript_enabled ||
+      (settings && !settings->allow_script)) return true;
+  auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handles(isolate);
+  const auto alive = nook_cosmetic_weak_.GetWeakPtr();
+  // Main-world execution uses Blink's normal sandbox/script policy, without
+  // granting activation. Do not call through a bypass/suspended-script API.
+  if (!nook_cosmetics_->scriptlets.empty()) {
+    const std::string source = "(function(){const scriptletGlobals={};\n" +
+        nook_cosmetics_->scriptlets + "\n})()";
+    frame->ExecuteScript(blink::WebScriptSource(blink::WebString::FromUtf8(source)));
+    if (!alive) return blink::WebLocalFrame::FromFrameToken(frame_token) != nullptr;
+    if (!nook_cosmetics_ || frame->GetDocument().Token() != document) return true;
+  }
+  if (nook_cosmetics_->generichide) return true;
+  // Probe the main-world sandbox before using the isolated generic observer.
+  auto allowed = frame->ExecuteScriptAndReturnValue(
+      blink::WebScriptSource(blink::WebString::FromUtf8("true")));
+  if (!alive) return blink::WebLocalFrame::FromFrameToken(frame_token) != nullptr;
+  if (allowed.IsEmpty() || !allowed->IsTrue() || !nook_cosmetics_ ||
+      frame->GetDocument().Token() != document) return true;
+  const auto observer_source = ui::ResourceBundle::GetSharedInstance()
+      .LoadDataResourceString(IDR_NOOK_COSMETIC_OBSERVER);
+  // The scoped install callback checks ownership again if Blink suspends this
+  // function. No object is installed after reset or into a replacement document.
+  const std::string source = "(function(send,install){if(!install())return;"
+      "const observer=(" + observer_source + ")(send);"
+      "if(!install(observer))observer.stop();})";
+  v8::TryCatch errors(isolate);
+  auto factory = frame->ExecuteScriptInIsolatedWorldAndReturnValue(
+      ISOLATED_WORLD_ID_NOOK_COSMETICS,
+      blink::WebScriptSource(blink::WebString::FromUtf8(source)),
+      blink::BackForwardCacheAware::kAllow);
+  if (!alive) return blink::WebLocalFrame::FromFrameToken(frame_token) != nullptr;
+  if (factory.IsEmpty() || !factory->IsFunction() || !nook_cosmetics_ ||
+      frame->GetDocument().Token() != document) return true;
+  auto context = frame->GetScriptContextFromWorldId(
+      isolate, ISOLATED_WORLD_ID_NOOK_COSMETICS);
+  if (context.IsEmpty()) return true;
+  v8::Context::Scope entered(context);
+  v8::Local<v8::Function> callback, install;
+  if (!gin::CreateFunctionTemplate(isolate, base::BindRepeating(
+          &ChromeRenderFrameObserver::NookCosmeticSelectors, alive))
+          ->GetFunction(context).ToLocal(&callback)) return true;
+  if (!gin::CreateFunctionTemplate(isolate, base::BindRepeating(
+          [](base::WeakPtr<ChromeRenderFrameObserver> self,
+             blink::DocumentToken document, gin::Arguments* arguments) {
+            if (!self || !self->nook_cosmetics_ ||
+                self->nook_cosmetic_document_ != document) {
+              arguments->Return(false); return;
+            }
+            auto* frame = self->render_frame()->GetWebFrame();
+            auto context = frame->GetScriptContextFromWorldId(
+                arguments->isolate(), ISOLATED_WORLD_ID_NOOK_COSMETICS);
+            if (frame->GetDocument().Token() != document || context.IsEmpty() ||
+                arguments->isolate()->GetCurrentContext() != context) {
+              arguments->Return(false); return;
+            }
+            const auto& settings = frame->GetContentSettings();
+            if (!self->render_frame()->GetBlinkPreferences().javascript_enabled ||
+                (settings && !settings->allow_script)) {
+              arguments->Return(false); return;
+            }
+            v8::Local<v8::Value> object;
+            if (arguments->Length() > 0 && arguments->GetNext(&object) && object->IsObject())
+              self->nook_cosmetic_observer_.Reset(arguments->isolate(),
+                                                 object.As<v8::Object>());
+            arguments->Return(true);
+          }, alive, document))->GetFunction(context).ToLocal(&install)) return true;
+  v8::Local<v8::Value> args[] = {callback, install};
+  frame->RequestExecuteV8Function(context, factory.As<v8::Function>(),
+                                  v8::Undefined(isolate), 2, args, {});
+  // A policy reset invalidates `alive` without destroying the frame; it must
+  // not suppress the other document-start consumers on that surviving frame.
+  return blink::WebLocalFrame::FromFrameToken(frame_token) != nullptr;
+#else
+  return true;
+#endif
+}
+
+
+void ChromeRenderFrameObserver::NookCosmeticSelectors(gin::Arguments* arguments) {
+#if BUILDFLAG(IS_MAC)
+  std::vector<std::string> classes, ids;
+  v8::Local<v8::Function> ack;
+  if (!nook_cosmetics_ || !nook_cosmetic_document_ || !nook_document_resources_ ||
+      !nook_cosmetic_ack_.IsEmpty() || !arguments->GetNext(&classes) ||
+      !arguments->GetNext(&ids) || !arguments->GetNext(&ack) ||
+      classes.size() + ids.size() > 128) return;
+  const auto document = *nook_cosmetic_document_;
+  const auto source_identity = nook_cosmetics_->source_identity;
+  nook_cosmetic_ack_.Reset(arguments->isolate(), ack);
+  nook_document_resources_->GetGenericSelectors(document, classes, ids,
+      base::BindOnce([](base::WeakPtr<ChromeRenderFrameObserver> self,
+          blink::DocumentToken document, uint64_t source_identity,
+          chrome::mojom::NookCosmeticResourcesPtr resources) {
+        if (!self || !self->nook_cosmetics_ || !self->nook_cosmetic_document_ ||
+            *self->nook_cosmetic_document_ != document) return;
+        if (!resources || resources->policy_generation < self->nook_cosmetics_->policy_generation ||
+            (resources->apply && resources->source_identity != source_identity) ||
+            self->render_frame()->GetWebFrame()->GetDocument().Token() != document) {
+          self->CompleteNookCosmeticBatch(false); return;
+        }
+        if (!resources->apply) { self->ResetNookCosmetics(); return; }
+        self->nook_cosmetics_->policy_generation = resources->policy_generation;
+        self->nook_cosmetics_->revision = resources->revision;
+        constexpr size_t kMaxSelectors = 4096, kMaxBytes = 512 * 1024;
+        bool more = true, changed = false;
+        for (const auto& selector : resources->generic_selectors) {
+          if (selector.size() > 4096 || self->nook_cosmetic_selectors_.contains(selector)) continue;
+          const std::string css = selector + "{display:none !important;}\n";
+          if (self->nook_cosmetic_selectors_.size() == kMaxSelectors ||
+              self->nook_cosmetic_generic_css_.size() + css.size() > kMaxBytes) {
+            more = false; break;
+          }
+          self->nook_cosmetic_selectors_.insert(selector);
+          self->nook_cosmetic_generic_css_ += css;
+          changed = true;
+        }
+        if (changed) {
+          auto doc = self->render_frame()->GetWebFrame()->GetDocument();
+          if (!self->nook_cosmetic_generic_style_.IsNull())
+            doc.RemoveInsertedStyleSheet(self->nook_cosmetic_generic_style_,
+                                         blink::WebCssOrigin::kUser);
+          self->nook_cosmetic_generic_style_ = doc.InsertStyleSheet(
+              blink::WebString::FromUtf8(self->nook_cosmetic_generic_css_), nullptr,
+              blink::WebCssOrigin::kUser);
+        }
+        self->CompleteNookCosmeticBatch(more);
+      }, nook_cosmetic_weak_.GetWeakPtr(), document, source_identity));
+#endif
+}
+
+void ChromeRenderFrameObserver::CompleteNookCosmeticBatch(bool more) {
+#if BUILDFLAG(IS_MAC)
+  if (nook_cosmetic_ack_.IsEmpty()) return;
+  auto* frame = render_frame()->GetWebFrame();
+  auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handles(isolate);
+  auto context = frame->GetScriptContextFromWorldId(
+      isolate, ISOLATED_WORLD_ID_NOOK_COSMETICS);
+  if (context.IsEmpty()) { nook_cosmetic_ack_.Reset(); return; }
+  v8::Context::Scope entered(context);
+  v8::TryCatch errors(isolate);
+  auto ack = nook_cosmetic_ack_.Get(isolate);
+  nook_cosmetic_ack_.Reset();
+  if (!nook_cosmetic_document_) return;
+  const auto document = *nook_cosmetic_document_;
+  auto retained = std::make_shared<v8::Global<v8::Function>>(isolate, ack);
+  v8::Local<v8::Function> execute;
+  if (!gin::CreateFunctionTemplate(isolate, base::BindRepeating(
+          [](base::WeakPtr<ChromeRenderFrameObserver> self,
+             blink::DocumentToken document,
+             std::shared_ptr<v8::Global<v8::Function>> ack, bool more,
+             gin::Arguments* arguments) {
+            if (!self || self->nook_cosmetic_document_ != document ||
+                !self->nook_cosmetics_) return;
+            auto* frame = self->render_frame()->GetWebFrame();
+            auto context = frame->GetScriptContextFromWorldId(
+                arguments->isolate(), ISOLATED_WORLD_ID_NOOK_COSMETICS);
+            if (frame->GetDocument().Token() != document || context.IsEmpty() ||
+                arguments->isolate()->GetCurrentContext() != context) return;
+            v8::Local<v8::Value> args[] = {
+                v8::Boolean::New(arguments->isolate(), more)}, ignored;
+            // This native thunk is entered by Blink's script executor, which
+            // supplies the required microtask scope (as for translation).
+            std::ignore = ack->Get(arguments->isolate())->Call(
+                context, v8::Undefined(arguments->isolate()), 1, args).ToLocal(&ignored);
+            // No observer member access after JavaScript.
+          }, nook_cosmetic_weak_.GetWeakPtr(), document, retained, more))
+          ->GetFunction(context).ToLocal(&execute)) return;
+  frame->RequestExecuteV8Function(context, execute, v8::Undefined(isolate),
+                                  0, nullptr, {});
+#endif
+}
