 // Messages sent from chrome to the render frame.
+// Fixed top-document translation channel; no arbitrary scripts or native methods.
+struct NookTranslationNode { string id; string text; };
+interface NookTranslationClient {
+  NodesChanged(blink.mojom.DocumentToken document, uint64 generation,
+               bool aborted, array<NookTranslationNode> nodes);
+};
+
+// Native automation results preserve undefined and failures separately from null.
+enum NookScriptStatus { kValue, kUndefined, kException, kRejected,
+                        kUnavailable, kBusy, kCancelled, kUnserializable };
+struct NookScriptResult {
+  NookScriptStatus status;
+  string text;
+  string json;
+  bool is_string;
+};
+
+// Only native matcher output is transported. No arbitrary script API or Swift
+// request is involved. The renderer waits; browser UI dispatches asynchronously
+// to the exact Profile's serialized matcher and revalidates before replying.
+struct NookSponsorSegment {
+  string uuid;
+  double start;
+  double end;
+  string category;
+  string action;
+};
+struct NookSponsorReply {
+  string video;
+  array<NookSponsorSegment> segments;
+  map<string, string> options;
+};
+struct NookPageTweaks {
+  map<string, string> sponsor_block;
+  bool social_download;
+  string youtube_css;
+  bool youtube_frames;
+  bool youtube_no_hover;
+  bool facebook_reels;
+  bool facebook_suggested;
+  bool reddit_hot;
+  array<string> boost_scripts;
+};
+struct NookCosmeticResources {
+  NookPageTweaks? page_tweaks;
+  bool apply;
+  uint64 revision;
+  uint64 policy_generation;
+  uint64 source_identity;
+  string css;
+  string scriptlets;
+  array<string> generic_selectors;
+  bool generichide;
+};
+interface NookCosmeticResourcesHost {
+  // Exact current top document and consumed browser activation, never an arbitrary download broker.
+  SaveSocialMedia(blink.mojom.DocumentToken document, string url, int32 net_referrer_policy) => (bool accepted);
+  GetSponsorSegments(blink.mojom.DocumentToken document, string video)
+      => (NookSponsorReply? reply);
+  ReportSponsorSegment(blink.mojom.DocumentToken document, string video, string uuid);
+  [Sync]
+  GetResources(blink.mojom.DocumentToken document)
+      => (NookCosmeticResources? resources);
+  GetGenericSelectors(blink.mojom.DocumentToken document,
+      array<string> classes, array<string> ids)
+      => (NookCosmeticResources? resources);
+};
+
 interface ChromeRenderFrame {
+  // Removes native CSS/observers only. Already-executed page-world scriptlets
+  // require the existing explicit blocker reload to take effect reversibly.
+  ClearNookCosmetics(blink.mojom.DocumentToken document, uint64 policy_generation);
+  // Retires only pending fixed tweaks/Boost continuations for this document.
+  ClearNookPageTweaks(blink.mojom.DocumentToken document);
   // Updates the window features of the main frame's render view.
   SetWindowFeatures(blink.mojom.WindowFeatures window_features);
 
