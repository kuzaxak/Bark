+  if (ProfilesToDelete().contains(profile_path)) { return true; }
+  if (!g_browser_process || !g_browser_process->local_state()) { return false; }
+  const auto& deleted = g_browser_process->local_state()->GetList(prefs::kProfilesDeleted);
