+
 #include "build/chromeos_buildflags.h"
 #include "chrome/browser/about_flags.h"
 #include "chrome/browser/browser_process.h"
@@ -234,6 +238,18 @@ void SwitchToProfile(const base::FilePath& path,
 
 void SwitchToGuestProfile(
     base::OnceCallback<void(BrowserWindowInterface*)> callback) {
+#if BUILDFLAG(IS_MAC)
+  // The product's private sessions have explicit asynchronous admission.
+  // Stock Guest/ProfilePicker windows have no Barc model/header owner.
+  if (barc::IsNativeApplicationRegistered() &&
+      base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "barc-shared-native-window")) {
+    if (callback) {
+      std::move(callback).Run(nullptr);
+    }
+    return;
+  }
+#endif
   SwitchToProfile(ProfileManager::GetGuestProfilePath(),
                   /*always_create=*/false, std::move(callback));
 }
