+
+void DeleteProfileHelper::DeleteProfileWithExplicitSurvivor(
+    const base::FilePath& profile_dir,
+    const base::FilePath& survivor_dir,
+    bool reconcile_only,
+    ExplicitDeletionCallback callback,
+    bool defer_wipe) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (defer_wipe && explicit_deletion_ &&
+      explicit_deletion_->phase == ExplicitDeletion::Phase::kAwaitingAssignmentCommit &&
+      explicit_deletion_->target == profile_dir && explicit_deletion_->survivor == survivor_dir) {
+    explicit_deletion_->callback = std::move(callback);
+    FinishExplicitDeletion(ExplicitDeletionResult::kCloseAdmitted);
+    return;
+  }
+  const bool reclaims_reservation = explicit_deletion_ &&
+      explicit_deletion_->phase != ExplicitDeletion::Phase::kRunning &&
+      explicit_deletion_->phase != ExplicitDeletion::Phase::kAwaitingAssignmentCommit &&
+      explicit_deletion_->target == profile_dir &&
+      explicit_deletion_->survivor == survivor_dir &&
+      (!reconcile_only || explicit_deletion_->marked);
+  const bool owns_scheduling =
+      reclaims_reservation && !explicit_deletion_->marked;
+  if ((explicit_deletion_ && !reclaims_reservation) ||
+      profile_dir == survivor_dir ||
+      IsProfileDirectoryPendingDeletion(survivor_dir)) {
+    std::move(callback).Run(
+        (explicit_deletion_ || IsProfileDirectoryPendingDeletion(profile_dir))
+            ? ExplicitDeletionResult::kPending
+            : ExplicitDeletionResult::kCancelled);
+    return;
+  }
+  auto* profile = profile_manager_->GetProfileByPath(profile_dir);
+  auto* survivor = profile_manager_->GetProfileByPath(survivor_dir);
+  if ((profile && !profile->IsRegularProfile()) ||
+      (survivor && !survivor->IsRegularProfile())) {
+    std::move(callback).Run(IsProfileDirectoryPendingDeletion(profile_dir)
+                               ? ExplicitDeletionResult::kPending
+                               : ExplicitDeletionResult::kCancelled);
+    return;
+  }
+  auto request = std::make_unique<ExplicitDeletion>(
+      profile_dir, survivor_dir, std::move(callback));
+  request->marked = WasMarkedForDeletion(profile_dir);
+  request->reconcile_only = reconcile_only;
+  request->defer_wipe = defer_wipe;
+  if (!request->marked && !owns_scheduling &&
+      !ScheduleProfileDirectoryForDeletion(profile_dir)) {
+    // Another deletion owns this path. Never steal its reservation.
+    request->marked = true;
+    return;
+  }
+  // Preserve the exact reservation through ALL asynchronous preparation. In
+  // particular, native window/extension factories must not reopen the target
+  // while the explicit survivor is being loaded. Replacing a matching reserved
+  // request transfers ownership without cancelling its SCHEDULING entry.
+  explicit_deletion_ = std::move(request);
+  explicit_deletion_->process_keep_alive = std::make_unique<ScopedKeepAlive>(
+      KeepAliveOrigin::PROFILE_MANAGER, KeepAliveRestartOption::DISABLED);
+  if (profile) {
+    explicit_deletion_->target_keep_alive = ScopedProfileKeepAlive::TryAcquire(
+        profile, ProfileKeepAliveOrigin::kProfileDeletionProcess);
+    if (!explicit_deletion_->target_keep_alive) {
+      ExplicitCloseCancelled(profile_dir);
+      return;
+    }
+  }
+  if (profile_manager_->IsProfilePendingDestruction(survivor_dir)) {
+    if (explicit_deletion_->defer_wipe && !explicit_deletion_->marked) {
+      ExplicitCloseCancelled(profile_dir);
+    } else {
+      FinishExplicitDeletion(ExplicitDeletionResult::kPending);
+    }
+    return;
+  }
+  if (survivor) {
+    ExplicitSurvivorLoaded(survivor);
+  } else {
+    explicit_deletion_->loaded_survivor_for_request = true;
+    profile_manager_->CreateProfileAsync(
+        survivor_dir,
+        base::BindOnce(&DeleteProfileHelper::ExplicitSurvivorLoaded,
+                       weak_factory_.GetWeakPtr()));
+  }
+}
+
+void DeleteProfileHelper::ExplicitSurvivorLoaded(Profile* survivor) {
+  if (!explicit_deletion_ ||
+      explicit_deletion_->phase != ExplicitDeletion::Phase::kRunning) {
+    return;
+  }
+  if (!survivor || !survivor->IsRegularProfile() ||
+      survivor->GetPath() != explicit_deletion_->survivor ||
+      profile_manager_->GetProfileByPath(survivor->GetPath()) != survivor ||
+      profile_manager_->IsProfilePendingDestruction(survivor->GetPath()) ||
+      IsProfileDirectoryPendingDeletion(survivor->GetPath())) {
+    ExplicitCloseCancelled(explicit_deletion_->target);
+    return;
+  }
+  explicit_deletion_->survivor_keep_alive = ScopedProfileKeepAlive::TryAcquire(
+      survivor, ProfileKeepAliveOrigin::kProfileDeletionProcess);
+  if (!explicit_deletion_->survivor_keep_alive) {
+    ExplicitCloseCancelled(explicit_deletion_->target);
+    return;
+  }
+  if (explicit_deletion_->loaded_survivor_for_request) {
+    // Do not release the initial reference inside ProfileManager's callback
+    // loop: other callbacks from that initialization may still borrow it.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE,
+        base::BindOnce(&DeleteProfileHelper::ReleaseSurvivorInitialReference,
+                       weak_factory_.GetWeakPtr(), survivor->GetWeakPtr()));
+  }
+  const auto path = explicit_deletion_->target;
+  auto* profile = profile_manager_->GetProfileByPath(path);
+  if (explicit_deletion_->reconcile_only && !explicit_deletion_->marked &&
+      (profile_manager_->IsProfileLoadedOrLoading(path) ||
+       profile_manager_->GetProfileAttributesStorage().GetProfileAttributesWithPath(path))) {
+    FinishExplicitDeletion(explicit_deletion_->defer_wipe
+                               ? ExplicitDeletionResult::kCancelled
+                               : ExplicitDeletionResult::kPending);
+    return;
+  }
+  if (profile) {
+    // Unlike stock settings deletion, do NOT cancel downloads before the user
+    // has accepted every beforeunload prompt.
+    chrome::CloseAllBrowsersWithProfile(
+        profile, false,
+        base::BindRepeating(&DeleteProfileHelper::ExplicitBrowsersClosed,
+                            weak_factory_.GetWeakPtr()),
+        base::BindRepeating(&DeleteProfileHelper::ExplicitCloseCancelled,
+                            weak_factory_.GetWeakPtr()));
+  } else {
+    ExplicitBrowsersClosed(path);
+  }
+}
+
+void DeleteProfileHelper::ReleaseSurvivorInitialReference(
+    base::WeakPtr<Profile> survivor) {
+  if (survivor && profile_manager_->GetProfileByPath(survivor->GetPath()) == survivor.get()) {
+    profile_manager_->ClearFirstBrowserWindowKeepAlive(survivor.get());
+  }
+}
+
+void DeleteProfileHelper::ExplicitCloseCancelled(const base::FilePath& path) {
+  if (!explicit_deletion_ || explicit_deletion_->phase != ExplicitDeletion::Phase::kRunning || explicit_deletion_->target != path) { return; }
+  if (explicit_deletion_->marked) {
+    FinishExplicitDeletion(ExplicitDeletionResult::kPending);
+    return;
+  }
+  // Retain our scheduling reservation until the application durably commits
+  // cancellation, including when that persistence attempt fails.
+  FinishExplicitDeletion(ExplicitDeletionResult::kCancelled);
+}
+
+void DeleteProfileHelper::ExplicitBrowsersClosed(const base::FilePath& path) {
+  if (!explicit_deletion_ || explicit_deletion_->phase != ExplicitDeletion::Phase::kRunning || explicit_deletion_->target != path) { return; }
+  auto* survivor = profile_manager_->GetProfileByPath(explicit_deletion_->survivor);
+  if (!survivor || !survivor->IsRegularProfile() ||
+      IsProfileDirectoryPendingDeletion(survivor->GetPath())) {
+    ExplicitCloseCancelled(path);
+    return;
+  }
+  if (auto* profile = profile_manager_->GetProfileByPath(path)) {
+    ExplicitProfileLoaded(profile);
+    return;
+  }
+  if (profile_manager_->IsProfilePendingDestruction(path)) {
+    // Joining here would queue a NEW target after destruction. Preserve the
+    // intent/reservation until the old context and services are actually gone.
+    if (explicit_deletion_->defer_wipe && !explicit_deletion_->marked) {
+      ExplicitCloseCancelled(path);
+    } else {
+      FinishExplicitDeletion(ExplicitDeletionResult::kPending);
+    }
+    return;
+  }
+  if (profile_manager_->IsProfileLoadedOrLoading(path)) {
+    // Join the existing registration, never manufacture a target to test its
+    // absence. Scheduling prevents the original factory from opening a window.
+    profile_manager_->CreateProfileAsync(
+        path, base::BindOnce(&DeleteProfileHelper::ExplicitProfileLoaded,
+                             weak_factory_.GetWeakPtr()));
+    return;
+  }
+  auto& storage = profile_manager_->GetProfileAttributesStorage();
+  if (!storage.GetProfileAttributesWithPath(path) || explicit_deletion_->marked) {
+    // Restart cleanup can have removed the directory and marker. Prove both
+    // profile and cache absent without recreating a Profile to "check" it.
+    CheckExplicitMissing();
+    return;
+  }
+  profile_manager_->LoadProfileByPath(
+      path, false, base::BindOnce(&DeleteProfileHelper::ExplicitProfileLoaded,
+                                  weak_factory_.GetWeakPtr()));
+}
+
+void DeleteProfileHelper::CheckExplicitMissing() {
+  if (!explicit_deletion_ || explicit_deletion_->phase != ExplicitDeletion::Phase::kRunning) { return; }
+  const auto path = explicit_deletion_->target;
+  base::FilePath cache;
+  chrome::GetUserCacheDirectory(path, &cache);
+  base::ThreadPool::PostTaskAndReplyWithResult(
+    FROM_HERE, {base::MayBlock(), base::TaskPriority::USER_VISIBLE},
+    base::BindOnce([](base::FilePath path, base::FilePath cache) {
+      return !base::PathExists(path) && !base::PathExists(cache);
+    }, path, cache),
+    base::BindOnce(&DeleteProfileHelper::ExplicitMissingChecked,
+             weak_factory_.GetWeakPtr()));
+}
+
+void DeleteProfileHelper::ExplicitMissingChecked(bool absent) {
+  if (!explicit_deletion_ || explicit_deletion_->phase != ExplicitDeletion::Phase::kRunning) { return; }
+  const auto& path = explicit_deletion_->target;
+  if (absent && !profile_manager_->IsProfileLoadedOrLoading(path) &&
+      !profile_manager_->IsProfilePendingDestruction(path)) {
+    // No live BrowserContext/services or persistent bytes remain.
+    auto& storage = profile_manager_->GetProfileAttributesStorage();
+    if (storage.GetProfileAttributesWithPath(path)) { storage.RemoveProfile(path); }
+    if (!explicit_deletion_->marked) { CancelProfileDeletion(path); }
+    FinishExplicitDeletion(ExplicitDeletionResult::kDeleted);
+  } else if (explicit_deletion_->defer_wipe && !explicit_deletion_->marked) {
+    // Orphaned bytes are still source data. Without a live Profile there is no
+    // close-admitted continuation, so do not erase them before model commit.
+    FinishExplicitDeletion(ExplicitDeletionResult::kPending);
+  } else if (!profile_manager_->IsProfileLoadedOrLoading(path) &&
+             !profile_manager_->IsProfilePendingDestruction(path) &&
+             !profile_manager_->GetProfileAttributesStorage().GetProfileAttributesWithPath(path) &&
+             !explicit_deletion_->disk_cleanup_started &&
+             (!explicit_deletion_->reconcile_only || explicit_deletion_->marked)) {
+    // No live services remain. Reuse Chromium's bounded disk cleanup; its
+    // callback does not report success, so verify absence separately afterward.
+    explicit_deletion_->disk_cleanup_started = true;
+    base::ThreadPool::PostTask(
+        FROM_HERE,
+        {base::MayBlock(), base::TaskPriority::USER_VISIBLE,
+         base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+        base::BindOnce(
+            &NukeProfileFromDisk, path,
+            base::BindOnce(&DeleteProfileHelper::CheckExplicitMissing,
+                           weak_factory_.GetWeakPtr())));
+  } else {
+    // Retain the durable intent even when native restart cleanup was incomplete.
+    FinishExplicitDeletion(ExplicitDeletionResult::kPending);
+  }
+}
+
+void DeleteProfileHelper::ExplicitProfileLoaded(Profile* profile) {
+  if (!explicit_deletion_ || explicit_deletion_->phase != ExplicitDeletion::Phase::kRunning) { return; }
+  if (!profile || !profile->IsRegularProfile() ||
+      profile->GetPath() != explicit_deletion_->target ||
+      profile_manager_->GetProfileByPath(profile->GetPath()) != profile) {
+    ExplicitCloseCancelled(explicit_deletion_->target);
+    return;
+  }
+  auto* survivor = profile_manager_->GetProfileByPath(explicit_deletion_->survivor);
+  if (!survivor || IsProfileDirectoryPendingDeletion(survivor->GetPath())) {
+    ExplicitCloseCancelled(explicit_deletion_->target);
+    return;
+  }
+  if (!explicit_deletion_->target_keep_alive) {
+    explicit_deletion_->target_keep_alive = ScopedProfileKeepAlive::TryAcquire(
+        profile, ProfileKeepAliveOrigin::kProfileDeletionProcess);
+    if (!explicit_deletion_->target_keep_alive) {
+      ExplicitCloseCancelled(explicit_deletion_->target);
+      return;
+    }
+  }
+  if (explicit_deletion_->defer_wipe) {
+    FinishExplicitDeletion(ExplicitDeletionResult::kCloseAdmitted);
+    return;
+  }
+  // Set before notifying arbitrary profile/extension observers.
+  if (!explicit_deletion_->marked) {
+    explicit_deletion_->marked = true;
+    MarkProfileDirectoryForDeletion(profile->GetPath());
+  }
+  profiles::SetLastUsedProfile(survivor->GetPath().BaseName());
+  DownloadCoreServiceFactory::GetForBrowserContext(profile)->CancelDownloads(
+      DownloadCoreService::CancelDownloadsTrigger::kProfileDeletion);
+  profile_manager_->NotifyOnProfileMarkedForPermanentDeletion(profile);
+  DisableSyncForProfileDeletion(profile);
+  explicit_deletion_->observation.Observe(profile->GetBrowsingDataRemover());
+  explicit_deletion_->wipe_done = base::BindOnce(
+      &DeleteProfileHelper::ExplicitWipeDone, weak_factory_.GetWeakPtr());
+  profile->Wipe(explicit_deletion_.get());
+}
+
+void DeleteProfileHelper::ExplicitWipeDone(uint64_t failed_data_types) {
+  if (!explicit_deletion_ || explicit_deletion_->phase != ExplicitDeletion::Phase::kRunning) { return; }
+  if (failed_data_types) {
+    FinishExplicitDeletion(ExplicitDeletionResult::kPending);
+    return;
+  }
+  // Extension worker/frame untracking closes MessageService channels on UI;
+  // native-port dispatchers release pipes on IO. Await that posted disposal,
+  // without waiting on or polling unrelated ThreadPool child-process reaping.
+  content::GetIOThreadTaskRunner({})->PostTaskAndReply(
+      FROM_HERE, base::DoNothing(),
+      base::BindOnce(&DeleteProfileHelper::ExplicitPortsReleased,
+                     weak_factory_.GetWeakPtr()));
+}
+
+void DeleteProfileHelper::ExplicitPortsReleased() {
+  if (!explicit_deletion_ || explicit_deletion_->phase != ExplicitDeletion::Phase::kRunning) { return; }
+  auto* profile = profile_manager_->GetProfileByPath(explicit_deletion_->target);
+  if (!profile) {
+    FinishExplicitDeletion(ExplicitDeletionResult::kPending);
+    return;
+  }
+  profile->GetPrefs()->OnStoreDeletionFromDisk();
+  auto& storage = profile_manager_->GetProfileAttributesStorage();
+  if (storage.GetProfileAttributesWithPath(profile->GetPath())) {
+    storage.RemoveProfile(profile->GetPath());
+  }
+  if (base::FeatureList::IsEnabled(features::kDestroyProfileOnBrowserClose)) {
+    profile_manager_->ClearFirstBrowserWindowKeepAlive(profile);
+  }
+  // Wipe has finished; actual directory removal follows Chromium's existing
+  // marked-profile restart cleanup (not a claim of immediate disk erasure).
+  FinishExplicitDeletion(ExplicitDeletionResult::kDeleted);
+}
+
+bool DeleteProfileHelper::ShouldPreserveSessionDataForExplicitDeletion(
+    const base::FilePath& profile_dir) const {
+  return explicit_deletion_ && explicit_deletion_->target == profile_dir &&
+         !explicit_deletion_->marked;
+}
+
+void DeleteProfileHelper::FinishExplicitDeletion(ExplicitDeletionResult result) {
+  auto callback = std::move(explicit_deletion_->callback);
+  if (result == ExplicitDeletionResult::kDeleted) {
+    explicit_deletion_.reset();
+  } else if (result == ExplicitDeletionResult::kCloseAdmitted) {
+    // No mark, download cancellation or data wipe has occurred. Retain the
+    // exact live contexts until the caller durably commits its model assignment.
+    explicit_deletion_->phase = ExplicitDeletion::Phase::kAwaitingAssignmentCommit;
+  } else {
+    explicit_deletion_->phase = result == ExplicitDeletionResult::kCancelled
+        ? ExplicitDeletion::Phase::kAwaitingCancellationCommit
+        : ExplicitDeletion::Phase::kAwaitingRetry;
+    explicit_deletion_->observation.Reset();
+    explicit_deletion_->wipe_done.Reset();
+    explicit_deletion_->target_keep_alive.reset();
+    explicit_deletion_->survivor_keep_alive.reset();
+    explicit_deletion_->process_keep_alive.reset();
+  }
+  std::move(callback).Run(result);
+}
+
+bool DeleteProfileHelper::AcknowledgeExplicitDeletionCancellation(
+    const base::FilePath& profile_dir, const base::FilePath& survivor_dir) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!explicit_deletion_) {
+    return !IsProfileDirectoryPendingDeletion(profile_dir);
+  }
+  if (explicit_deletion_->phase != ExplicitDeletion::Phase::kAwaitingCancellationCommit ||
+      explicit_deletion_->target != profile_dir || explicit_deletion_->survivor != survivor_dir ||
+      explicit_deletion_->marked || WasMarkedForDeletion(profile_dir)) { return false; }
+  CancelProfileDeletion(profile_dir);
+  explicit_deletion_.reset();
+  return true;
+}
+
+void DeleteProfileHelper::ContinueExplicitDeletion(
+    const base::FilePath& profile_dir, const base::FilePath& survivor_dir,
+    ExplicitDeletionCallback callback) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  if (!explicit_deletion_ ||
+      explicit_deletion_->phase != ExplicitDeletion::Phase::kAwaitingAssignmentCommit ||
+      explicit_deletion_->target != profile_dir || explicit_deletion_->survivor != survivor_dir) {
+    std::move(callback).Run(ExplicitDeletionResult::kPending);
+    return;
+  }
+  explicit_deletion_->callback = std::move(callback);
+  explicit_deletion_->phase = ExplicitDeletion::Phase::kRunning;
+  explicit_deletion_->defer_wipe = false;
+  ExplicitProfileLoaded(profile_manager_->GetProfileByPath(profile_dir));
+}
