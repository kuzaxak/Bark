+void DeleteProfileHelper::Shutdown() {
+  weak_factory_.InvalidateWeakPtrs();
+  if (!explicit_deletion_) { return; }
+  auto request = std::move(explicit_deletion_);
+  auto callback = std::move(request->callback);
+  request.reset();
+  if (callback) { std::move(callback).Run(ExplicitDeletionResult::kPending); }
+}
 
