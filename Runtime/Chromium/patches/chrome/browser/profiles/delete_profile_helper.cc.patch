+// One bounded request owned by the existing deletion authority. No independent
+// profile registry: ProfileManager and ProfilesToDelete remain authoritative.
+struct DeleteProfileHelper::ExplicitDeletion
+    : content::BrowsingDataRemover::Observer {
+  ExplicitDeletion(base::FilePath target, base::FilePath survivor,
+                   ExplicitDeletionCallback callback)
+      : target(std::move(target)), survivor(std::move(survivor)),
+        callback(std::move(callback)) {}
+  ~ExplicitDeletion() override {
+    observation.Reset();
+    if (callback) {
+      std::move(callback).Run(marked ? ExplicitDeletionResult::kPending
+                                    : ExplicitDeletionResult::kCancelled);
+    }
+  }
+  void OnBrowsingDataRemoverDone(uint64_t failed_data_types) override {
+    observation.Reset();
+    // Do not release the last Profile keepalive in the remover's observer loop.
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(std::move(wipe_done), failed_data_types));
+  }
+  base::FilePath target;
+  base::FilePath survivor;
+  enum class Phase { kRunning, kAwaitingRetry, kAwaitingCancellationCommit,
+                     kAwaitingAssignmentCommit };
+  Phase phase = Phase::kRunning;
+  bool marked = false;
+  bool reconcile_only = false;
+  bool disk_cleanup_started = false;
+  bool loaded_survivor_for_request = false;
+  bool defer_wipe = false;
+  ExplicitDeletionCallback callback;
+  base::OnceCallback<void(uint64_t)> wipe_done;
+  std::unique_ptr<ScopedKeepAlive> process_keep_alive;
+  std::unique_ptr<ScopedProfileKeepAlive> target_keep_alive;
+  std::unique_ptr<ScopedProfileKeepAlive> survivor_keep_alive;
+  base::ScopedObservation<content::BrowsingDataRemover,
+                          content::BrowsingDataRemover::Observer> observation{this};
+};
