+#if BUILDFLAG(IS_MAC)
+void ProfileManager::CreatePrivateSessionAsync(
+    base::OnceCallback<void(Profile*)> callback) {
+  DCHECK_CURRENTLY_ON(BrowserThread::UI);
+  if (!callback) {
+    return;
+  }
+  const base::FilePath path = user_data_dir_.AppendASCII(
+      "BarcPrivate-" + base::Uuid::GenerateRandomV4().AsLowercaseString());
+  ProfileAttributesInitParams attributes;
+  attributes.profile_path = path;
+  attributes.profile_name = u"Private";
+  attributes.is_ephemeral = true;
+  attributes.is_omitted = true;
+  GetProfileAttributesStorage().AddProfile(std::move(attributes));
+  CreateProfileAsync(
+      path, base::BindOnce(
+                [](base::WeakPtr<ProfileManager> manager,
+                   base::FilePath path,
+                   base::OnceCallback<void(Profile*)> callback,
+                   Profile* profile) {
+                  if (!manager) {
+                    std::move(callback).Run(nullptr);
+                    return;
+                  }
+                  if (!profile) {
+                    // Retain existing persistent deletion evidence even when
+                    // late profile IO races the best-effort disk deletion.
+                    if (!IsProfileDirectoryMarkedForDeletion(path)) {
+                      MarkProfileDirectoryForDeletion(path);
+                    }
+                    manager->GetProfileAttributesStorage().RemoveProfile(path);
+                    base::ThreadPool::PostTask(
+                        FROM_HERE,
+                        {base::MayBlock(), base::TaskPriority::BEST_EFFORT,
+                         base::TaskShutdownBehavior::SKIP_ON_SHUTDOWN},
+                        base::BindOnce(&NukeProfileFromDisk, path,
+                                       base::OnceClosure()));
+                    std::move(callback).Run(nullptr);
+                    return;
+                  }
+                  CHECK(profile->IsGuestSession());
+                  CHECK(profile->IsPrimaryOTRProfile());
+                  CHECK_EQ(path, profile->GetPath());
+                  auto alive = profile->GetWeakPtr();
+                  // Release the initial never-opened-browser keepalive while
+                  // retaining the parent across the synchronous handoff. OTR
+                  // itself also owns a parent keepalive until its destruction.
+                  auto keep_alive = ScopedProfileKeepAlive::TryAcquire(
+                      profile->GetOriginalProfile(),
+                      ProfileKeepAliveOrigin::kProfileCreationFlow);
+                  if (!keep_alive) {
+                    std::move(callback).Run(nullptr);
+                    if (alive) {
+                      ProfileDestroyer::DestroyOTRProfileWhenAppropriate(
+                          alive.get());
+                    }
+                    return;
+                  }
+                  std::move(callback).Run(profile);
+                  if (!manager || !alive || !g_browser_process ||
+                      g_browser_process->IsShuttingDown()) {
+                    return;
+                  }
+                  // A failed/canceled native-window admission must not leave a
+                  // no-window session. Recheck after every caller callback.
+                  bool has_browser = false;
+                  ForEachCurrentBrowserWindowInterfaceOrderedByActivation(
+                      [&alive, &has_browser](BrowserWindowInterface* browser) {
+                        if (browser->GetProfile() == alive.get()) {
+                          has_browser = true;
+                        }
+                        return !has_browser;
+                      });
+                  if (!has_browser) {
+                    ProfileDestroyer::DestroyOTRProfileWhenAppropriate(
+                        alive.get());
+                  }
+                },
+                weak_factory_.GetWeakPtr(), path, std::move(callback)));
+}
+#endif  // BUILDFLAG(IS_MAC)
