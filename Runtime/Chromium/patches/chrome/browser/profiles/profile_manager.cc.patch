+// static
+bool ProfileManager::IsPrivateSessionProfilePath(const base::FilePath& path) {
+#if BUILDFLAG(IS_MAC)
+  constexpr char kPrefix[] = "BarcPrivate-";
+  auto* manager = g_browser_process ? g_browser_process->profile_manager()
+                                    : nullptr;
+  if (!manager || path.DirName() != manager->user_data_dir()) {
+    return false;
+  }
+  const std::string name = path.BaseName().AsUTF8Unsafe();
+  if (!base::StartsWith(name, kPrefix)) {
+    return false;
+  }
+  const std::string suffix = name.substr(sizeof(kPrefix) - 1);
+  const auto uuid = base::Uuid::ParseLowercase(suffix);
+  return uuid.is_valid() && uuid.AsLowercaseString() == suffix &&
+         suffix != "00000000-0000-0000-0000-000000000000";
+#else
+  return false;
+#endif
+}
