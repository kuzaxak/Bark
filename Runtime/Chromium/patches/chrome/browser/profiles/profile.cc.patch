+void Profile::Wipe(content::BrowsingDataRemover::Observer* observer) {
+  CHECK(observer);
+  GetBrowsingDataRemover()->RemoveAndReply(
+      base::Time(), base::Time::Max(),
+      chrome_browsing_data_remover::WIPE_PROFILE,
+      chrome_browsing_data_remover::ALL_ORIGIN_TYPES, observer);
+}
