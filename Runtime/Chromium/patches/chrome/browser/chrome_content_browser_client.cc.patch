+void ChromeContentBrowserClient::CheckWebSocketConnection(
+    content::BrowserContext* browser_context, content::RenderFrameHost* frame,
+    const GURL& url, const url::Origin& initiator,
+    base::OnceCallback<void(int)> callback) {
+#if BUILDFLAG(IS_MAC)
+  const GURL source = initiator.GetURL();
+  const GURL document_site = frame ? frame->GetLastCommittedURL() : GURL();
+  // Match website-request scope; browser UI and extension background traffic
+  // retain upstream handling and extension filtering.
+  if (!NativeContentBlocker::RequiresInterception() ||
+      source.SchemeIs("chrome-extension") || document_site.SchemeIs("chrome-extension") ||
+      content::HasWebUIScheme(source) || content::HasWebUIScheme(document_site) ||
+      source.SchemeIs(content::kChromeDevToolsScheme) ||
+      document_site.SchemeIs(content::kChromeDevToolsScheme)) {
+    std::move(callback).Run(net::OK);
+    return;
+  }
+  auto* profile = Profile::FromBrowserContext(browser_context);
+  if (profile->ShutdownStarted()) {
+    std::move(callback).Run(net::ERR_ABORTED);
+    return;
+  }
+  auto* blocker = NativeContentBlocker::Get(profile, true);
+  auto client = NativeContentBlocker::CaptureClient(
+      frame ? content::WebContents::FromRenderFrameHost(frame) : nullptr,
+      frame, document_site.is_empty() ? source : document_site);
+  blocker->Check(url, initiator.GetURL(), std::move(client), "websocket", "GET",
+                 std::move(callback));
+#else
+  std::move(callback).Run(net::OK);
+#endif
+}
