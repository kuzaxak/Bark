+                                  profile_) &&
+                             !browser_owner()->IsDeleteScheduled() &&
+                             !UnloadController::From(browser_owner())
+                                  ->is_attempting_to_close_browser() &&
+                             browser_owner()->IsSelectedForNativeWindow());
