+
+bool ExtensionInstallPromptShowParams::CanShowForBrowserOwner() {
+  if (!browser_owner_)
+    return true;
+  if (WasParentDestroyed())
+    return false;
+  auto* owner = GetBrowserOwner();
+  return owner->IsSelectedForNativeWindow() &&
+         (owner->GetProfile() == profile_.get() ||
+          (!parent_tab_ &&
+           owner->GetProfile()->GetOriginalProfile() == profile_.get()));
+}
