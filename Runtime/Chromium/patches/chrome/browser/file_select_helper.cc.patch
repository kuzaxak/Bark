+std::vector<std::shared_ptr<const FileSelectHelper::UploadChooserState>>
+FileSelectHelper::GetLiveUploadChoosers(content::WebContents* contents) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  std::vector<std::shared_ptr<const UploadChooserState>> active;
+  for (auto* chooser : LiveUploadChoosers()) {
+    if (chooser->web_contents_ == contents && chooser->listener_) {
+      chooser->upload_chooser_state_->native_panel_is_running =
+          chooser->select_file_dialog_ &&
+          chooser->select_file_dialog_->IsRunning(
+              platform_util::GetTopLevel(contents->GetNativeView()));
+      active.push_back(chooser->upload_chooser_state_);
+    }
+  }
+  return active;
+}
