+bool FileSelectHelper::HasSelectedNativeOwner() const {
+#if !BUILDFLAG(IS_ANDROID)
+  if (web_contents_) {
+    if (auto* tab = tabs::TabInterface::MaybeGetFromContents(web_contents_)) {
+      auto* owner = tab->GetBrowserWindowInterface();
+      return owner && !owner->IsDeleteScheduled() &&
+             owner->IsSelectedForNativeWindow() &&
+             !bark::IsNativeSpacePageSuppressed(owner);
+    }
+  }
+#endif
+  return true;
+}
