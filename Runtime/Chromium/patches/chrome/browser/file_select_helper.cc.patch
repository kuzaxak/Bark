diff --git a/chrome/browser/file_select_helper.cc b/chrome/browser/file_select_helper.cc
index 227ace4086..034e85c961 100644
--- a/chrome/browser/file_select_helper.cc
+++ b/chrome/browser/file_select_helper.cc
@@ -26,6 +26,7 @@
 #include "chrome/browser/platform_util.h"
 #include "chrome/browser/profiles/profile.h"
 #include "chrome/browser/profiles/profile_manager.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
 #include "chrome/browser/ui/dialogs/browser_dialogs.h"
 #include "chrome/browser/ui/select_file_policy/chrome_select_file_policy.h"
 #include "chrome/grit/generated_resources.h"
@@ -626,6 +627,10 @@ void FileSelectHelper::RunFileChooser(
   web_contents_ = WebContents::FromRenderFrameHost(render_frame_host);
   listener_ = std::move(listener);
   InitLifecycleObserver(web_contents_);
+  if (!HasSelectedNativeOwner()) {
+    RunFileChooserEnd();
+    return;
+  }
 
 #if !BUILDFLAG(IS_ANDROID)
   if (PictureInPictureWindowManager::GetInstance()
@@ -699,7 +704,7 @@ void FileSelectHelper::RunFileChooserOnUIThread(
   // page sees this as a `cancel` event on the input.
   tabs::TabInterface* tab =
       tabs::TabInterface::MaybeGetFromContents(web_contents_);
-  if (tab && !tab->IsActivated()) {
+  if ((tab && !tab->IsActivated()) || !HasSelectedNativeOwner()) {
     RunFileChooserEnd();
     return;
   }
@@ -770,6 +775,9 @@ void FileSelectHelper::RunFileChooserEnd() {
 #endif  // !BUILDFLAG(IS_ANDROID)
 
   tab_deactivated_subscription_ = {};
+  tab_detached_subscription_ = {};
+  tab_discarded_subscription_ = {};
+  native_window_selection_changed_subscription_ = {};
   directory_enumeration_.reset();
 
   // If there are temporary files, then this instance needs to stick around
@@ -866,6 +874,47 @@ void FileSelectHelper::InitLifecycleObserver(
     tab_deactivated_subscription_ =
         tab_interface->RegisterWillDeactivate(base::BindRepeating(
             &FileSelectHelper::OnTabDeactivated, base::Unretained(this)));
+    // The request belongs to this document in this tab owner. A background tab
+    // can move without deactivating, and discarded contents can remain alive.
+    tab_detached_subscription_ = tab_interface->RegisterWillDetach(
+        base::BindRepeating(
+            [](FileSelectHelper* self, tabs::TabInterface*,
+               tabs::TabInterface::DetachReason) { self->RunFileChooserEnd(); },
+            base::Unretained(this)));
+    tab_discarded_subscription_ = tab_interface->RegisterWillDiscardContents(
+        base::BindRepeating(
+            [](FileSelectHelper* self, tabs::TabInterface*,
+               content::WebContents*, content::WebContents*) {
+              self->RunFileChooserEnd();
+            },
+            base::Unretained(this)));
+#if !BUILDFLAG(IS_ANDROID)
+    if (auto* owner = tab_interface->GetBrowserWindowInterface()) {
+      native_window_selection_changed_subscription_ =
+          owner->RegisterNativeWindowSelectionChanged(base::BindRepeating(
+              &FileSelectHelper::OnNativeWindowSelectionChanged,
+              base::Unretained(this)));
+    }
+#endif
+  }
+}
+
+bool FileSelectHelper::HasSelectedNativeOwner() const {
+#if !BUILDFLAG(IS_ANDROID)
+  if (web_contents_) {
+    if (auto* tab = tabs::TabInterface::MaybeGetFromContents(web_contents_)) {
+      auto* owner = tab->GetBrowserWindowInterface();
+      return owner && !owner->IsDeleteScheduled() &&
+             owner->IsSelectedForNativeWindow();
+    }
+  }
+#endif
+  return true;
+}
+
+void FileSelectHelper::OnNativeWindowSelectionChanged() {
+  if (!HasSelectedNativeOwner()) {
+    RunFileChooserEnd();
   }
 }
 
