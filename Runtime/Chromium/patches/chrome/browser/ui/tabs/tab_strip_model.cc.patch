+void TabStripModel::UpdateSplitDividers(
+    split_tabs::SplitTabId split_id,
+    base::span<const double> split_dividers,
+    bool is_intermediate) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  auto* split_data = GetSplitData(split_id);
+  CHECK_EQ(split_dividers.size() + 1, split_data->ListTabs().size());
+  auto old_visual_data = *split_data->visual_data();
+  split_data->visual_data()->set_split_dividers(split_dividers);
+  // A final drag notification commits the last intermediate geometry even
+  // when the pointer has not moved since the preceding intermediate update.
+  if (old_visual_data == *split_data->visual_data() && is_intermediate) {
+    return;
+  }
+  NotifySplitTabVisualsChanged(
+      split_id, old_visual_data, *split_data->visual_data(),
+      SplitTabChange::SplitVisualChangeReason::kRatioUpdated, is_intermediate);
+}
