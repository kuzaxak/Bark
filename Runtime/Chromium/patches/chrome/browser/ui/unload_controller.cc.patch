+bool UnloadController::AcquireNativeWindowGroupClose(
+    base::OnceClosure on_preempted) {
+  CHECK(on_preempted);
+  if (is_delete_scheduled_ || state_ != State::kIdle ||
+      before_unload_purpose_.has_value() || native_window_group_preempted_ ||
+      !on_close_confirmed_.is_null() || warn_before_closing_callback_ ||
+      cancel_download_confirmation_state_ ==
+          CancelDownloadConfirmationState::kWaitingForResponse) {
+    return false;
+  }
+  cancel_download_confirmation_state_ =
+      CancelDownloadConfirmationState::kNotPrompted;
+  native_window_group_preempted_ = std::move(on_preempted);
+  return true;
+}
+
+void UnloadController::CancelNativeWindowGroupClose() {
+  if (!native_window_group_preempted_) {
+    return;
+  }
+  native_window_group_preempted_.Reset();
+  // An old modal may finish after local cancellation or ownership handoff.
+  // Its response must not alter the replacement owner's download state.
+  ++close_warning_generation_;
+  warn_before_closing_callback_.Reset();
+  auto alive = GetWeakPtr();
+  ResetBeforeUnloadForShutdown();
+  if (!alive) {
+    return;
+  }
+  if (auto* window = BrowserWindow::FromBrowser(browser_)) {
+    window->CancelPendingDownloadWarning();
+  }
+}
+
+void UnloadController::CommitNativeWindowGroupClose() {
+  native_window_group_preempted_.Reset();
+}
