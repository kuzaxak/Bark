+NSMenuItem* ItemWithTag(NSMenu* menu, NSInteger tag) {
+  for (NSMenuItem* item in menu.itemArray) {
+    if (item.submenu) {
+      if (NSMenuItem* found = ItemWithTag(item.submenu, tag)) {
+        return found;
+      }
+    } else if (item.tag == tag) {
+      return item;
+    }
+  }
+  return nil;
+}
+
+// The app routes some of Chromium's main menu items to its own actions; the
+// rest still send commandDispatch: to Chromium. A key the app owns reaches the
+// app's item through the menu when the item holds the key, else directly.
+ui::PerformKeyEquivalentResult GiveKeyToApp(NSEvent* event, int command) {
+  auto answers = [](NSMenuItem* item) {
+    return item && item.action != @selector(commandDispatch:) &&
+           item.action != @selector(commandDispatchUsingKeyModifiers:);
+  };
+  NSMenu* menu = [NSApp mainMenu];
+  if (NSMenuItem* item = [menu cr_menuItemForKeyEquivalentEvent:event]) {
+    return answers(item) ? ui::PerformKeyEquivalentResult::kPassToMainMenu
+                         : ui::PerformKeyEquivalentResult::kHandled;
+  }
+  NSMenuItem* item = ItemWithTag(menu, command);
+  if (answers(item) && item.enabled) {
+    [NSApp sendAction:item.action to:item.target from:item];
+  }
+  return ui::PerformKeyEquivalentResult::kHandled;
+}
+
