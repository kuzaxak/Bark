+bool CanPresentForBrowserOwner(
+    const std::optional<base::WeakPtr<BrowserWindowInterface>>& owner,
+    Profile* profile,
+    content::WebContents* contents) {
+  if (!owner)
+    return true;
+  auto* browser = owner->get();
+  if (!browser || browser->IsDeleteScheduled() ||
+      !browser->IsSelectedForNativeWindow() || !browser->GetWindow() ||
+      browser->GetProfile() != profile)
+    return false;
+  return browser->GetWindow()->GetNativeWindow() &&
+         (!contents ||
+          GlobalBrowserCollection::GetInstance()->FindBrowserWithTab(
+              contents) == browser);
+}
+#endif
