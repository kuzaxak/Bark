+void BrowserLiveTabContext::ReconstructSplitTabs(
+    base::span<sessions::LiveTab* const> tabs,
+    split_tabs::SplitTabId split_id,
+    const split_tabs::SplitTabVisualData& visual_data) {
+  if (tabs.size() < 2 || tabs.size() > split_tabs::SplitTabVisualData::kMaxPanes ||
+      visual_data.pane_count() != tabs.size()) {
+    return;
   }
+  std::vector<int> indices;
+  for (auto* tab : tabs) {
+    if (!tab) {
+      return;
+    }
+    auto* content_tab = static_cast<sessions::ContentLiveTab*>(tab);
+    const int index = tab_strip_model_->GetIndexOfWebContents(
+        &content_tab->GetWebContents());
+    if (index == TabStripModel::kNoTab || std::ranges::contains(indices, index)) {
+      return;
+    }
+    indices.push_back(index);
+  }
+  tab_strip_model_->RestoreSplit(split_id, indices, visual_data);
 }
 
