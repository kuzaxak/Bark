+    window_.reset();
+    features_.reset();
+    return;
+  }
   if (!IsDeleteScheduled()) {
     // Guarantee the Browser has performed the necessary cleanup in the
     // `OnWindowClosing()` lifecycle hook. This may not be invoked during
@@ -359,6 +383,12 @@ Browser::~Browser() {
