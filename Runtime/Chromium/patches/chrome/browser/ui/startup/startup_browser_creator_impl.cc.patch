+bool StartupBrowserCreatorImpl::CanOpenURL(Profile* profile, const GURL& url,
+    chrome::startup::IsProcessStartup process_startup) {
+  if (!profile) return false;
+  auto* registry = ProtocolHandlerRegistryFactory::GetForBrowserContext(profile);
+  return process_startup == chrome::startup::IsProcessStartup::kYes ||
+      IsStartupURLHandled(url, registry);
+}
