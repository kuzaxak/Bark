+// Bark can prompt only for the foreground tab its host already presents.
+bool CanPresentInstallPrompt(ExtensionInstallPromptShowParams& params) {
+  if (params.WasParentDestroyed() || !params.CanShowForBrowserOwner())
+    return false;
+  auto* owner = params.GetBrowserOwner();
+  auto* contents = params.GetParentWebContents();
+  if (!owner || BrowserView::GetBrowserViewForBrowser(owner))
+    return true;
+  if (owner->GetProfile()->IsOffTheRecord())
+    return false;
+  return !contents ||
+         (owner->GetTabStripModel()->GetActiveWebContents() == contents &&
+          contents->GetVisibility() == content::Visibility::VISIBLE &&
+          contents->GetTopLevelNativeWindow() == params.GetParentWindow());
+}
+
+void AbortInstallPrompt(ExtensionInstallPrompt::DoneCallback done_callback) {
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE,
+      base::BindOnce(std::move(done_callback),
+                     ExtensionInstallPrompt::DoneCallbackPayload(
+                         ExtensionInstallPrompt::Result::ABORTED)));
+}
