+void MultiContentsViewDelegateImpl::ResizeDividers(
+    base::span<const double> dividers,
+    bool done_resizing) {
+  const auto split_id = tab_strip_model_->GetActiveTab()->GetSplit();
+  CHECK(split_id);
+  auto owner = browser_->GetWeakPtr();
+  tab_strip_model_->UpdateSplitDividers(*split_id, dividers, !done_resizing);
+  // Split observers may close the owner or replace its current split.
+  if (!owner || owner->IsDeleteScheduled())
+    return;
+  auto* strip = owner->GetTabStripModel();
+  auto* active = strip->GetActiveTab();
+  if (!done_resizing || !active || active->GetSplit() != split_id ||
+      !strip->ContainsSplit(*split_id)) {
+    return;
+  }
+  if (auto* service = SessionServiceFactory::GetForProfile(owner->GetProfile())) {
+    service->SetSplitTabData(owner->GetSessionID(), *split_id,
+                            strip->GetSplitData(*split_id)->visual_data());
   }
