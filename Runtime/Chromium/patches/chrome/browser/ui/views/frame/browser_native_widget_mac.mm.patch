+bool BrowserNativeWidgetMac::CanSelectBrowserView() {
+  auto* host = GetNSWindowHost();
+  return host && !host->target_fullscreen_state() &&
+         !host->in_fullscreen_transition() && !GetRemoteCocoaApplicationHost();
+}
+
+void BrowserNativeWidgetMac::SelectBrowserView(BrowserView* browser_view) {
+  CHECK(browser_view);
+  CHECK_EQ(browser_view->browser()->GetType(),
+           BrowserWindowInterface::Type::TYPE_NORMAL);
+  // Remote PWA application hosts own a different native lifetime. They are not
+  // eligible for the normal-profile shared-window path.
+  CHECK(!GetRemoteCocoaApplicationHost());
+  CHECK_EQ(browser_view->GetWidget(), GetWidget());
+  vertical_tab_subscription_ = {};
+  vertical_tab_collapse_subscription_ = {};
+  vertical_tab_resizing_subscription_ = {};
+  glass_frame_service_subscription_ = {};
+  browser_view_ = browser_view;
+  CHECK(!GetRemoteCocoaApplicationHost());
+  last_theme_color_.reset();
+  last_is_vertical_tabs_.reset();
+  auto* ns_window = base::apple::ObjCCastStrict<NativeWidgetMacNSWindow>(
+      GetWidget()->GetNativeWindow().GetNativeNSWindow());
+  touch_bar_delegate_ = [[BrowserWindowTouchBarViewsDelegate alloc]
+      initWithBrowser:browser_view_->browser()
+               window:ns_window];
+  [ns_window setWindowTouchBarDelegate:touch_bar_delegate_];
+  [ns_window setTouchBar:nil];
+  BindSelectedBrowserSubscriptions();
+  UpdateBackgroundGeometry();
+  UpdateBackgroundColor();
 }
 
