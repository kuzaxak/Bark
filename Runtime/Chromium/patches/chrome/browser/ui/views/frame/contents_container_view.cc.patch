+void ContentsContainerView::DestroyOwnerBoundChildrenForRetirement() {
+  CHECK(!owner_retired_);
+  owner_retired_ = true;
+  // Preserve the normal ReadAnything-before-ContentsWebView destruction order.
+  // Modal observers are notified while the original owner is still valid.
+  web_contents_modal_dialog_host_.reset();
+  view_bounds_observer_.Reset();
+  SetLayoutManager(nullptr);
+  if (read_anything_immersive_overlay_view_) {
