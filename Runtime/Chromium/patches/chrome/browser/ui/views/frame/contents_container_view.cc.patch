+  glic_selection_overlay_view_ = nullptr;
+  glic_border_ = nullptr;
+  mini_toolbar_ = nullptr;
+  container_outline_ = nullptr;
+  capture_contents_border_view_ = nullptr;
+  indigo_overlay_view_ = nullptr;
