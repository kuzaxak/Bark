+// Unload, pagehide and visibilitychange listeners run at close without a
+// dialog; only a beforeunload listener can ask the person to stay.
+bool MayPromptBeforeUnload(BrowserWindowInterface* browser,
+                           base::span<content::WebContents* const> only_tabs) {
+  auto* strip = browser->GetTabStripModel();
+  for (int i = 0; i < strip->count(); ++i) {
+    auto* contents = strip->GetWebContentsAt(i);
+    if (!only_tabs.empty() && !std::ranges::contains(only_tabs, contents)) continue;
+    if (DevToolsWindow::NeedsToInterceptBeforeUnload(contents)) return true;
+    bool listening = false;
+    contents->GetPrimaryMainFrame()->ForEachRenderFrameHost(
+        [&listening](content::RenderFrameHost* frame) {
+          listening |= frame->IsRenderFrameLive() &&
+              frame->GetSuddenTerminationDisablerState(
+                  blink::mojom::SuddenTerminationDisablerType::kBeforeUnloadHandler);
+        });
+    if (listening) return true;
+  }
+  return false;
+}
