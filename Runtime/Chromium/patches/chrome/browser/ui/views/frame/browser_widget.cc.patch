+#endif
+  if (barc_presented_contents_ && !HasBarcPresentedContents(view)) {
+    auto host_alive = GetWeakPtr();
+    auto incoming_alive = view->GetAsWeakPtr();
+    const uint64_t before = barc_selection_epoch_;
+    ClearBarcPresentedTabs();
+    if (!host_alive || !incoming_alive || before != barc_selection_epoch_) {
+      return false;
+    }
+  }
+  if (!closing_current) {
+    for (auto* contents_view : browser_view_->GetAllVisibleContentsWebViews()) {
+      if (auto* bubble = contents_view->GetStatusBubble()) {
+        bubble->Hide();
+      }
+    }
+  }
+  selecting_logical_view_ = true;
+  auto alive = GetWeakPtr();
+  BrowserView* previous = browser_view_;
+  auto previous_alive = previous->weak_ptr_factory_.GetWeakPtr();
+  auto incoming_alive = view->weak_ptr_factory_.GetWeakPtr();
+  auto intact = [&] {
+    if (alive && previous_alive && incoming_alive) {
+      return true;
+    }
+    if (alive) {
+      selecting_logical_view_ = false;
+    }
+    return false;
+  };
+  if (auto* contents = previous->GetActiveWebContents()) {
+    contents->StoreFocus();
+    if (!intact()) {
+      return false;
+    }
+  }
+  previous->OnWidgetActivationChanged(this, false);
+  if (!intact()) {
+    return false;
+  }
+  previous->OnWidgetVisibilityChanged(this, false);
+  if (!intact()) {
+    return false;
+  }
+  // Hide the outgoing protected subtree before incoming policy can relax
+  // screenshots. SelectClientFrame accepts an already-hidden outgoing frame.
+  previous->GetFrameView()->SetVisible(false);
+  if (!intact()) {
+    return false;
+  }
+  menu_runner_.reset();
+  if (!intact()) {
+    return false;
+  }
+  menu_model_builder_.reset();
+  if (!intact()) {
+    return false;
+  }
+  browser_view_ = view;
+  ++barc_selection_epoch_;
+#if BUILDFLAG(IS_MAC)
+  barc::BrowserDiscoveryChanged();
+#endif
+  browser_frame_view_ = view->GetFrameView();
+  SelectClientDelegate(view);
+  SetNativeWindowProperty(BrowserView::kBrowserViewKey, view);
+  SetNativeWindowProperty(Profile::kProfileKey, view->GetProfile());
+  root_view_->SelectBrowserView(view);
+  if (!intact()) {
+    return false;
+  }
+  browser_native_widget_->SelectBrowserView(view);
+  if (!intact()) {
+    return false;
+  }
+  previous->PaintAsActiveChanged();
+  if (!intact()) {
+    return false;
+  }
+#if BUILDFLAG(ENTERPRISE_SCREENSHOT_PROTECTION)
+  // The incoming logical owner is selected, but its frame is still hidden.
+  // Recompute from the real per-tab policy, including both split panes, before
+  // visibility callbacks can expose it under the outgoing profile's policy.
+  auto* data_protection =
+      enterprise_data_protection::DataProtectionUIController::From(
+          view->browser());
+  CHECK(data_protection);
+  data_protection->MaybeUpdateScreenshotSettings();
+  if (!intact()) {
+    return false;
+  }
+#endif
+  const bool selected = non_client_view()->SelectClientFrame(view);
+  if (!intact()) {
+    return false;
+  }
+  CHECK(selected);  // Membership was verified before the selection transaction.
+  if (closing_current) {
+    // Keep the incoming local shortcut state coherent, but defer claiming
+    // native activation/focus until the outgoing profile's prompt anchors are
+    // gone.
+    view->OnWidgetActivationChanged(this, false);
+    if (!intact()) {
+      return false;
+    }
+    selecting_logical_view_ = false;
+    previous->browser()->NotifyNativeWindowSelectionChanged();
+    // Incoming consumers are notified after RemoveLogicalBrowserView tears down
+    // outgoing prompt anchors and completes the deferred selected refresh.
+    // The closing-owner handoff completed. A callback may select a different
+    // surviving client; do not turn that supersession into a failed close.
+    return alive && incoming_alive;
+  }
+  const bool refreshed = RefreshSelectedLogicalBrowserView();
+  if (alive) {
+    selecting_logical_view_ = false;
+  }
+  if (alive && previous_alive && incoming_alive) {
+    previous->browser()->NotifyNativeWindowSelectionChanged();
+  }
+  if (alive && incoming_alive) {
+    view->browser()->NotifyNativeWindowSelectionChanged();
+  }
+  return refreshed && alive && incoming_alive && browser_view_ == view;
+#else
+  return view == browser_view_;
+#endif
+}
