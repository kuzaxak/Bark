+
+void BrowserWidget::RequestLogicalClose(BrowserView* view) {
+  CHECK(view);
+  CHECK_EQ(view->browser_widget(), this);
+  if (changing_barc_presentation_ || clearing_barc_presentation_ ||
+      changing_barc_peek_ || clearing_barc_peek_) {
+    auto browser = view->browser()->GetWeakPtr();
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostNonNestableTask(
+        FROM_HERE, base::BindOnce([](base::WeakPtr<BrowserWindowInterface> browser) {
+          if (browser && !browser->IsDeleteScheduled() && browser->GetWindow()) {
+            browser->GetWindow()->Close();
+          }
+        }, browser));
+    return;
+  }
+  if (tab_drag_kind_ != TabDragKind::kNone) {
+    return;
+  }
+  if (physical_close_phase_ != PhysicalClosePhase::kCommitted &&
+      RequestLogicalPeekClose(view)) return;
+  if (HasPhysicalClosePending() && physical_close_phase_ != PhysicalClosePhase::kCommitted) {
+    CancelPhysicalClose();
+  }
+  // This real controller handles only this browser's warnings, beforeunload,
+  // session restore and tab shutdown. Never hide/close the shared Widget here.
+  auto alive = GetWeakPtr();
+  auto view_alive = view->weak_ptr_factory_.GetWeakPtr();
+  if (view->OnCloseRequested(views::Widget::ClosedReason::kUnspecified) &&
+      alive && view_alive) {
+    UnloadController::From(view->browser())->OnWindowClosing();
+  }
+}
+
+void BrowserWidget::RemoveLogicalBrowserView(BrowserView* closing) {
+  CHECK(closing);
+  auto presentation_host = GetWeakPtr();
+  auto presentation_owner = closing->GetAsWeakPtr();
+  if (HasBarcPresentedContents(closing)) {
+    ClearBarcPresentedTabs();
+    if (!presentation_host || !presentation_owner) {
+      return;
+    }
+  }
+  CHECK_EQ(closing->browser_widget(), this);
+  const bool native_gone = !browser_native_widget_;
+  auto clients = GetLogicalBrowserViews();
+  CHECK_GT(clients.size(), 1u);
+  BrowserView* survivor = nullptr;
+  for (BrowserView* candidate : clients) {
+    if (candidate != closing &&
+        (!survivor || candidate == selected_browser_view())) {
+      survivor = candidate;
+    }
+  }
+  CHECK(survivor);
+  auto alive = GetWeakPtr();
+  auto closing_alive = closing->weak_ptr_factory_.GetWeakPtr();
+  auto survivor_alive = survivor->weak_ptr_factory_.GetWeakPtr();
+  if (!native_gone && closing->ShouldSaveWindowPlacement()) {
+    gfx::Rect bounds;
+    ui::mojom::WindowShowState state;
+    GetWindowPlacement(&bounds, &state);
+    closing->SaveWindowPlacement(bounds, state);
+  }
+  if (!alive || !closing_alive || !survivor_alive) {
+    return;
+  }
+  // The accepted close callback runs while this browser's controllers live.
+  if (!native_gone) {
+    NotifyClientWillClose(closing);
+  }
+  if (!alive || !closing_alive || !survivor_alive) {
+    return;
+  }
+  if (closing->owned_browser_widget_) {
+    closing->TransferPhysicalWidgetOwnershipTo(survivor);
+  }
+  const bool was_selected = closing == selected_browser_view();
+  if (was_selected && native_gone) {
+    // Widget::OnNativeWidgetDestroyed already finalized every delegate. Do not
+    // reattach one or touch Cocoa state after the native window is gone.
+    browser_view_ = survivor;
+    browser_frame_view_ = survivor->GetFrameView();
+    root_view_->SelectBrowserView(survivor);
+    const bool selected = non_client_view()->SelectClientFrame(survivor);
+    if (!alive || !closing_alive || !survivor_alive) {
+      return;
+    }
+    CHECK(selected);
+  } else if (was_selected) {
+    const bool selected = SelectLogicalBrowserViewInternal(survivor, true);
+    if (!alive || !closing_alive || !survivor_alive) {
+      return;
+    }
+    CHECK(selected);
+  }
+  // Stop outgoing callbacks before destroying the extension/exclusive-access
+  // controllers they consult. Deactivation already happened during handoff.
+  closing->paint_as_active_subscription_ = {};
+  closing->focus_manager_observation_.Reset();
+  if (closing->widget_observation_.IsObservingSource(this)) {
+    closing->OnWidgetDestroying(this);
+  }
+  closing->browser()->GetFeatures().TearDownPreBrowserWindowDestruction();
+  if (!alive || !closing_alive || !survivor_alive) {
+    return;
+  }
+  auto released = non_client_view()->ReleaseClientFrame(closing);
+  CHECK(released);
+  if (!native_gone) {
+    FinalizeClientDelegate(closing, closing);
+  }
+  released.reset();
+  if (!alive || !survivor_alive) {
+    return;
+  }
+  if (was_selected && !native_gone && !IsPhysicalCloseCommitted()) {
+    // Own prompts/controllers are gone; refresh survivor metadata and only then
+    // restore its logical activation and focus using the normal selected path.
+    RefreshSelectedLogicalBrowserView();
+    if (alive && survivor_alive) {
+      survivor->browser()->NotifyNativeWindowSelectionChanged();
+    }
+  }
+}
+
+bool BrowserWidget::IsPhysicalCloseCommitted() const {
+  return physical_close_phase_ == PhysicalClosePhase::kCommitted &&
+      physical_close_tabs_.empty();
+}
+
+bool BrowserWidget::RequestPeekPairClose(
+    tabs::TabInterface* source, tabs::TabInterface* peek,
+    base::OnceCallback<void(bool)> on_cancelled) {
+#if BUILDFLAG(IS_MAC)
+  if (!barc::IsPeekPair(source, peek) ||
+      source->GetBrowserWindowInterface() == peek->GetBrowserWindowInterface()) {
+    // Native movement may arrive before app-model admission. Retain both exact
+    // pages until that admission clears the old intrinsic role; never close
+    // source alone or retarget its Peek in another owner/group.
+    if (barc::PeekForSource(source) != peek) return false;
+    source->GetContents()->SetClosedByUserGesture(false);
+    barc::NotifyPeekCloseCancelled(source);
+    return true;
+  }
+  // An existing pair/physical/app close retains its own continuation. A second
+  // tab-close dispatch must neither bypass it nor issue another beforeunload.
+  if (HasPhysicalClosePending() || browser_shutdown::IsTryingToQuit()) {
+    if (!browser_shutdown::IsTryingToQuit() &&
+        (!IsPhysicalCloseTarget(source) || !IsPhysicalCloseTarget(peek))) {
+      source->GetContents()->SetClosedByUserGesture(false);
+      barc::NotifyPeekCloseCancelled(source);
+    }
+    return true;
+  }
+  if (!CanAcceptLogicalBrowser()) {
+    source->GetContents()->SetClosedByUserGesture(false);
+    barc::NotifyPeekCloseCancelled(source);
+    return true;
+  }
+  auto alive = physical_close_weak_factory_.GetWeakPtr();
+  for (auto* tab : {source, peek}) {
+    auto* browser = tab->GetBrowserWindowInterface();
+    auto* view = BrowserView::GetBrowserViewForBrowser(browser);
+    if (!view || view->browser_widget() != this ||
+        !UnloadController::From(browser)->AcquireNativeWindowGroupClose(
+            base::BindOnce(&BrowserWidget::CancelPhysicalClose,
+                           physical_close_weak_factory_.GetWeakPtr()))) {
+      source->GetContents()->SetClosedByUserGesture(false);
+      if (physical_close_participants_.empty()) {
+        barc::NotifyPeekCloseCancelled(source);
+      } else {
+        CancelPhysicalClose();
+      }
+      return true;
+    }
+    physical_close_participants_.push_back(browser->GetWeakPtr());
+    physical_close_tabs_.push_back(tab->GetWeakPtr());
+  }
+  if (!alive || !barc::IsPeekPair(source, peek)) {
+    if (alive) CancelPhysicalClose();
+    return true;
+  }
+  peek_close_cancelled_ = std::move(on_cancelled);
+  physical_close_phase_ = PhysicalClosePhase::kWarnings;
+  physical_close_index_ = 0;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostNonNestableTask(
+      FROM_HERE, base::BindOnce(&BrowserWidget::ContinuePhysicalClose,
+                                physical_close_weak_factory_.GetWeakPtr()));
+  return true;
+#else
+  return false;
+#endif
+}
+
+std::vector<content::WebContents*> BrowserWidget::PhysicalCloseContentsFor(
+    BrowserWindowInterface* owner) const {
+  std::vector<content::WebContents*> result;
+  for (const auto& tab : physical_close_tabs_) {
+    if (tab && tab->GetBrowserWindowInterface() == owner) result.push_back(tab->GetContents());
+  }
+  return result;
+}
+
+bool BrowserWidget::RequestLogicalPeekClose(BrowserView* owner) {
+#if !BUILDFLAG(IS_MAC)
+  return false;
+#else
+  if (browser_shutdown::IsTryingToQuit()) return false;
+  std::vector<base::WeakPtr<tabs::TabInterface>> targets;
+  bool has_peek = false;
+  auto* model = owner->browser()->GetTabStripModel();
+  for (int i = 0; i < model->count(); ++i) {
+    auto* tab = model->GetTabAtIndex(i);
+    targets.push_back(tab->GetWeakPtr());
+    if (auto* peek = barc::PeekForSource(tab)) {
+      has_peek = true;
+      // A moved role awaits exact model admission. Closing its old source must
+      // not close a newer ordinary owner or strand the source by partial commit.
+      if (!barc::IsPeekPair(tab, peek)) {
+        barc::NotifyPeekCloseCancelled(tab);
+        return true;
+      }
+      targets.push_back(peek->GetWeakPtr());
+    }
+  }
+  if (!has_peek) return false;
+  if (HasPhysicalClosePending() || !CanAcceptLogicalBrowser()) return true;
+  auto alive = physical_close_weak_factory_.GetWeakPtr();
+  logical_peek_close_owner_ = owner->browser()->GetWeakPtr();
+  physical_close_tabs_ = std::move(targets);
+  std::vector<base::WeakPtr<BrowserWindowInterface>> owners;
+  for (const auto& tab : physical_close_tabs_) {
+    auto browser = tab->GetBrowserWindowInterface()->GetWeakPtr();
+    if (!std::ranges::any_of(owners, [&browser](const auto& prior) { return prior.get() == browser.get(); }))
+      owners.push_back(browser);
+  }
+  for (const auto& browser : owners) {
+    if (!browser || !UnloadController::From(browser.get())->AcquireNativeWindowGroupClose(
+        base::BindOnce(&BrowserWidget::CancelPhysicalClose,
+                       physical_close_weak_factory_.GetWeakPtr()))) {
+      CancelPhysicalClose();
+      return true;
+    }
+    if (!alive) return true;
+    physical_close_participants_.push_back(browser);
+  }
+  if (!ValidatePhysicalCloseParticipants()) {
+    CancelPhysicalClose();
+    return true;
+  }
+  physical_close_phase_ = PhysicalClosePhase::kWarnings;
+  physical_close_index_ = 0;
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostNonNestableTask(
+      FROM_HERE, base::BindOnce(&BrowserWidget::ContinuePhysicalClose,
+                                physical_close_weak_factory_.GetWeakPtr()));
+  return true;
+#endif
+}
+
+views::CloseRequestResult BrowserWidget::PreparePhysicalClose() {
+  if (!physical_close_tabs_.empty() &&
+      physical_close_phase_ != PhysicalClosePhase::kCommitted) {
+    CancelPhysicalClose();
+  }
+  if (physical_close_phase_ == PhysicalClosePhase::kIdle) {
+    if (browser_shutdown::IsTryingToQuit() ||
+        tab_drag_kind_ != TabDragKind::kNone) {
+      return views::CloseRequestResult::kCannotClose;
+    }
+    for (BrowserView* view : GetLogicalBrowserViews()) {
+      auto* controller = UnloadController::From(view->browser());
+      if (!controller->AcquireNativeWindowGroupClose(
+              base::BindOnce(&BrowserWidget::CancelPhysicalClose,
+                             physical_close_weak_factory_.GetWeakPtr()))) {
+        CancelPhysicalClose();
+        return views::CloseRequestResult::kCannotClose;
+      }
+      physical_close_participants_.push_back(view->browser()->GetWeakPtr());
+    }
+    physical_close_phase_ = PhysicalClosePhase::kWarnings;
+    physical_close_index_ = 0;
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+        FROM_HERE, base::BindOnce(&BrowserWidget::ContinuePhysicalClose,
+                                  physical_close_weak_factory_.GetWeakPtr()));
+  }
+  // Committed closes drain each real Browser through its existing controller;
+  // final owner destruction performs the physical native-window teardown.
+  return views::CloseRequestResult::kCannotClose;
+}
+
+bool BrowserWidget::ValidatePhysicalCloseParticipants() const {
+  const auto current = GetLogicalBrowserViews();
+  if (physical_close_tabs_.empty() && current.size() != physical_close_participants_.size()) {
+    return false;
+  }
+#if BUILDFLAG(IS_MAC)
+  if (logical_peek_close_owner_) {
+    auto* source = logical_peek_close_owner_.get();
+    const auto source_tabs = PhysicalCloseContentsFor(source);
+    if (source_tabs.size() != static_cast<size_t>(source->GetTabStripModel()->count())) return false;
+    for (const auto& tab : physical_close_tabs_) {
+      if (!tab || !tab->GetBrowserWindowInterface()) return false;
+      if (tab->GetBrowserWindowInterface() == source) {
+        auto* peek = barc::PeekForSource(tab.get());
+        if (peek && (!barc::IsPeekPair(tab.get(), peek) ||
+            !std::ranges::any_of(physical_close_tabs_, [peek](const auto& other) {
+              return other.get() == peek;
+            }))) return false;
+      } else {
+        bool linked = false;
+        for (const auto& candidate : physical_close_tabs_) {
+          linked |= candidate && candidate->GetBrowserWindowInterface() == source &&
+              barc::PeekForSource(candidate.get()) == tab.get() &&
+              barc::IsPeekPair(candidate.get(), tab.get());
+        }
+        if (!linked) return false;
+      }
+    }
+  } else if (!physical_close_tabs_.empty() &&
+      (physical_close_tabs_.size() != 2 || physical_close_participants_.size() != 2 ||
+       !barc::IsPeekPair(physical_close_tabs_[0].get(), physical_close_tabs_[1].get())))
+    return false;
+#endif
+  size_t target_index = 0;
+  for (const auto& browser : physical_close_participants_) {
+    if (!logical_peek_close_owner_ && !physical_close_tabs_.empty() &&
+        (!physical_close_tabs_[target_index] ||
+         physical_close_tabs_[target_index++]->GetBrowserWindowInterface() != browser.get()))
+      return false;
+    if (!browser || browser->IsDeleteScheduled()) {
+      return false;
+    }
+    auto* view = BrowserView::GetBrowserViewForBrowser(browser.get());
+    if (!view || view->browser_widget() != this ||
+        std::ranges::find(current, view) == current.end() ||
+        UnloadController::From(browser.get())->GetBrowserClosingStatus() ==
+            BrowserWindowInterface::ClosingStatus::kDeniedByPolicy) {
+      return false;
+    }
+  }
+  return true;
+}
+
+void BrowserWidget::CancelPhysicalClose() {
+  auto cancelled = std::move(peek_close_cancelled_);
+  physical_warning_observation_.Reset();
+  physical_close_weak_factory_.InvalidateWeakPtrs();
+  auto cancellation = physical_close_weak_factory_.GetWeakPtr();
+  const auto participants = physical_close_participants_;
+  const auto targets = physical_close_tabs_;
+  for (const auto& browser : participants) {
+    if (browser && !browser->IsDeleteScheduled()) {
+      UnloadController::From(browser.get())->CancelNativeWindowGroupClose();
+      if (!cancellation) {
+        return;
+      }
+    }
+  }
+  physical_close_participants_.clear();
+  physical_close_tabs_.clear();
+  logical_peek_close_owner_.reset();
+  physical_close_index_ = 0;
+  physical_close_waiting_ = false;
+  physical_close_phase_ = PhysicalClosePhase::kIdle;
+#if BUILDFLAG(IS_MAC)
+  barc::BrowserDiscoveryChanged();
+#endif
+  // Every participant now permits a callback-driven retry. No member group
+  // state is written after notifying consumers, which can close this host.
+  if (!targets.empty()) {
+    // Finish the old custom continuation before publishing refusal. A real
+    // transfer invalidates its original tabstrip/controller continuation.
+    if (cancelled && targets[0] && participants[0] &&
+        targets[0]->GetBrowserWindowInterface() == participants[0].get()) {
+      std::move(cancelled).Run(false);
+      if (!cancellation || physical_close_phase_ != PhysicalClosePhase::kIdle) return;
+    }
+#if BUILDFLAG(IS_MAC)
+    for (const auto& target : targets) {
+      if (target) barc::NotifyPeekCloseCancelled(target.get());
+      if (!cancellation || physical_close_phase_ != PhysicalClosePhase::kIdle) return;
+    }
+#endif
+    return;
+  }
+  for (const auto& browser : participants) {
+    if (browser && !browser->IsDeleteScheduled()) {
+      UnloadController::From(browser.get())->NotifyWindowCloseCancelled(
+          BrowserWindowInterface::ClosingStatus::kDeniedByUser);
+      if (!cancellation || physical_close_phase_ != PhysicalClosePhase::kIdle) {
+        return;
+      }
+    }
+  }
+}
+
+void BrowserWidget::ContinuePhysicalClose() {
+  if (physical_close_phase_ == PhysicalClosePhase::kIdle ||
+      physical_close_phase_ == PhysicalClosePhase::kCommitted ||
+      physical_close_waiting_) {
+    return;
+  }
+  if (!ValidatePhysicalCloseParticipants()) {
+    CancelPhysicalClose();
+    return;
+  }
+  auto alive = physical_close_weak_factory_.GetWeakPtr();
+  while (physical_close_index_ < physical_close_participants_.size()) {
+    const size_t index = physical_close_index_++;
+    auto browser = physical_close_participants_[index];
+    if (physical_close_phase_ == PhysicalClosePhase::kWarnings) {
+      bool profile_warned = false;
+      for (size_t previous = 0; previous < index; ++previous) {
+        profile_warned |=
+            physical_close_participants_[previous]->GetProfile() ==
+            browser->GetProfile();
+      }
+      if (profile_warned) {
+        continue;
+      }
+      auto* controller = UnloadController::From(browser.get());
+      // Only this synchronous call sees raw participants. Nothing is captured.
+      std::vector<BrowserWindowInterface*> group;
+      for (size_t i = 0; i < physical_close_participants_.size(); ++i) {
+        const auto& participant = physical_close_participants_[i];
+        if (physical_close_tabs_.empty() ||
+            PhysicalCloseContentsFor(participant.get()).size() ==
+                static_cast<size_t>(participant->GetTabStripModel()->count()))
+          group.push_back(participant.get());
+      }
+      if (!physical_close_tabs_.empty() &&
+          PhysicalCloseContentsFor(browser.get()).size() !=
+              static_cast<size_t>(browser->GetTabStripModel()->count())) continue;
+      bool warning_possible = !controller->force_skip_warning_user_on_close();
+#if BUILDFLAG(IS_MAC) || BUILDFLAG(IS_CHROMEOS)
+      warning_possible &= browser->GetProfile()->IsOffTheRecord();
+#endif
+      int blocking_downloads = 0;
+      const bool needs_warning =
+          warning_possible && controller->OkToCloseWithInProgressDownloads(
+                                  &blocking_downloads, group) !=
+                                  UnloadController::DownloadCloseType::kOk;
+      if (needs_warning &&
+          !SelectLogicalBrowserView(
+              BrowserView::GetBrowserViewForBrowser(browser.get()))) {
+        if (alive) {
+          CancelPhysicalClose();
+        }
+        return;
+      }
+      if (!alive) {
+        return;
+      }
+      if (!ValidatePhysicalCloseParticipants()) {
+        CancelPhysicalClose();
+        return;
+      }
+      controller = UnloadController::From(browser.get());
+      physical_close_waiting_ = true;
+      auto result = controller->MaybeWarnBeforeClosing(
+          base::BindOnce(
+              [](base::WeakPtr<BrowserWidget> host, size_t index,
+                 UnloadController::WarnBeforeClosingResult result) {
+                if (host) {
+                  host->OnPhysicalWarning(
+                      index, result == UnloadController::
+                                           WarnBeforeClosingResult::kOkToClose);
+                }
+              },
+              physical_close_weak_factory_.GetWeakPtr(), index),
+          group);
+      if (!alive) {
+        return;
+      }
+      if (result == UnloadController::WarnBeforeClosingResult::kDoNotClose) {
+        return;
+      }
+      physical_close_waiting_ = false;
+    } else {
+      auto* controller = UnloadController::From(browser.get());
+      const auto only_tabs = PhysicalCloseContentsFor(browser.get());
+      if (controller->TabsNeedBeforeUnloadFired(only_tabs) &&
+          MayPromptBeforeUnload(browser.get(), only_tabs) &&
+          !SelectLogicalBrowserView(
+              BrowserView::GetBrowserViewForBrowser(browser.get()))) {
+        if (alive) {
+          CancelPhysicalClose();
+        }
+        return;
+      }
+      if (!alive) {
+        return;
+      }
+      if (!ValidatePhysicalCloseParticipants()) {
+        CancelPhysicalClose();
+        return;
+      }
+      controller = UnloadController::From(browser.get());
+      physical_close_waiting_ = true;
+      if (controller->RunBeforeUnloadForShutdown(
+              false,
+              base::BindRepeating(&BrowserWidget::OnPhysicalBeforeUnload,
+                                  physical_close_weak_factory_.GetWeakPtr(),
+                                  index),
+              UnloadController::BeforeUnloadPurpose::kNativeWindowGroup, only_tabs)) {
+        return;
+      }
+      if (!alive) {
+        return;
+      }
+      physical_close_waiting_ = false;
+    }
+    if (!alive) {
+      return;
+    }
+    if (!ValidatePhysicalCloseParticipants()) {
+      CancelPhysicalClose();
+      return;
+    }
+  }
+  if (physical_close_phase_ == PhysicalClosePhase::kWarnings) {
+    physical_close_phase_ = PhysicalClosePhase::kBeforeUnload;
+    physical_close_index_ = 0;
+    ContinuePhysicalClose();
+    return;
+  }
+  // New handlers/tabs may have appeared while another profile's dialog was
+  // pending. Re-run the non-destructive phase for those handlers before commit.
+  for (size_t i = 0; i < physical_close_participants_.size(); ++i) {
+    const auto& browser = physical_close_participants_[i];
+    const auto only_tabs = PhysicalCloseContentsFor(browser.get());
+    if (UnloadController::From(browser.get())->TabsNeedBeforeUnloadFired(only_tabs)) {
+      physical_close_index_ = 0;
+      ContinuePhysicalClose();
+      return;
+    }
+  }
+  CommitPhysicalClose();
+}
+
+void BrowserWidget::OnPhysicalWarning(size_t index, bool proceed) {
+  if (physical_close_phase_ != PhysicalClosePhase::kWarnings ||
+      !physical_close_waiting_ || physical_close_index_ != index + 1) {
+    return;
+  }
+  if (!proceed || !ValidatePhysicalCloseParticipants()) {
+    CancelPhysicalClose();
+    return;
+  }
+  auto* view = BrowserView::GetBrowserViewForBrowser(
+      physical_close_participants_[index].get());
+  auto warning = view->pending_download_warning_;
+  if (warning && warning->IsVisible()) {
+    // Accept runs before the modal actually hides. Advancing now can require a
+    // profile switch while its native prompt still owns the responder/anchor.
+    physical_warning_observation_.Observe(warning.get());
+    return;
+  }
+  ResumeAfterPhysicalWarningDismissed();
+}
+
+void BrowserWidget::ResumeAfterPhysicalWarningDismissed() {
+  physical_warning_observation_.Reset();
+  if (physical_close_phase_ != PhysicalClosePhase::kWarnings ||
+      !physical_close_waiting_) {
+    return;
+  }
+  if (!ValidatePhysicalCloseParticipants()) {
+    CancelPhysicalClose();
+    return;
+  }
+  physical_close_waiting_ = false;
+  // Do not resume from a nested native-modal teardown callback. Group cancel
+  // or host destruction invalidates this existing generation-bound weak task.
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostNonNestableTask(
+      FROM_HERE, base::BindOnce(&BrowserWidget::ContinuePhysicalClose,
+                                physical_close_weak_factory_.GetWeakPtr()));
+}
+
+void BrowserWidget::OnWidgetVisibilityChanged(views::Widget* widget,
+                                              bool visible) {
+  if (!visible && physical_warning_observation_.IsObservingSource(widget)) {
+    ResumeAfterPhysicalWarningDismissed();
+  }
+}
+
+void BrowserWidget::OnWidgetDestroying(views::Widget* widget) {
+  if (physical_warning_observation_.IsObservingSource(widget)) {
+    ResumeAfterPhysicalWarningDismissed();
+  }
+}
+
+void BrowserWidget::OnPhysicalBeforeUnload(size_t index, bool proceed) {
+  if (physical_close_phase_ != PhysicalClosePhase::kBeforeUnload ||
+      !physical_close_waiting_ || physical_close_index_ != index + 1) {
+    return;
+  }
+  physical_close_waiting_ = false;
+  if (!proceed || !ValidatePhysicalCloseParticipants()) {
+    CancelPhysicalClose();
+    return;
+  }
+  base::SingleThreadTaskRunner::GetCurrentDefault()->PostTask(
+      FROM_HERE, base::BindOnce(&BrowserWidget::ContinuePhysicalClose,
+                                physical_close_weak_factory_.GetWeakPtr()));
+}
+
+void BrowserWidget::CommitPhysicalClose() {
+  if (!ValidatePhysicalCloseParticipants()) {
+    CancelPhysicalClose();
+    return;
+  }
+  auto alive = physical_close_weak_factory_.GetWeakPtr();
+  const auto participants = physical_close_participants_;
+  if (!physical_close_tabs_.empty()) {
+    // Keep both controllers/pages live through the final policy checks. ClosePage
+    // then commits only these already-consented pages, never all browser tabs.
+    const auto targets = physical_close_tabs_;
+    for (const auto& target : targets) {
+      if (!target || !UnloadController::From(target->GetBrowserWindowInterface())->CanCloseContents(target->GetContents())) {
+        if (alive) CancelPhysicalClose();
+        return;
+      }
+      if (!alive || !ValidatePhysicalCloseParticipants()) {
+        if (alive) CancelPhysicalClose();
+        return;
+      }
+    }
+#if BUILDFLAG(IS_MAC)
+    for (const auto& target : targets) {
+      if (auto* peek = barc::PeekForSource(target.get())) {
+        if (!barc::CommitPeekPairClose(target.get(), peek)) {
+          CancelPhysicalClose();
+          return;
+        }
+      }
+    }
+#endif
+    physical_close_phase_ = PhysicalClosePhase::kCommitted;
+    // The custom-handler continuation is obsolete: this commit closes the exact
+    // source itself. Invoking it would dispatch a second beforeunload/close.
+    peek_close_cancelled_.Reset();
+    for (const auto& browser : participants)
+      UnloadController::From(browser.get())->FinishNativeWindowGroupTabClose();
+    std::vector<base::WeakPtr<BrowserWindowInterface>> target_owners;
+    std::vector<base::WeakPtr<content::WebContents>> target_contents;
+    for (const auto& target : targets) {
+      target_owners.push_back(target->GetBrowserWindowInterface()->GetWeakPtr());
+      target_contents.push_back(target->GetContents()->GetWeakPtr());
+    }
+    for (size_t i = 0; i < targets.size(); ++i) {
+      const auto& target = targets[i];
+      // A preceding close callback can transfer or replace another target.
+      // Consent never follows that page into a newer ordinary owner/document.
+      if (target && target_owners[i] && target_contents[i] &&
+          target->GetBrowserWindowInterface() == target_owners[i].get() &&
+          target->GetContents() == target_contents[i].get()) {
+        target->GetContents()->ClosePage();
+      } else if (target && target_contents[i]) {
+#if BUILDFLAG(IS_MAC)
+        barc::ResetPeekCloseCommitted(target.get(), target_contents[i].get());
+#endif
+      }
+      if (!alive) return;
+    }
+    physical_close_tabs_.clear();
+    physical_close_participants_.clear();
+    logical_peek_close_owner_.reset();
+    physical_close_index_ = 0;
+    physical_close_waiting_ = false;
+    physical_close_phase_ = PhysicalClosePhase::kIdle;
+    return;
+  }
+  for (const auto& browser : participants) {
+    auto* view = BrowserView::GetBrowserViewForBrowser(browser.get());
+    const bool permitted =
+        view->OnCloseRequested(views::Widget::ClosedReason::kUnspecified);
+    if (!alive) {
+      return;
+    }
+    if (!permitted || !ValidatePhysicalCloseParticipants()) {
+      CancelPhysicalClose();
+      return;
+    }
+  }
+  for (const auto& browser : participants) {
+    UnloadController::From(browser.get())->CommitNativeWindowGroupClose();
+  }
+  physical_close_phase_ = PhysicalClosePhase::kCommitted;
+  Hide();
+  if (!alive) {
+    return;
+  }
+  for (const auto& browser : participants) {
+    if (browser) {
+      UnloadController::From(browser.get())->OnWindowClosing();
+      if (!alive) {
+        return;
+      }
+    }
+  }
+}
+
+namespace {
+// A link's status hint takes no input and belongs to whichever page is hovered.
+bool BlocksLogicalSwitch(const views::Widget* host, const views::Widget* child) {
+  return child != host && child->IsVisible() && child->GetName() != "StatusBubble";
+}
+}  // namespace
+
+bool BrowserWidget::CanAcceptLogicalBrowser() {
+#if BUILDFLAG(IS_MAC)
+  if (IsClosed() || HasPhysicalClosePending() || changing_barc_peek_ ||
+      clearing_barc_peek_ || !browser_view_ ||
+      browser_view_->browser()->IsDeleteScheduled() ||
+      browser_view_->browser()->GetType() !=
+          BrowserWindowInterface::Type::TYPE_NORMAL ||
+      tab_drag_kind_ != TabDragKind::kNone || !browser_native_widget_ ||
+      !browser_native_widget_->CanSelectBrowserView()) {
+    return false;
+  }
+  for (views::Widget* child : GetAllOwnedWidgets(GetNativeView())) {
+    if (BlocksLogicalSwitch(this, child)) {
+      return false;
+    }
+  }
+  return true;
+#else
+  return false;
+#endif
+}
+
+bool BrowserWidget::AttachLogicalBrowserView(BrowserView* view) {
+  if (!CanAcceptLogicalBrowser()) {
+    return false;
+  }
+  CHECK(view);
+  CHECK_EQ(view->browser()->GetType(),
+           BrowserWindowInterface::Type::TYPE_NORMAL);
+  view->BindPhysicalBrowserWidget(this);
+  auto frame = chrome::CreateBrowserFrameView(this, view);
+  view->SetOwnFrameView(frame.get());
+  RetainClientFrame(std::move(frame), std::unique_ptr<views::ClientView>(view),
+                    view);
+  return true;
+}
+
+bool BrowserWidget::SelectLogicalBrowserView(BrowserView* view) {
+  return SelectLogicalBrowserViewInternal(view, false);
+}
+
+bool BrowserWidget::SelectLogicalBrowserViewInternal(BrowserView* view,
+                                                     bool closing_current) {
+#if BUILDFLAG(IS_MAC)
+  CHECK(!selecting_logical_view_);
+  if (clearing_barc_peek_ && !closing_current) return false;
+  if (!view || view->browser_widget() != this ||
+      (!closing_current &&
+       (IsClosed() || view->browser()->IsDeleteScheduled()))) {
+    return false;
+  }
+  if ((!closing_current && (browser_view_->browser()->IsDeleteScheduled() ||
+                            browser_view_->suppress_layout_for_teardown_ ||
+                            view->suppress_layout_for_teardown_))) {
+    return false;
+  }
+  if (barc_peek_ && !changing_barc_peek_ &&
+      (!barc_peek_->peek || barc_peek_->peek->GetBrowserWindowInterface() != view->browser())) {
+    auto host_alive = GetWeakPtr();
+    auto incoming_alive = view->GetAsWeakPtr();
+    const uint64_t before = barc_selection_epoch_;
+    ClearBarcPeek(false, false);
+    if (!host_alive || !incoming_alive || before != barc_selection_epoch_) return false;
+  }
+  // Identity selection is a no-op for a singleton native popup too. Actual
+  // shared-client switching below remains restricted to normal browsers.
+  if (view == browser_view_)
+    return true;
+  if (browser_view_->browser()->GetType() !=
+          BrowserWindowInterface::Type::TYPE_NORMAL ||
+      view->browser()->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL) {
+    return false;
+  }
+  // CURRENTLY UNQUALIFIED: switching with fullscreen/transitions or visible
+  // native child prompts/popups needs profile-correct responder/anchor proof.
+  // These are temporary admission gates, not the product's final scope.
+  // Active drag ownership likewise must finish before selecting another client.
+  if (!closing_current && (tab_drag_kind_ != TabDragKind::kNone ||
+                           !browser_native_widget_->CanSelectBrowserView())) {
+    return false;
+  }
+  if (!closing_current) {
+    auto* zoom = ZoomBubbleCoordinator::From(browser_view_->browser());
+    auto zoom_widget = zoom ? zoom->GetBubbleWidget()
+                            : base::WeakPtr<views::Widget>();
+    if (zoom_widget) {
+      auto host_alive = GetWeakPtr();
+      auto previous_alive = browser_view_->GetAsWeakPtr();
+      auto incoming_alive = view->GetAsWeakPtr();
+      const uint64_t before = barc_selection_epoch_;
+      auto active_tab_id = [](BrowserView* client) {
+        auto* tab = client->browser()->GetActiveTabInterface();
+        return tab ? tab->GetHandle().raw_value() : 0;
+      };
+      const int previous_tab = active_tab_id(previous_alive.get());
+      const int incoming_tab = active_tab_id(incoming_alive.get());
+      auto current = [&] {
+        return host_alive && previous_alive && incoming_alive &&
+            browser_view_ == previous_alive.get() &&
+            barc_selection_epoch_ == before && !IsClosed() &&
+            tab_drag_kind_ == TabDragKind::kNone && browser_native_widget_ &&
+            browser_native_widget_->CanSelectBrowserView() &&
+            !previous_alive->browser()->IsDeleteScheduled() &&
+            !incoming_alive->browser()->IsDeleteScheduled() &&
+            !previous_alive->suppress_layout_for_teardown_ &&
+            !incoming_alive->suppress_layout_for_teardown_ &&
+            active_tab_id(previous_alive.get()) == previous_tab &&
+            active_tab_id(incoming_alive.get()) == incoming_tab;
+      };
+      // Admit the normal asynchronous zoom close first. Then hide only its
+      // captured widget, never a replacement created by a close callback.
+      zoom->Hide();
+      if (!current()) {
+        return false;
+      }
+      if (zoom_widget) {
+        if (!zoom_widget->IsClosed()) {
+          return false;
+        }
+        zoom_widget->Hide();
+        if (!current()) {
+          return false;
+        }
+      }
+    }
+  }
+  for (views::Widget* child : GetAllOwnedWidgets(GetNativeView())) {
+    if (!closing_current && BlocksLogicalSwitch(this, child)) {
+      return false;
+    }
+  }
+  const auto clients = GetLogicalBrowserViews();
+  if (std::ranges::find(clients, view) == clients.end()) {
+    return false;
+  }
+  CHECK_EQ(view->GetFrameView()->GetWidget(), this);
+#if BUILDFLAG(ENTERPRISE_SCREENSHOT_PROTECTION)
+  // Do not expose a profile before its normal window controllers exist.
+  if (!enterprise_data_protection::DataProtectionUIController::From(
+          view->browser())) {
