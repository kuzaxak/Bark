+ public:
+  explicit BarcPresentedContentsDelegate(BrowserWidget* widget)
+      : widget_(widget->GetWeakPtr()) {}
+  void WebContentsFocused(content::WebContents* contents) override {
+    if (widget_) {
+      static_cast<BrowserWidget*>(widget_.get())->SelectBarcPresentedContents(contents);
+    }
+  }
+  void ResizeWebContents(double ratio, bool done_resizing) override {
+    const std::array<double, 1> cuts{ratio};
+    ResizeDividers(cuts, done_resizing);
+  }
+  void ResizeDividers(base::span<const double> cuts, bool done_resizing) override {
+    if (widget_) {
+      static_cast<BrowserWidget*>(widget_.get())->ResizeBarcPresentedContents(cuts, done_resizing);
+    }
+  }
+  void ReverseWebContents() override {
+    if (widget_) {
+      static_cast<BrowserWidget*>(widget_.get())->ReverseBarcPresentedContents();
+    }
+  }
+  void HandleLinkDrop(MultiContentsDropTargetView::DropSide,
+                      const ui::DropTargetEvent&) override {
+    // Profile-bound drop decisions remain in the app's existing SplitViewManager.
+    // The physical view never enables Chromium's single-tabstrip drop target.
+    NOTREACHED();
