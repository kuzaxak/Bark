+bool BrowserWidget::RefreshSelectedLogicalBrowserView() {
+  BrowserView* view = selected_browser_view();
+  auto alive = GetWeakPtr();
+  auto view_alive = view->weak_ptr_factory_.GetWeakPtr();
+  auto intact = [&] { return alive && view_alive; };
+  if (barc_presented_contents_ && !changing_barc_presentation_ && !barc_peek_) {
+    barc_presented_contents_->SetActiveContents(view->GetActiveWebContents());
+    if (!intact()) {
+      return false;
+    }
+  }
+  SelectNativeTheme();
+  ResetLastColorProviderKey();
+  // Widget::ThemeChanged repaints/color-refreshes existing trees. It does not
+  // call UserChangedTheme/RegenerateFrameOnThemeChange or replay
+  // initialization.
+  ThemeChanged();
+  if (!intact()) {
+    return false;
+  }
+  UpdateWindowTitle();
+  if (!intact()) {
+    return false;
+  }
+  UpdateWindowIcon();
+  if (!intact()) {
+    return false;
+  }
+  if (auto* contents = view->GetActiveWebContents()) {
+    view->UpdateAccessibleURLForRootView(contents->GetURL());
+    if (!intact()) {
+      return false;
+    }
+  }
+  view->UpdateAccessibleNameForRootView();
+  if (!intact()) {
+    return false;
+  }
+  view->PaintAsActiveChanged();
+  if (!intact()) {
+    return false;
+  }
+  view->OnWidgetVisibilityChanged(this, IsVisible());
+  if (!intact()) {
+    return false;
+  }
+  view->OnWidgetActivationChanged(this, IsActive());
+  if (!intact()) {
+    return false;
+  }
+  if (IsActive()) {
+    view->RestoreFocus();
+    if (!intact()) {
+      return false;
+    }
+  }
+  if (barc_presented_contents_) {
+    LayoutBarcPresentedContents();
+    if (!intact()) {
+      return false;
+    }
+  }
+  if (barc_peek_) {
+    LayoutBarcPeek();
+    if (!intact()) return false;
+  }
+  return true;
+}
+
+std::vector<BrowserView*> BrowserWidget::GetLogicalBrowserViews() const {
+  std::vector<BrowserView*> clients;
+  if (!non_client_view()) {
+    return clients;
+  }
+  for (views::View* child : non_client_view()->children()) {
+    auto* frame = views::AsViewClass<views::FrameView>(child);
+    if (frame) {
+      if (auto* view = views::AsViewClass<BrowserView>(frame->client_view())) {
+        CHECK(view->browser_widget() == this ||
+              (IsClosed() && !view->browser_widget()));
+        clients.push_back(view);
+      }
+    }
+  }
+  return clients;
+}
