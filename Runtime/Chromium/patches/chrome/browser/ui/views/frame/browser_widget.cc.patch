+
+void BrowserWidget::OnNativeWidgetDestroying() {
+  auto presentation_host = GetWeakPtr();
+  changing_barc_presentation_ = true;
+  // Mark every logical owner before the first BrowserView observer destroys
+  // tabs and delivers foreign CLOSED callbacks that may query another owner.
+  for (BrowserView* view : GetLogicalBrowserViews()) {
+    UnloadController::From(view->browser())->OnNativeWindowDestroying();
+  }
+  ClearBarcPresentedTabsImpl(true);
+  if (!presentation_host) {
+    return;
+  }
+  Widget::OnNativeWidgetDestroying();
+}
+
 void BrowserWidget::OnNativeWidgetDestroyed() {
+  const auto clients = GetLogicalBrowserViews();
+  if (clients.size() > 1) {
+    // The native window has already gone: never prompt or restart preflight.
+    physical_close_weak_factory_.InvalidateWeakPtrs();
+    physical_close_phase_ = PhysicalClosePhase::kCommitted;
+    browser_native_widget_ = nullptr;
+    std::vector<base::WeakPtr<BrowserWindowInterface>> browsers;
+    base::WeakPtr<BrowserWindowInterface> owner;
+    for (BrowserView* view : clients) {
+      auto browser = view->browser()->GetWeakPtr();
+      if (view->owned_browser_widget_) {
+        CHECK(!owner);
+        owner = browser;
+      } else {
+        browsers.push_back(browser);
+      }
+    }
+    CHECK(owner);
+    browsers.push_back(owner);  // The unique Widget owner must die last.
+    auto alive = GetWeakPtr();
+    for (const auto& browser : browsers) {
+      if (browser) {
+        auto* controller = UnloadController::From(browser.get());
+        controller->CommitNativeWindowGroupClose();
+        controller->set_force_skip_warning_user_on_close(true);
+        controller->OnWindowClosing();
+        if (!alive) {
+          return;
+        }
+      }
+    }
+    Widget::OnNativeWidgetDestroyed();
+    if (!alive) {
+      return;
+    }
+    for (const auto& browser : browsers) {
+      if (browser) {
+        BrowserManagerService::SynchronouslyDestroyBrowser(browser.get());
+        if (!alive) {
+          return;
+        }
+      }
+    }
+    return;
+  }
