+void MultiContentsView::RetireAfterOwnerDestruction() {
+  auto retirement = hierarchy_retirement_.lock();
+  if (!retirement) {
+    return;
+  }
+  CHECK(!*retirement);
+  CHECK(parent());
+  // Remove the shell while its owner is still valid. The current reparent's
+  // old-parent reference remains live, but no owner-bound children survive.
+  auto removed = parent()->RemoveChildViewT(this);
+  DestroyOwnerBoundChildren();
+  browser_view_ = nullptr;
+  *retirement = std::move(removed);
 }
 
 MultiContentsView::~MultiContentsView() {
+  DestroyOwnerBoundChildren();
+}
+
+void MultiContentsView::DestroyOwnerBoundChildren() {
+  CHECK(!HasBorrowedContainers());
+  SetLayoutManager(nullptr);
+  contents_focused_subscriptions_.clear();
+  pref_change_registrar_.Reset();
   // Clear the map and vectors before `RemoveAllChildViews()` to avoid having
   // dangling pointers.
   container_focusable_map_.clear();
-  contents_container_views_.clear();
   if (drop_target_controller_) {
     drop_target_controller_.reset();
   }
+  for (const auto& container : contents_container_views_) {
+    if (!container->hierarchy_mutation_.expired()) {
+      CHECK_EQ(container->parent(), this);
+      auto removed = RemoveChildViewT(container.get());
+      removed->DestroyOwnerBoundChildrenForRetirement();
+      retired_hierarchy_children_.push_back(std::move(removed));
+    }
+  }
+  contents_container_views_.clear();
   drop_target_view_ = nullptr;
   lens_overlay_view_ = nullptr;
   resize_area_ = nullptr;
+  resize_areas_.clear();
   contents_separators_.Reset();
   background_view_ = nullptr;
   RemoveAllChildViews();
+  delegate_.reset();
 }
 
