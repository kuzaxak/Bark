+void MultiContentsView::SetSplitContents(
+    base::span<content::WebContents* const> contents) {
+  if (HasBorrowedContainers()) {
+    return;
+  }
+
+  CHECK_GE(contents.size(), 2u);
+  CHECK_LE(contents.size(), split_tabs::SplitTabVisualData::kMaxPanes);
+  CHECK_LE(contents.size(), contents_container_views_.size());
+  auto remaining = contents_container_views_;
+  decltype(contents_container_views_) ordered;
+  // Move the existing container for each live page, preserving its native view,
+  // focus helpers and overlays rather than remounting it into another container.
+  for (auto* page : contents) {
+    auto it = std::ranges::find_if(remaining, [page](const auto& container) {
+      return container->contents_view()->web_contents() == page;
+    });
+    if (it == remaining.end()) {
+      it = std::ranges::find_if(remaining, [&contents](const auto& container) {
+        return !std::ranges::contains(contents,
+            container->contents_view()->web_contents());
+      });
+    }
+    CHECK(it != remaining.end());
+    ordered.push_back(*it);
+    remaining.erase(it);
+  }
+  ordered.insert(ordered.end(), remaining.begin(), remaining.end());
+  contents_container_views_ = std::move(ordered);
+  const auto active = std::ranges::find(contents,
+      browser_view_->browser()->GetTabStripModel()->GetActiveWebContents());
+  active_index_ = active == contents.end() ? 0 : active - contents.begin();
+  for (size_t i = 0; i < contents_container_views_.size(); ++i) {
+    ReorderChildView(contents_container_views_[i], static_cast<int>(2 * i + 1));
+    if (i < resize_areas_.size()) {
+      ReorderChildView(resize_areas_[i], static_cast<int>(2 * i + 2));
+    }
+    if (i < contents.size()) {
+      SetWebContentsAtIndex(contents[i], i);
+    } else {
+      contents_container_views_[i]->contents_view()->SetWebContents(nullptr);
+      contents_container_views_[i]->SetVisible(false);
+    }
   }
 }
 
+void MultiContentsView::ShowSplitView(
+    split_tabs::SplitTabVisualData visual_data) {
+  if (HasBorrowedContainers()) {
+    return;
+  }
+
+  CHECK_LE(visual_data.pane_count(), contents_container_views_.size());
+  visual_data_ = visual_data;
+  for (size_t i = 0; i < contents_container_views_.size(); ++i) {
+    const bool visible = i < visual_data.pane_count();
+    if (!visible) {
+      contents_container_views_[i]->contents_view()->SetWebContents(nullptr);
+    }
+    contents_container_views_[i]->SetVisible(visible);
+  }
+  for (size_t i = 0; i < resize_areas_.size(); ++i) {
+    resize_areas_[i]->SetLayout(visual_data.split_layout());
+    resize_areas_[i]->SetVisible(i + 1 < visual_data.pane_count());
+  }
+  UpdateContentsBorderAndOverlay();
+  InvalidateLayout();
+}
