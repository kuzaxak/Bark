+bool MultiContentsView::ReturnContainerFromPresentation(
+    ContentsContainerView* container) {
+  if (!browser_view_ || !container || container->browser_view() != browser_view_ ||
+      !std::ranges::contains(contents_container_views_, container) ||
+      !container->parent() || container->GetWidget() != GetWidget()) {
+    return false;
+  }
+  views::ViewTracker alive(this);
+  views::ViewTracker incoming(container);
+  AddChildViewRaw(container);
+  if (!alive || !incoming || container->parent() != this) {
+    return false;
+  }
+  if (!HasBorrowedContainers() && container_visibility_before_physical_borrow_) {
+    const auto visible = *container_visibility_before_physical_borrow_;
+    container_visibility_before_physical_borrow_.reset();
+    for (size_t i = 0; i < contents_container_views_.size(); ++i) {
+      contents_container_views_[i]->SetVisible(visible[i]);
+      if (!alive || !incoming || container->parent() != this) {
+        return false;
+      }
+    }
+  }
+  if (!HasBorrowedContainers()) {
+    UpdateContentsBorderAndOverlay();
+    if (!alive || !incoming || container->parent() != this) {
+      return false;
+    }
+  }
+  InvalidateLayout();
+  return true;
+}
+
+bool MultiContentsView::AddPresentedContainer(
+    ContentsContainerView* container) {
+  if (browser_view_ || !container || !container->parent() ||
+      container->GetWidget() != GetWidget() ||
+      contents_container_views_.size() >= split_tabs::SplitTabVisualData::kMaxPanes ||
+      std::ranges::contains(contents_container_views_, container)) {
+    return false;
+  }
+  auto* source = views::AsViewClass<MultiContentsView>(container->parent());
+  if (!source || source->is_physical_presentation()) {
+    return false;
+  }
+  if (!source->container_visibility_before_physical_borrow_) {
+    source->container_visibility_before_physical_borrow_.emplace();
+    for (size_t i = 0; i < source->contents_container_views_.size(); ++i) {
+      (*source->container_visibility_before_physical_borrow_)[i] =
+          source->contents_container_views_[i]->GetVisible();
+    }
+  }
+  // AddChildView keeps the old parent in hierarchy notification details until
+  // every observer returns. Owner teardown can empty and retire that exact
+  // parent into this stack, without keeping its Browser or controllers alive.
+  auto source_retirement = source->hierarchy_retirement_.lock();
+  if (!source_retirement) {
+    source_retirement = std::make_shared<std::unique_ptr<MultiContentsView>>();
+    source->hierarchy_retirement_ = source_retirement;
+  }
+  container->hierarchy_mutation_ = source_retirement;
+  views::ViewTracker alive(this);
+  views::ViewTracker incoming(container);
+  // Track the incoming child before hierarchy callouts, so physical teardown
+  // can find/return it even when a callback closes the native window.
+  contents_container_views_.push_back(container);
+  ObserveContainerFocus(container);
+  AddChildViewRaw(container);
+  return alive && incoming && container->parent() == this;
+}
+
+void MultiContentsView::ReversePresentedContainers() {
+  CHECK(!browser_view_);
+  views::ViewTracker alive(this);
+  std::ranges::reverse(contents_container_views_);
+  active_index_ = static_cast<int>(contents_container_views_.size()) - 1 - active_index_;
+  for (size_t i = 0; i < contents_container_views_.size(); ++i) {
+    ReorderChildView(contents_container_views_[i], 2 * i + 1);
+    if (!alive) {
+      return;
+    }
+  }
+  InvalidateLayout();
+}
+
+void MultiContentsView::HideUnpresentedOwnerContainers() {
+  if (!browser_view_ || !HasBorrowedContainers()) {
+    return;
+  }
+  // BrowserViewLayout requires the owner's MultiContentsView stay visible.
+  // Hide only its remaining, unpresented child surfaces, not that layout node.
+  views::ViewTracker alive(this);
+  for (const auto& container : contents_container_views_) {
+    if (container->parent() == this) {
+      container->SetVisible(false);
+      if (!alive) {
+        return;
+      }
+    }
+  }
+}
+
+void MultiContentsView::StopObservingPresentedContainers() {
+  CHECK(!browser_view_);
+  contents_focused_subscriptions_.clear();
+  container_focusable_map_.clear();
+}
+
+void MultiContentsView::ForgetReturnedPresentedContainers() {
+  CHECK(!browser_view_);
+  for (const auto& container : contents_container_views_) {
+    CHECK_NE(container->parent(), this);
+  }
+  contents_container_views_.clear();
+}
+
+bool MultiContentsView::HasBorrowedContainers() const {
+  return browser_view_ &&
+      std::ranges::any_of(contents_container_views_, [this](const auto& view) {
+        return view->parent() != this;
+      });
+}
