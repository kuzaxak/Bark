@@ -48,12 +49,42 @@ GlobalErrorBubbleViewBase* GlobalErrorBubbleViewBase::ShowStandardBubbleView(
       anchor = control->GetAnchor();
     }
   }
+  const bool has_app_menu_anchor = static_cast<bool>(anchor);
+#if BUILDFLAG(IS_MAC)
+  if (!has_app_menu_anchor) {
+    // The Bark window has an app-owned root and no toolbar menu button.
+    auto* window = browser->GetWindow();
+    auto* buttons = ToolbarButtonProvider::From(browser);
+    if (!window || !window->IsVisible() || !window->IsActive() ||
+        !buttons || !browser->IsSelectedForNativeWindow()) {
+      return nullptr;
+    }
+    anchor = buttons->GetDefaultExtensionDialogAnchor();
+    if (!anchor.GetIfView() || !anchor.GetIfView()->GetWidget())
