-  if (anchor) {
+  if (has_app_menu_anchor) {
     bubble_view->SetHighlightedElement(kToolbarAppMenuButtonElementId);
   }
   views::BubbleDialogDelegateView::CreateBubble(bubble_view);
+#if BUILDFLAG(IS_MAC)
+  if (!has_app_menu_anchor) {
+    bubble_view->owner_selection_subscription_ =
+        browser->RegisterNativeWindowSelectionChanged(base::BindRepeating(
+            [](GlobalErrorBubbleView* bubble,
