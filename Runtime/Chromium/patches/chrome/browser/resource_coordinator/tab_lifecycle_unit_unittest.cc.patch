+#if BUILDFLAG(IS_MAC)
+TEST_F(TabLifecycleUnitTest, NativeUnknownWorkBlocksDirectDiscard) {
+  base::test::ScopedCommandLine command;
+  command.GetProcessCommandLine()->AppendSwitch("barc-native-shell");
+  command.GetProcessCommandLine()->AppendSwitch("barc-shared-native-window");
+  tab_strip_model_->AddObserver(GetTabLifecycleUnitSource());
+  TabLifecycleUnit* unit = AddNewHiddenLifecycleUnitToTabStrip();
+  content::WebContents* contents = unit->GetWebContents();
+  unit->SetAutoDiscardable(false);
+  for (auto reason : {LifecycleUnitDiscardReason::EXTERNAL,
+                      LifecycleUnitDiscardReason::URGENT,
+                      LifecycleUnitDiscardReason::PROACTIVE,
+                      LifecycleUnitDiscardReason::SUGGESTED,
+                      LifecycleUnitDiscardReason::FROZEN_WITH_GROWING_MEMORY}) {
+    EXPECT_FALSE(unit->DiscardTab(reason, 0));
+    EXPECT_EQ(contents, unit->GetWebContents());
+    EXPECT_FALSE(unit->IsAutoDiscardable());
+  }
+  tab_strip_model_->RemoveObserver(GetTabLifecycleUnitSource());
+}
+#endif
