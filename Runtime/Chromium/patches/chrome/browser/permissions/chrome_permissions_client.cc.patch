+bool ChromePermissionsClient::IsPermissionPromptOwnerSelected(
+    tabs::TabInterface* tab) {
+#if !BUILDFLAG(IS_ANDROID)
+  if (tab) {
+    auto* owner = tab->GetBrowserWindowInterface();
+    return owner && !owner->IsDeleteScheduled() &&
+             owner->IsSelectedForNativeWindow();
+  }
+#endif
+  return true;
+}
+
+base::CallbackListSubscription
+ChromePermissionsClient::RegisterPermissionPromptOwnerChanged(
+    tabs::TabInterface* tab, base::RepeatingClosure callback) {
+#if !BUILDFLAG(IS_ANDROID)
+  if (tab) {
+    if (auto* owner = tab->GetBrowserWindowInterface()) {
+      return owner->RegisterNativeWindowSelectionChanged(std::move(callback));
+    }
+  }
+#endif
+  return {};
+}
