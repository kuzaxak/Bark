+// The intrinsic ApplicationLaunch record owns this one captured intent. Its
+// pending-only list supplies ordering; there is no second URL queue.
+class PendingPrivateMenuNavigation
+    : public content::WebContentsObserver,
+      public std::enable_shared_from_this<PendingPrivateMenuNavigation> {
+ public:
+  PendingPrivateMenuNavigation(
+      content::WebContents* source, content::WeakDocumentPtr document,
+      Profile* source_profile, Profile* destination,
+      content::OpenURLParams params,
+      base::OnceCallback<void(content::NavigationHandle&)> callback)
+      : content::WebContentsObserver(source),
+        document_(document), source_profile_(source_profile->GetWeakPtr()),
+        destination_(destination->GetWeakPtr()), params_(std::move(params)),
+        callback_(std::move(callback)) {
+    auto* frame = document_.AsRenderFrameHostIfValid();
+    CHECK(frame);
+    source_frame_ = frame->GetFrameTreeNodeId();
+  }
+
+  void Start() {
+    auto keep_alive = shared_from_this();
+    if (!ValidSource()) return Cancel();
+    static uint64_t next_request = 0;
+    CHECK_NE(++next_request, 0u);
+    page_ = barc::CreateApplicationPage(destination_.get(), nullptr, {},
+                                        next_request);
+    if (finished_ || !ValidSource() || !page_.tab) {
+      barc::CloseUnusedApplicationPage(page_);
+      return Cancel();
+    }
+    auto* blank = PendingContents();
+    auto* entry = blank ? blank->GetController().GetActiveEntry() : nullptr;
+    if (!entry) return Cancel();
+    entry_id_ = entry->GetUniqueID();
+    if (!MatchesDestination()) return Cancel();
+    if (!barc::SetApplicationPageResume(page_, base::BindRepeating(
+            &PendingPrivateMenuNavigation::Resume, keep_alive))) {
+      Cancel();
+    }
+  }
+
+ private:
+  content::WebContents* PendingContents() const {
+    if (!destination_ ||
+        !barc::ApplicationPageMatches(page_.window, page_.tab, page_.request))
+      return nullptr;
+    auto* tab = tabs::TabHandle(page_.tab).Get();
+    return tab && tab->GetContents()->GetBrowserContext() == destination_.get()
+        ? tab->GetContents() : nullptr;
+  }
+  bool MatchesDestination() const {
+    auto* blank = PendingContents();
+    if (!blank || !entry_id_ || !barc::IsPendingApplicationPage(page_)) return false;
+    auto& controller = blank->GetController();
+    auto* entry = controller.GetActiveEntry();
+    // The original explicit blank may commit after capture. Its entry identity
+    // survives that commit; a new/replacement navigation has a different ID.
+    // Reload retains the ID, but Chromium marks the transition as RELOAD.
+    return entry && entry->GetUniqueID() == entry_id_ &&
+        controller.GetEntryCount() == 1 &&
+        entry->GetURL() == GURL(url::kAboutBlankURL) &&
+        !ui::PageTransitionCoreTypeIs(entry->GetTransitionType(),
+                                      ui::PAGE_TRANSITION_RELOAD) &&
+        !(entry->GetTransitionType() & ui::PAGE_TRANSITION_FORWARD_BACK) &&
+        (blank->GetLastCommittedURL().is_empty() ||
+         blank->GetLastCommittedURL() == GURL(url::kAboutBlankURL));
+  }
+  bool ValidSource() const {
+    auto* frame = document_.AsRenderFrameHostIfValid();
+    return !finished_ && web_contents() && source_profile_ && destination_ &&
+        frame && frame->IsActive() &&
+        content::WebContents::FromRenderFrameHost(frame) == web_contents() &&
+        frame->GetBrowserContext() == source_profile_.get() &&
+        !source_profile_->ShutdownStarted() &&
+        !destination_->ShutdownStarted() && g_browser_process &&
+        !g_browser_process->IsShuttingDown() &&
+        barc::IsNativeApplicationRegistered() &&
+        IsOpenLinkOTREnabled(source_profile_.get(), params_.url) &&
+        !enterprise_isolated_mode::IsolatedModeReplacesIncognito(
+            source_profile_.get());
+  }
+  void Cancel() {
+    auto keep_alive = shared_from_this();
+    if (std::exchange(finished_, true)) return;
+    const bool close_original_blank = !entry_id_ || MatchesDestination();
+    Observe(nullptr);
+    callback_.Reset();
+    if (close_original_blank) barc::CloseUnusedApplicationPage(page_);
+    else barc::AbandonApplicationPageRequest(page_.tab, page_.request);
+    // A newer same-URL document is not the captured blank and must survive.
+
+  }
+  void Resume() {
+    auto keep_alive = shared_from_this();
+    if (resolving_) return;
+    if (!ValidSource() || !MatchesDestination())
+      return Cancel();
+    resolving_ = true;
+    barc::RunInApplicationBrowser(3, params_.url.spec(), page_.window, page_.tab,
+        base::BindOnce(&PendingPrivateMenuNavigation::Resolved, keep_alive));
+  }
+  void Resolved(barc::ApplicationBrowserResult result,
+                BrowserWindowInterface* browser, Profile* profile,
+                BarcApplicationTarget target) {
+    resolving_ = false;
+    if (!ValidSource() || !MatchesDestination())
+      return Cancel();
+    if (result == barc::ApplicationBrowserResult::kOpening) return;
+    if (result != barc::ApplicationBrowserResult::kReady || !browser ||
+        browser->GetSessionID().id() != page_.window ||
+        profile != destination_.get()) return Cancel();
+    auto* strip = browser->GetTabStripModel();
+    content::WebContents* blank = nullptr;
+    for (int i = 0; i < strip->count(); ++i) {
+      if (strip->GetTabAtIndex(i)->GetHandle().raw_value() == page_.tab) {
+        blank = strip->GetWebContentsAt(i);
+        break;
+      }
+    }
+    if (!blank || blank->GetBrowserContext() != profile ||
+        !MatchesDestination()) return Cancel();
+    NavigateParams navigation(browser, params_.url, params_.transition);
+    navigation.FillNavigateParamsFromOpenURLParams(params_);
+    navigation.source_contents = web_contents();
+    navigation.initiating_profile = profile;
+    SanitizeNavigationSourceForProfile(&navigation, profile);
+    // CURRENT_TAB uses source_contents as its exact destination after the
+    // shared cross-profile security sanitation has removed source metadata.
+    navigation.source_contents = blank;
+    navigation.disposition = WindowOpenDisposition::CURRENT_TAB;
+    navigation.tabstrip_add_types = AddTabTypes::ADD_NONE;
+    navigation.window_action = NavigateParams::WindowAction::kNoAction;
+    finished_ = true;
+    Observe(nullptr);
+    auto callback = std::move(callback_);
+    barc::ConsumeApplicationPage(page_.window, page_.tab, page_.request);
+    auto handle = Navigate(&navigation);
+    if (handle && callback) std::move(callback).Run(*handle);
+  }
+  void DidStartNavigation(content::NavigationHandle* handle) override {
+    if (!handle->IsSameDocument() &&
+        (handle->IsInPrimaryMainFrame() ||
+         handle->GetFrameTreeNodeId() == source_frame_)) Cancel();
+  }
+  void RenderFrameDeleted(content::RenderFrameHost* frame) override {
+    if (!document_.AsRenderFrameHostIfValid()) Cancel();
+  }
+  void WebContentsDestroyed() override { Cancel(); }
+
+  content::WeakDocumentPtr document_;
+  content::FrameTreeNodeId source_frame_;
+  base::WeakPtr<Profile> source_profile_;
+  base::WeakPtr<Profile> destination_;
+  content::OpenURLParams params_;
+  base::OnceCallback<void(content::NavigationHandle&)> callback_;
+  barc::ApplicationPage page_;
+  int entry_id_ = 0;
+  bool resolving_ = false;
+  bool finished_ = false;
+};
+#endif
