+void WebRequestProxyingURLLoaderFactory::InProgressRequest::CaptureNativeDocument() {
+  if (factory_->navigation_ui_data_) {
+    native_document_ = factory_->navigation_source_document_;
+    native_site_ = factory_->navigation_source_site_;
+    return;
+  }
+  const auto type = factory_->loader_factory_type_;
+  const bool attributable =
+      type == content::ContentBrowserClient::URLLoaderFactoryType::kDocumentSubResource ||
+      type == content::ContentBrowserClient::URLLoaderFactoryType::kWorkerSubResource ||
+      (type == content::ContentBrowserClient::URLLoaderFactoryType::kWorkerMainResource &&
+       request_.destination == network::mojom::RequestDestination::kWorker);
+  if (!attributable || !factory_->initiating_document_navigation_id_) return;
+  auto* frame = content::RenderFrameHost::FromID(
+      factory_->render_process_id_, factory_->frame_routing_id_);
+  if (!frame || frame->GetBrowserContext() != factory_->browser_context_ ||
+      frame->GetNavigationId() != *factory_->initiating_document_navigation_id_)
+    return;
+  native_document_ = frame->GetWeakDocumentPtr();
+  if (auto* contents = content::WebContents::FromRenderFrameHost(frame))
+    native_site_ = contents->GetLastCommittedURL();
+}
+
 void WebRequestProxyingURLLoaderFactory::InProgressRequest::Restart() {
   UpdateRequestInfo();
+  if (!body_observation_attempted_) {
+    body_observation_attempted_ = true;
+    if (request_.request_body && !for_cors_preflight_ &&
+        factory_->loader_factory_type_ ==
+            content::ContentBrowserClient::URLLoaderFactoryType::kDocumentSubResource &&
+        factory_->initiating_document_navigation_id_) {
+      auto* frame = content::RenderFrameHost::FromID(factory_->render_process_id_, factory_->frame_routing_id_);
+      if (frame && frame->GetNavigationId() == *factory_->initiating_document_navigation_id_ &&
+          frame->GetBrowserContext() == factory_->browser_context_) {
+        // Resolve only after the exact creating navigation has committed. A
+        // reused RFH's subsequent document is not the request's owner.
+        auto document = frame->GetWeakDocumentPtr();
+        auto weak_this = weak_factory_.GetWeakPtr();
+        auto observation = ExtensionsBrowserClient::Get()->ObserveNativeRequestBody(
+            factory_->browser_context_, document, request_.keepalive);
+        if (!weak_this) return;
+        document_body_observation_ = std::move(observation);
+      }
+    }
+  }
+
   RestartInternal();
 }
 
