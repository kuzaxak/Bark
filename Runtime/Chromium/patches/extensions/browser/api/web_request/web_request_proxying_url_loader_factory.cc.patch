+void WebRequestProxyingURLLoaderFactory::InProgressRequest::
+    ContinueWithNativePolicy(base::RepeatingCallback<void(int)> continuation,
+                             int error_code) {
+  // Extension errors remain authoritative. A requested extension redirect is
+  // handled by the existing path; its destination is checked on Restart().
+  if (error_code != net::OK || !redirect_url_.is_empty() || for_cors_preflight_ ||
+      !ExtensionsBrowserClient::Get()->HasNativeRequestPolicy(
+          factory_->browser_context_)) {
+    continuation.Run(error_code);
+    return;
+  }
+  if (proxied_client_receiver_.is_bound()) {
+    proxied_client_receiver_.Pause();
+  }
+  if (header_client_receiver_.is_bound()) {
+    header_client_receiver_.Pause();
+    is_header_client_receiver_paused_ = true;
+  }
+  ExtensionsBrowserClient::Get()->CheckNativeRequestPolicy(
+      factory_->browser_context_,
+      native_document_, native_site_, *info_,
+      base::BindOnce(
+          [](base::WeakPtr<InProgressRequest> request, int redirect_count,
+             base::RepeatingCallback<void(int)> continuation, int result) {
+            if (!request || request->num_redirects_ != redirect_count) {
+              return;
+            }
+            if (result == net::ERR_BLOCKED_BY_CLIENT &&
+                request->info_->is_navigation_request &&
+                request->info_->web_request_type == WebRequestResourceType::MAIN_FRAME) {
+              ExtensionsBrowserClient::Get()->NativeNavigationBlocked(
+                  request->factory_->browser_context_, request->native_document_,
+                  *request->info_);
+              if (!request || request->num_redirects_ != redirect_count) return;
+            }
+            continuation.Run(result);
+          },
+          weak_factory_.GetWeakPtr(), num_redirects_, std::move(continuation)));
+  // A synchronous completion can destroy this request.
+}
