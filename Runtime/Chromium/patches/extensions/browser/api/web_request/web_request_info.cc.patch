+void WebRequestInfo::EnsureRequestBodyData() {
+  if (!deferred_request_body_) return;
+  // The refcounted body stays alive through presenter use of its byte views.
+  // Move first so repeated event-detail reads never parse/copy it again.
+  network::ResourceRequest request;
+  request.request_body = std::move(deferred_request_body_);
+  std::vector<std::unique_ptr<UploadDataSource>> data_sources;
+  if (CreateUploadDataSourcesFromResourceRequest(request, &data_sources)) {
+    request_body_data = CreateRequestBodyData(method, extra_request_headers,
+                                             data_sources);
