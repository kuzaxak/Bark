+namespace {
+class RetainedClientTestFrame : public FrameView {
+ public:
+  gfx::Rect GetBoundsForClientView() const override { return GetLocalBounds(); }
+};
+
+class RetainedClientTestClient : public ClientView {
+ public:
+  RetainedClientTestClient(Widget* widget, View* contents)
+      : ClientView(widget, contents) {}
+  gfx::Size CalculatePreferredSize(const SizeBounds&) const override {
+    return gfx::Size(263, 197);
+  }
+  gfx::Size GetMinimumSize() const override { return gfx::Size(171, 183); }
+  gfx::Size GetMaximumSize() const override { return gfx::Size(901, 811); }
+  int NonClientHitTest(const gfx::Point&) override { return HTCAPTION; }
+};
+
+class UnboundClientFrameObserver : public ViewObserver {
+ public:
+  UnboundClientFrameObserver(FrameView* frame, ClientView* inactive)
+      : inactive_(inactive), observation_(this) {
+    observation_.Observe(frame);
+  }
+  void OnChildViewRemoved(View* view, View* child) override {
+    auto* frame = static_cast<FrameView*>(view);
+    EXPECT_EQ(nullptr, frame->client_view());
+    EXPECT_EQ(gfx::Size(), frame->GetPreferredSize());
+    EXPECT_EQ(gfx::Size(), frame->GetMinimumSize());
+    EXPECT_EQ(gfx::Size(), frame->GetMaximumSize());
+    EXPECT_EQ(HTNOWHERE, frame->NonClientHitTest(gfx::Point(5, 5)));
+    const gfx::Rect inactive_bounds = inactive_->bounds();
+    const gfx::Rect moved_bounds = child->bounds();
+    frame->SetBoundsRect(gfx::Rect(0, 0, 287, 219));
+    frame->DeprecatedLayoutImmediately();
+    EXPECT_EQ(inactive_bounds, inactive_->bounds());
+    EXPECT_EQ(moved_bounds, child->bounds());
+    ++removals;
+  }
+  void OnViewIsDeleting(View* view) override { observation_.Reset(); }
+  int removals = 0;
+
+ private:
+  raw_ptr<ClientView> inactive_;
+  base::ScopedObservation<View, ViewObserver> observation_;
+};
+
+class ClientFrameVisibilityObserver : public ViewObserver {
+ public:
+  explicit ClientFrameVisibilityObserver(FrameView* frame)
+      : observation_(this) {
+    observation_.Observe(frame);
+  }
+  void OnViewVisibilityChanged(View* view,
+                               View* starting_view,
+                               bool visible) override {
+    if (visible && starting_view == view) {
+      EXPECT_EQ(view->parent()->GetLocalBounds(), view->bounds());
+      ++shows;
+      if (close_on_show) {
+        view->GetWidget()->Close();
+      }
+    }
+  }
+  void OnViewIsDeleting(View* view) override { observation_.Reset(); }
+  int shows = 0;
+  bool close_on_show = false;
+
+ private:
+  base::ScopedObservation<View, ViewObserver> observation_;
+};
+}  // namespace
