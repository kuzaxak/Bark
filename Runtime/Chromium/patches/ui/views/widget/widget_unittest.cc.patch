+TEST_F(WidgetTest, RetainedClientSelectionAllowsDeferredClose) {
+  auto widget = base::WrapUnique(
+      CreateTopLevelPlatformWidget(Widget::InitParams::CLIENT_OWNS_WIDGET));
+  auto* owner = widget->non_client_view();
+  auto client = std::make_unique<ClientView>(widget.get(), new View());
+  auto* client_ptr = client.get();
+  auto frame = std::make_unique<RetainedClientTestFrame>();
+  ClientFrameVisibilityObserver shown(frame.get());
+  owner->RetainClientFrame(std::move(frame), std::move(client));
+  widget->Show();
+  shown.close_on_show = true;
+  EXPECT_TRUE(owner->SelectClientFrame(client_ptr));
+  EXPECT_EQ(1, shown.shows);
+  RunPendingMessages();
+  EXPECT_TRUE(widget->IsClosed());
+}
