+std::vector<base::WeakPtr<WidgetDelegate>> Widget::GetClientDelegates() const {
+  std::vector<base::WeakPtr<WidgetDelegate>> delegates;
+  bool selected_found = false;
+  if (non_client_view_) {
+    for (View* child : non_client_view_->children()) {
+      auto* frame = AsViewClass<FrameView>(child);
+      if (frame && frame->client_delegate_) {
+        selected_found |=
+            frame->client_delegate_.get() == widget_delegate_.get();
+        delegates.push_back(frame->client_delegate_);
+      }
+    }
+  }
+  if (widget_delegate_ && !selected_found) {
+    delegates.push_back(widget_delegate_);
+  }
+  return delegates;
+}
+
+void Widget::RetainClientFrame(std::unique_ptr<FrameView> frame,
+                               std::unique_ptr<ClientView> client,
+                               WidgetDelegate* delegate) {
+  CHECK(non_client_view_);
+  CHECK(delegate);
+  CHECK(!delegate->widget_);
+  CHECK(!delegate->owned_by_widget_);
+  auto handle = delegate->AttachWidgetAndGetHandle(this);
+  frame->client_delegate_ = handle;
+  non_client_view_->RetainClientFrame(std::move(frame), std::move(client));
+  CHECK(handle);
+  delegate->WidgetInitialized();
+}
+
+void Widget::SelectClientDelegate(WidgetDelegate* delegate) {
+  CHECK(delegate);
+  CHECK_EQ(delegate->widget_, this);
+  CHECK(!delegate->widget_initialized_callbacks_);
+  CHECK(!delegate->can_delete_this_);
+  widget_delegate_ = delegate->weak_ptr_factory_.GetWeakPtr();
+}
+
+void Widget::NotifyClientWillClose(WidgetDelegate* delegate) {
+  CHECK(delegate);
+  CHECK_EQ(delegate->widget_, this);
+  if (non_client_view_) {
+    for (View* child : non_client_view_->children()) {
+      auto* frame = AsViewClass<FrameView>(child);
+      if (frame && frame->client_delegate_.get() == delegate) {
+        if (!frame->client_will_close_notified_) {
+          frame->client_will_close_notified_ = true;
+          delegate->WindowWillClose();
+        }
+        return;
+      }
+    }
+  }
+  delegate->WindowWillClose();
+}
+
+void Widget::FinalizeClientDelegate(ClientView* client,
+                                    WidgetDelegate* delegate) {
+  CHECK(client);
+  CHECK(delegate);
+  CHECK_NE(delegate, widget_delegate_.get());
+  CHECK_EQ(delegate->widget_, this);
+  CHECK(!delegate->owned_by_widget_);
+  CHECK(!delegate->widget_initialized_callbacks_);
+  auto* frame = AsViewClass<FrameView>(client->parent());
+  CHECK(frame);
+  CHECK(!frame->GetWidget());
+  CHECK_EQ(frame->client_delegate_.get(), delegate);
+  frame->client_delegate_.reset();
+  // The caller has accepted this logical close through its beforeunload/policy
+  // gates. Preserve the requested-close callback sequence without notifying the
+  // physical Widget's other clients or running its owned-child close loop.
+  if (!frame->client_will_close_notified_) {
+    frame->client_will_close_notified_ = true;
+    delegate->WindowWillClose();
+  }
+  client->WidgetClosing();
+  delegate->WindowClosing();
+  // Clear the physical host before DeleteDelegate so the normal
+  // CLIENT_OWNS_WIDGET zombie callback cannot tear down the surviving host.
+  delegate->WidgetDestroying();
+  delegate->DeleteDelegate();
+  // DeleteDelegate may destroy the delegate; do not access it afterward.
+}
+
