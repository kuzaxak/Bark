+bool NonClientView::SelectClientFrame(ClientView* client) {
+  if (client == client_view_) {
+    return true;
+  }
+  CHECK(!switching_client_frame_);
+  auto found = std::ranges::find_if(
+      retained_frame_views_,
+      [client](const auto& frame) { return frame->client_view() == client; });
+  if (found == retained_frame_views_.end()) {
+    return false;
+  }
+  switching_client_frame_ = true;
+  // Selection does not change the hierarchy. Defensive lifetime checks avoid
+  // accessing a deleted owner after callbacks. Callbacks must still respect
+  // View focus/visibility propagation lifetimes (Close(), not CloseNow()).
+  ViewTracker alive(this);
+  auto* focus = GetWidget()->GetFocusManager();
+  if (focus && frame_view_->Contains(focus->GetFocusedView())) {
+    focus->ClearFocus();
+    if (!alive) {
+      return false;
+    }
+  }
+  auto incoming = std::move(*found);
+  retained_frame_views_.erase(found);
+  auto outgoing = std::move(frame_view_);
+  frame_view_ = std::move(incoming);
+  client_view_ = frame_view_->client_view();
+  retained_frame_views_.push_back(std::move(outgoing));
+  retained_frame_views_.back()->SetVisible(false);
+  if (!alive) {
+    return false;
+  }
+  // A retained frame may have missed a hidden-window resize. Observers must
+  // see current geometry when the incoming subtree becomes visible.
+  frame_view_->SetBoundsRect(GetLocalBounds());
+  if (!alive) {
+    return false;
+  }
+  frame_view_->SetVisible(true);
+  if (!alive) {
+    return false;
+  }
+  InvalidateLayout();
+  SchedulePaint();
+  switching_client_frame_ = false;
+  return true;
+}
