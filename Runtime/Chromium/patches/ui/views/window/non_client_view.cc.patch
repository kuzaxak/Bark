+  auto found = std::ranges::find_if(
+      retained_frame_views_,
+      [client](const auto& frame) { return frame->client_view() == client; });
+  if (found == retained_frame_views_.end()) {
+    return nullptr;
+  }
+  switching_client_frame_ = true;
+  auto released = std::move(*found);
+  retained_frame_views_.erase(found);
+  RemoveChildView(released.get());
+  switching_client_frame_ = false;
