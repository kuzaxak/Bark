 namespace download {
 
+namespace {
+bool MediaFilename(const base::FilePath& name) {
+  auto extension = name.FinalExtension();
+  if (extension.empty()) return false;
+  std::string mime;
+  return net::GetMimeTypeFromExtension(extension.substr(1), &mime) &&
+      (mime.starts_with("image/") || mime.starts_with("video/") || mime.starts_with("audio/"));
+}
+bool AcceptSocialMedia(DownloadCreateInfo& info) {
+  if (info.result != DOWNLOAD_INTERRUPT_REASON_NONE || !info.save_info) return false;
+  const std::string mime = base::ToLowerASCII(info.mime_type);
+  // Resolve Content-Disposition using Chromium's standard untrusted-filename
+  // sanitizer. A media-looking filename never makes text/html acceptable.
+  auto name = net::GenerateFileName(info.url(), info.content_disposition, "",
+      base::UTF16ToUTF8(info.save_info->suggested_name), mime, "download");
+  const bool named_media = MediaFilename(name);
+  const bool untyped = mime.empty() || mime == "application/octet-stream";
+  if (!mime.starts_with("image/") && !mime.starts_with("video/") && !(untyped && named_media)) return false;
+  if (!named_media) {
+    std::string extension;
+    if (!net::GetPreferredExtensionForMimeType(mime, &extension)) extension = "media";
+    name = name.AddExtensionASCII(extension);
+  }
+  // Our sanitized suggestion owns the filename; do not let the original
+  // Content-Disposition restore a misleading executable extension downstream.
+  info.content_disposition.clear();
+  info.save_info->suggested_name = name.AsUTF16Unsafe();
+  return true;
+}
+}
