 // NSUserInterfaceValidations protocol implementation.
 
+// AppKit text views leave undo: and redo: to the responder chain, where the
+// window's undo reaches their own undo stack. Answer them only while a views
+// text field, whose input runs through this view, is editing.
+- (BOOL)respondsToSelector:(SEL)selector {
+  if ((selector == @selector(undo:) || selector == @selector(redo:)) &&
+      self.window.firstResponder != self) {
+    return NO;
+  }
+  return [super respondsToSelector:selector];
+}
