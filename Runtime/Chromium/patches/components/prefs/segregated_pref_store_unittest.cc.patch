+// JsonPrefStore leaves IsInitializationComplete false after a failed read.
+class FailedInitializationPrefStore : public TestingPrefStore {
+ public:
+  FailedInitializationPrefStore() { set_read_success(false); }
+  bool IsInitializationComplete() const override { return false; }
+
+ protected:
+  ~FailedInitializationPrefStore() override = default;
+};
+
+class InitializationCountingObserver : public PrefStore::Observer {
+ public:
+  void OnPrefValueChanged(std::string_view) override {}
+  void OnInitializationCompleted(bool success) override {
+    completions.push_back(success);
+    if (on_completion) {
+      on_completion.Run();
+    }
+  }
+  std::vector<bool> completions;
+  base::RepeatingClosure on_completion;
+};
