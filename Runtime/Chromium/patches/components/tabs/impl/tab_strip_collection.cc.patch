+void TabStripCollection::MoveTabInSplit(split_tabs::SplitTabId split_id,
+                                        TabInterface* tab,
+                                        size_t final_index) {
+  auto* split = GetSplitTabCollection(split_id);
+  const size_t current_index = split->GetIndexOfTab(tab).value();
+  CHECK_LT(final_index, split->TabCountRecursive());
+  if (current_index == final_index) {
+    return;
+  }
+  // MoveTabImpl positions are expressed before removal of the moving child.
+  const size_t before_removal =
+      final_index + (final_index > current_index ? 1u : 0u);
+  TabCollection::Position position{split->GetHandle(), before_removal};
+  MoveTabImpl(tab, position);
 }
 
