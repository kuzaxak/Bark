+// JsonPrefStore intentionally remains uninitialized after a failed read.
+class FailedInitializationPrefStore : public TestingPrefStore {
+ public:
+  FailedInitializationPrefStore() { set_read_success(false); }
+  bool IsInitializationComplete() const override { return false; }
+
+ protected:
+  ~FailedInitializationPrefStore() override = default;
+};
