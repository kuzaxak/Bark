+// static
+base::ScopedClosureRunner PageLiveStateDecorator::ObserveDocumentRequestBody(
+    const content::WeakDocumentPtr& document) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  auto* frame = document.AsRenderFrameHostIfValid();
+  if (!frame || frame->GetLifecycleState() != content::RenderFrameHost::LifecycleState::kActive ||
+      frame->GetLastCommittedURL().is_empty() || !PerformanceManager::IsAvailable()) return {};
+  auto frame_node = PerformanceManager::GetFrameNodeForRenderFrameHost(frame);
+  if (!frame_node) return {};
+  auto data = PageLiveStateDataImpl::GetOrCreate(
+      PageNodeImpl::FromNode(frame_node->GetPageNode()))->GetWeakPtr();
+  // The weak graph attachment belongs to this frame's original page, never a
+  // later selected window or a reused RFH's replacement document.
+  data->AddObservedDocumentBodyWork();
+  return base::ScopedClosureRunner(base::BindOnce(
+      [](base::WeakPtr<PageLiveStateDataImpl> data) {
+        DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+        // Factory-map erase can run this callback from a request destructor.
+        // Notify only after that stack unwinds, without retaining either owner.
+        base::SequencedTaskRunner::GetCurrentDefault()->PostTask(
+            FROM_HERE, base::BindOnce([](base::WeakPtr<PageLiveStateDataImpl> data) {
+              if (data) data->RemoveObservedDocumentBodyWork();
+            }, data));
+      }, data));
+}
