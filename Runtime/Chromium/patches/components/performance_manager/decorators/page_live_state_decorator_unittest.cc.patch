+TEST_F(PageLiveStateDecoratorTest, ObservedDocumentBodyTokensReleaseExactlyOnce) {
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(
+      web_contents(), GURL("https://body.test/"));
+  auto page = PerformanceManager::GetPrimaryPageNodeForWebContents(web_contents());
+  ASSERT_TRUE(page);
+  auto* data = PageLiveStateDecorator::Data::GetOrCreateForPageNode(page.get());
+  const bool visible = page->IsVisible();
+  auto document = web_contents()->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  EXPECT_FALSE(data->HasObservedDocumentBodyWork());
+  auto first = PageLiveStateDecorator::ObserveDocumentRequestBody(document);
+  auto second = PageLiveStateDecorator::ObserveDocumentRequestBody(document);
+  ASSERT_TRUE(first);
+  ASSERT_TRUE(second);
+  EXPECT_TRUE(data->HasObservedDocumentBodyWork());
+  first.RunAndReset();
+  first.RunAndReset();
+  task_environment()->RunUntilIdle();
+  EXPECT_TRUE(data->HasObservedDocumentBodyWork());
+  second.RunAndReset();
+  EXPECT_TRUE(data->HasObservedDocumentBodyWork());  // Teardown never synchronously notifies.
+  task_environment()->RunUntilIdle();
+  EXPECT_FALSE(data->HasObservedDocumentBodyWork());
+  EXPECT_EQ(visible, page->IsVisible());
+  // This zero counts only observed proxy segments; no eligibility is granted.
+  EXPECT_FALSE(PageLiveStateDecorator::ObserveDocumentRequestBody(content::WeakDocumentPtr()));
+}
+
+TEST_F(PageLiveStateDecoratorTest, ObservedDocumentBodyDoesNotRetargetOrKeepPageAlive) {
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(
+      web_contents(), GURL("https://body.test/first"));
+  auto document = web_contents()->GetPrimaryMainFrame()->GetWeakDocumentPtr();
+  auto first = PageLiveStateDecorator::ObserveDocumentRequestBody(document);
+  ASSERT_TRUE(first);
+  content::NavigationSimulator::NavigateAndCommitFromBrowser(
+      web_contents(), GURL("https://other.test/second"));
+  auto replacement = PerformanceManager::GetPrimaryPageNodeForWebContents(web_contents());
+  ASSERT_TRUE(replacement);
+  auto* data = PageLiveStateDecorator::Data::GetOrCreateForPageNode(replacement.get());
+  EXPECT_FALSE(data->HasObservedDocumentBodyWork());
+  EXPECT_FALSE(PageLiveStateDecorator::ObserveDocumentRequestBody(document));
+  first.RunAndReset();
+  task_environment()->RunUntilIdle();
+  EXPECT_FALSE(data->HasObservedDocumentBodyWork());
+  auto live = PageLiveStateDecorator::ObserveDocumentRequestBody(
+      web_contents()->GetPrimaryMainFrame()->GetWeakDocumentPtr());
+  ASSERT_TRUE(live);
+  live.RunAndReset();
+  DeleteObservedWebContents();
+  task_environment()->RunUntilIdle();
+}
