+#if BUILDFLAG(IS_MAC)
+TEST_F(FreezerTest, NativeUnknownWorkBlocksDirectFreezeButAllowsUnfreeze) {
+  base::test::ScopedCommandLine command;
+  command.GetProcessCommandLine()->AppendSwitch("barc-native-shell");
+  SetContents(CreateTestWebContents());
+  auto* tester = content::WebContentsTester::For(web_contents());
+  tester->NavigateAndCommit(GURL(kUrl));
+  web_contents()->WasHidden();
+  MaybeFreezePageNode(web_contents());
+  EXPECT_TRUE(tester->IsPageFrozen());
+  command.GetProcessCommandLine()->AppendSwitch("barc-shared-native-window");
+  UnfreezePageNode(web_contents());
+  EXPECT_FALSE(tester->IsPageFrozen());
+  MaybeFreezePageNode(web_contents());
+  EXPECT_FALSE(tester->IsPageFrozen());
+  EXPECT_EQ(content::Visibility::HIDDEN, web_contents()->GetVisibility());
+}
+#endif
