+std::optional<GURL> RenderFrameHostImpl::GetCurrentOrPendingCommitDocumentURL(
+    const blink::DocumentToken& document) const {
+  for (const auto& request : navigation_requests_) {
+    const auto& expected = request.first->IsPageActivation()
+        ? GetDocumentTokenIgnoringSafetyRestrictions()
+        : request.first->GetDocumentToken();
+    // A reused active RFH already has the incoming token while its last URL
+    // is still outgoing. Return only that token's actual pending URL.
+    if (expected == document) return request.first->GetURL();
+  }
+  if ((lifecycle_state() == LifecycleStateImpl::kActive ||
+       lifecycle_state() == LifecycleStateImpl::kPrerendering ||
+       lifecycle_state() == LifecycleStateImpl::kInBackForwardCache) &&
+      GetDocumentToken() == document)
+    return GetLastCommittedURL();
+  return std::nullopt;
+}
