+  auto alive = weak_factory_.GetWeakPtr();
+  cosmetic_policy_changed_.Notify(policy_revision_);
+  if (!alive) return;
   latest_install_->fetch_add(1);
   policy_subscription_ = {};
   weak_factory_.InvalidateWeakPtrs();
