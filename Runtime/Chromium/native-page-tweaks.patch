+  v8::HandleScope handles(isolate);
+  auto allowed = frame->ExecuteScriptAndReturnValue(
+      blink::WebScriptSource(blink::WebString::FromUtf8("true")));
+  if (!alive) return blink::WebLocalFrame::FromFrameToken(frame_token) != nullptr;
+  frame = blink::WebLocalFrame::FromFrameToken(frame_token);
+  if (!frame || frame->GetDocument().Token() != document) return frame != nullptr;
+  if (allowed.IsEmpty() || !allowed->IsTrue()) return true;
+  auto resource = [](int id) { return ui::ResourceBundle::GetSharedInstance().LoadDataResourceString(id); };
+  if (config->facebook_reels || config->facebook_suggested) {
+    const std::string source = "(()=>{const f=window.__nookFBFilter=window.__nookFBFilter||{};f.reels=" +
+        std::string(config->facebook_reels ? "true" : "false") + ";f.suggested=" +
+        std::string(config->facebook_suggested ? "true" : "false") + ";\n" +
+        resource(IDR_NOOK_FACEBOOK_TWEAKS) + "\n})()";
+    // Facebook's JSON.parse hook must precede the first page inline script.
+    frame->ExecuteScript(blink::WebScriptSource(blink::WebString::FromUtf8(source)));
+    if (!alive) return blink::WebLocalFrame::FromFrameToken(frame_token) != nullptr;
+    frame = blink::WebLocalFrame::FromFrameToken(frame_token);
+    if (!frame || frame->GetDocument().Token() != document) return frame != nullptr;
+  }
+  std::string source;
+  if (!config->youtube_css.empty() || config->youtube_frames || config->youtube_no_hover) {
+    base::DictValue options;
+    options.Set("css", config->youtube_css);
+    options.Set("frameThumbnails", config->youtube_frames);
+    options.Set("noHoverPreview", config->youtube_no_hover);
+    source += "(" + resource(IDR_NOOK_YOUTUBE_TWEAKS) + ")(" +
+        base::WriteJson(options).value_or("{}") + ");\n";
+  }
+  if (config->reddit_hot) source += resource(IDR_NOOK_REDDIT_TWEAKS);
+  if (!source.empty()) {
+    auto context = frame->MainWorldScriptContext();
+    if (!context.IsEmpty()) {
+      v8::Context::Scope entered(context);
+      v8::Local<v8::Function> gate;
+      if (gin::CreateFunctionTemplate(isolate, base::BindRepeating(
+          [](base::WeakPtr<ChromeRenderFrameObserver> self, blink::DocumentToken document,
+             std::string source) {
+            if (!self || self->nook_page_tweaks_document_ != document || !self->nook_page_tweaks_) return;
+            auto* frame = self->render_frame()->GetWebFrame();
+            if (!frame || frame->GetDocument().Token() != document ||
+                !self->render_frame()->GetBlinkPreferences().javascript_enabled ||
+                (frame->GetContentSettings() && !frame->GetContentSettings()->allow_script)) return;
+            const auto frame_token = frame->GetLocalFrameToken();
+            auto alive = self->nook_page_tweaks_weak_.GetWeakPtr();
+            auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+            v8::HandleScope handles(isolate);
+            auto allowed = frame->ExecuteScriptAndReturnValue(
+                blink::WebScriptSource(blink::WebString::FromUtf8("true")));
+            if (!alive || allowed.IsEmpty() || !allowed->IsTrue()) return;
+            frame = blink::WebLocalFrame::FromFrameToken(frame_token);
+            if (!frame || frame->GetDocument().Token() != document) return;
+            // This gate just resumed through Blink. Submit synchronously: the
+            // isolated API alone otherwise bypasses the page's script policy.
+            const blink::WebScriptSource script(blink::WebString::FromUtf8(source));
+            frame->RequestExecuteScript(ISOLATED_WORLD_ID_NOOK_PAGE_TWEAKS,
+                base::span_from_ref(script), blink::mojom::UserActivationOption::kDoNotActivate,
+                blink::mojom::EvaluationTiming::kSynchronous,
+                blink::mojom::LoadEventBlockingOption::kDoNotBlock, {}, blink::BackForwardCacheAware::kAllow,
+                blink::mojom::WantResultOption::kNoResult, blink::mojom::PromiseResultOption::kDoNotWait, {});
+          }, alive, document, source))->GetFunction(context).ToLocal(&gate))
+        frame->RequestExecuteV8Function(context, gate, v8::Undefined(isolate), 0, nullptr, {});
+    }
+  }
+  return blink::WebLocalFrame::FromFrameToken(frame_token) != nullptr;
+#else
+  return true;
+#endif
+}
+
+void ChromeRenderFrameObserver::RunNookBoostScriptsAfterLoad() {
+#if BUILDFLAG(IS_MAC)
+  if (!nook_page_tweaks_ || !nook_page_tweaks_document_ || nook_boost_script_next_.has_value() ||
+      nook_page_tweaks_->boost_scripts.empty()) return;
+  nook_boost_script_next_ = 0;
+  RunNookBoostScript(0);
+#endif
+}
+
+void ChromeRenderFrameObserver::RunNookBoostScript(size_t index) {
+#if BUILDFLAG(IS_MAC)
+  if (!nook_page_tweaks_ || !nook_page_tweaks_document_ ||
+      nook_boost_script_next_ != index || index >= nook_page_tweaks_->boost_scripts.size()) return;
+  auto* frame = render_frame()->GetWebFrame();
+  const auto document = *nook_page_tweaks_document_;
+  if (!frame || frame->GetDocument().Token() != document || !render_frame()->IsMainFrame()) return;
+  auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handles(isolate);
+  auto context = frame->MainWorldScriptContext();
+  if (context.IsEmpty()) return;
+  v8::Context::Scope entered(context);
+  v8::Local<v8::Function> gate;
+  if (!gin::CreateFunctionTemplate(isolate, base::BindRepeating(
+      [](base::WeakPtr<ChromeRenderFrameObserver> self, blink::DocumentToken document, size_t index) {
+        if (self && self->nook_page_tweaks_document_ == document) self->ExecuteNookBoostScript(index);
+      }, nook_page_tweaks_weak_.GetWeakPtr(), document, index))->GetFunction(context).ToLocal(&gate)) return;
+  // The scoped main-world gate is never exported or passed to user code.
+  frame->RequestExecuteV8Function(context, gate, v8::Undefined(isolate), 0, nullptr, {});
+#endif
+}
+
+void ChromeRenderFrameObserver::ExecuteNookBoostScript(size_t index) {
+#if BUILDFLAG(IS_MAC)
+  if (!nook_page_tweaks_ || !nook_page_tweaks_document_ ||
+      nook_boost_script_next_ != index || index >= nook_page_tweaks_->boost_scripts.size()) return;
+  auto* frame = render_frame()->GetWebFrame();
+  const auto document = *nook_page_tweaks_document_;
+  if (!frame || frame->GetDocument().Token() != document || !render_frame()->IsMainFrame()) return;
+  const auto& settings = frame->GetContentSettings();
+  if (!render_frame()->GetBlinkPreferences().javascript_enabled || (settings && !settings->allow_script)) return;
+  const auto frame_token = frame->GetLocalFrameToken();
+  auto alive = nook_page_tweaks_weak_.GetWeakPtr();
+  auto* isolate = frame->GetAgentGroupScheduler()->Isolate();
+  v8::HandleScope handles(isolate);
+  auto allowed = frame->ExecuteScriptAndReturnValue(
+      blink::WebScriptSource(blink::WebString::FromUtf8("true")));
+  if (!alive || allowed.IsEmpty() || !allowed->IsTrue()) return;
+  frame = blink::WebLocalFrame::FromFrameToken(frame_token);
+  if (!frame || frame->GetDocument().Token() != document) return;
+  // One async body at a time, as WK callAsyncJavaScript. No native binding is
+  // installed in this separate user-code world. Blink owns the awaited reply.
+  const std::string source = "(async()=>{try{\n" + nook_page_tweaks_->boost_scripts[index] +
+      "\n}catch(e){console.error('Nook Boost script:',e)}})()";
+  const blink::WebScriptSource script(blink::WebString::FromUtf8(source));
+  nook_boost_script_next_ = index + 1;
+  frame->RequestExecuteScript(ISOLATED_WORLD_ID_NOOK_BOOST_SCRIPTS,
+      base::span_from_ref(script), blink::mojom::UserActivationOption::kDoNotActivate,
+      blink::mojom::EvaluationTiming::kSynchronous,
+      blink::mojom::LoadEventBlockingOption::kDoNotBlock,
+      base::BindOnce([](base::WeakPtr<ChromeRenderFrameObserver> self,
+          blink::DocumentToken document, size_t next, std::optional<base::Value>, base::TimeTicks) {
+        if (!self || self->nook_page_tweaks_document_ != document) return;
+        self->RunNookBoostScript(next);
+      }, nook_page_tweaks_weak_.GetWeakPtr(), document, index + 1),
+      blink::BackForwardCacheAware::kAllow, blink::mojom::WantResultOption::kNoResult,
+      blink::mojom::PromiseResultOption::kAwait, {});
+#endif
+}
