+extern "C" int barc_page_tweaks_publish(const uint8_t* json, size_t length) {
+  if (!content::BrowserThread::CurrentlyOn(content::BrowserThread::UI) ||
+      !PolicyOwner().registered || PolicyOwner().stopped) return 0;
