diff --git a/build/toolchain/apple/toolchain.gni b/build/toolchain/apple/toolchain.gni
--- a/build/toolchain/apple/toolchain.gni
+++ b/build/toolchain/apple/toolchain.gni
@@ -29,6 +29,9 @@
 assert((target_os == "ios" && host_os == "mac") || host_os != "win")
 
 declare_args() {
+  # Feasibility-only opt-in. Keep normal macOS toolchains Swift-free.
+  barc_enable_mac_swift_smoke = false
+
   # This controls whether whole module optimization is enabled when building
   # Swift modules. If enabled, the compiler will compile the module as one
   # unit, generating just one single object file. Otherwise, it will generate
@@ -763,10 +766,10 @@
       pool = "//build/toolchain/apple:bundle_pool($default_toolchain)"
     }
 
-    # Swift is only used on iOS, not macOS. We want to minimize the number
-    # of Xcode-based tools used by the macOS toolchain, so we intentionally
-    # disallow future uses of Swift on macOS. https://crbug.com/965663.
-    if (toolchain_args.current_os == "ios") {
+    # Preserve the iOS tool; enable the same wrapper on macOS only for the
+    # explicit Barc SwiftUI feasibility target.
+    if (toolchain_args.current_os == "ios" ||
+        (toolchain_args.current_os == "mac" && barc_enable_mac_swift_smoke)) {
       tool("swift") {
         _tool = rebase_path("//build/toolchain/apple/swiftc.py", root_build_dir)
 
@@ -850,11 +853,20 @@
           _env_vars += " XCODE_VERSION=${toolchain_args.xcode_build}"
         }
 
-        if (invoker.sdk_developer_dir != "") {
+        if (defined(invoker.sdk_developer_dir) &&
+            invoker.sdk_developer_dir != "") {
           _env_vars += " DEVELOPER_DIR=${toolchain_args.sdk_developer_dir}"
         }
 
-        if (swift_toolchain_path != "") {
+        if (toolchain_args.current_os == "mac") {
+          # bin_path is selected by mac_sdk.gni, relative to root_build_dir
+          # for hermetic Xcode. Never fall back to an unrelated /usr/bin/swiftc.
+          _mac_swift_toolchain =
+              rebase_path("${invoker.bin_path}/../..", "", root_build_dir)
+          _extra_flags += " --swift-toolchain-path " +
+                          rebase_path(_mac_swift_toolchain, root_build_dir)
+          _env_vars += " XCODE_VERSION=$xcode_build"
+        } else if (swift_toolchain_path != "") {
           _extra_flags += " --swift-toolchain-path " +
                           rebase_path(swift_toolchain_path, root_build_dir)
         }
diff --git a/build/config/apple/swift_source_set.gni b/build/config/apple/swift_source_set.gni
--- a/build/config/apple/swift_source_set.gni
+++ b/build/config/apple/swift_source_set.gni
@@ -274,7 +274,12 @@
     if (!defined(public_configs)) {
       public_configs = []
     }
-    public_configs += [ "//build/config/ios:swift_cxx_interop_includes" ]
+    if (is_ios) {
+      public_configs += [ "//build/config/ios:swift_cxx_interop_includes" ]
+    } else {
+      assert(is_mac && barc_enable_mac_swift_smoke)
+      public_configs += [ "//build/config/mac:barc_swiftui_smoke_headers" ]
+    }
   }
 }
 
diff --git a/build/config/mac/BUILD.gn b/build/config/mac/BUILD.gn
--- a/build/config/mac/BUILD.gn
+++ b/build/config/mac/BUILD.gn
@@ -7,6 +7,7 @@
 import("//build/config/c++/c++.gni")
 import("//build/config/mac/mac_sdk.gni")
 import("//build/config/sysroot.gni")
+import("//build/toolchain/apple/toolchain.gni")
 import("//build/toolchain/rbe.gni")
 import("//build/toolchain/siso.gni")
 
@@ -123,3 +124,32 @@
     }
   }
 }
+
+# Opt-in feasibility Swift module; the default mac compiler/link flags above
+# are unchanged. All paths come from the same selected SDK/Xcode as Chromium.
+if (barc_enable_mac_swift_smoke) {
+  config("barc_swiftui_smoke_compile") {
+    _archs = archs_mapping[current_os]
+    _cpu = _archs[current_cpu]
+    _arch = _cpu.clang_arch
+    swiftflags = [
+      "-target",
+      "$_arch-apple-macos$mac_deployment_target",
+      "-sdk",
+      rebase_path(mac_sdk_path, root_build_dir),
+    ]
+  }
+
+  config("barc_swiftui_smoke_headers") {
+    _toolchain = rebase_path("${mac_bin_path}/../..", "", root_build_dir)
+    include_dirs = [ "$_toolchain/usr/lib/swift" ]
+  }
+
+  config("barc_swiftui_smoke_link") {
+    _toolchain = rebase_path("${mac_bin_path}/../..", "", root_build_dir)
+    lib_dirs = [
+      "$mac_sdk_path/usr/lib/swift",
+      "$_toolchain/usr/lib/swift/macosx",
+    ]
+  }
+}
