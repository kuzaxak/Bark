+            AppController* controller = weak_controller;
+            if (!controller) {
+              return;
+            }
+            if (result == barc::ApplicationBrowserResult::kOpening) {
+              [controller deferNativeStartupTabs:std::move(batch)];
+              controller->_barcResolvingURL = false;
