 namespace {

+bool CanUseNativeApplicationProfile(Profile* profile) {
+  if (!profile) {
+    return false;
+  }
+  if (profile->IsRegularProfile() &&
+      IncognitoModePrefs::GetAvailability(profile) ==
+          policy::IncognitoModeAvailability::kForced) {
+    LOG(WARNING) << "Native application forced-private launch is unavailable";
+    return false;  // Never create an unowned stock primary OTR as a side
+                   // effect.
+  }
+  return [AppController.sharedController safeProfileForNewWindows:profile] ==
+         profile;
+}
+void OpenNativeApplicationTabs(StartupTabs tabs) {
+  [AppController.sharedController openNativeApplicationTabs:std::move(tabs)];
+}
+
+void OpenNativeApplicationWindow(int32_t kind) {
+  barc::RunInApplicationBrowser(
+      kind,
+      base::BindOnce(
+          [](int32_t kind, barc::ApplicationBrowserResult result,
+             BrowserWindowInterface* browser, Profile* profile) {
+            if (result != barc::ApplicationBrowserResult::kReady ||
+                !CanUseNativeApplicationProfile(profile)) {
+              return;
+            }
+            if (kind == 2 && browser) {
+              browser->GetWindow()->Show();  // Only the admitted model owner.
+              return;
+            }
+            // NewEmptyWindow preserves this Guest parent's exact primary OTR.
+            chrome::NewEmptyWindow(profile);
+          },
+          kind));
+}
