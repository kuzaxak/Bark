+      return container->contents_view()->web_contents() == page;
+    });
+    if (it == remaining.end()) {
+      it = std::ranges::find_if(remaining, [&contents](const auto& container) {
+        return !std::ranges::contains(contents,
+            container->contents_view()->web_contents());
+      });
