+split_tabs::SplitTabId TabStripModel::SetSplit(
+    const std::vector<tabs::TabInterface*>& ordered_tabs,
+    tabs::TabInterface* active_tab,
+    const split_tabs::SplitTabVisualData& visual_data) {
+  ReentrancyCheck reentrancy_check(&reentrancy_guard_);
+  CHECK_GE(ordered_tabs.size(), 2u);
+  CHECK_LE(ordered_tabs.size(), split_tabs::SplitTabVisualData::kMaxPanes);
+  CHECK_EQ(visual_data.pane_count(), ordered_tabs.size());
+  CHECK(std::ranges::contains(ordered_tabs, active_tab));
+  std::set<tabs::TabInterface*> unique_tabs;
+  std::set<split_tabs::SplitTabId> previous_splits;
+  for (auto* tab : ordered_tabs) {
+    CHECK_NE(GetIndexOfTab(tab), kNoTab);
+    CHECK(unique_tabs.insert(tab).second);
+    if (tab->GetSplit()) {
+      previous_splits.insert(*tab->GetSplit());
+    }
+  }
+  std::optional<split_tabs::SplitTabId> retained;
+  if (previous_splits.size() == 1) {
+    const auto id = *previous_splits.begin();
+    const auto existing = GetSplitData(id)->ListTabs();
+    if (existing.size() == unique_tabs.size() &&
+        std::ranges::all_of(existing, [&unique_tabs](auto* tab) {
+          return unique_tabs.contains(tab);
+        })) {
+      retained = id;
+    }
+  }
+  const auto split_id = retained.value_or(split_tabs::SplitTabId::GenerateNew());
+  if (!retained) {
+    for (auto previous : previous_splits) {
+      RemoveSplitImpl(previous,
+          SplitTabChange::SplitTabRemoveReason::kSplitTabUpdated);
+    }
+    std::vector<int> indices;
+    for (auto* tab : ordered_tabs) {
+      indices.push_back(GetIndexOfTab(tab));
+    }
+    const int pivot = indices.front();
+    std::ranges::sort(indices);
+    AddToSplitImpl(split_id, indices, pivot, visual_data,
+                   SplitTabChange::SplitTabAddReason::kNewSplitTabAdded);
+  }
+  const int first = GetSplitData(split_id)->GetIndexRange().start();
+  for (size_t i = 0; i < ordered_tabs.size(); ++i) {
+    auto* tab = ordered_tabs[i];
+    MoveTabToIndexImpl(GetIndexOfTab(tab), first + i, tab->GetGroup(),
+                       tab->IsPinned(), false);
+  }
+  auto* data = GetSplitData(split_id);
+  const auto old_data = *data->visual_data();
+  *data->visual_data() = visual_data;
+  if (old_data != visual_data) {
+    NotifySplitTabVisualsChanged(split_id, old_data, visual_data,
+        SplitTabChange::SplitVisualChangeReason::kLayoutUpdated);
+  }
+  auto selection = selection_model_;
+  SetSelectedTab(selection, active_tab);
+  SetSelection(selection, TabStripModelObserver::CHANGE_REASON_NONE, false);
+  return split_id;
