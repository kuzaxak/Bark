+void MultiContentsView::OnResizeDivider(size_t divider,
+                                         int resize_amount,
+                                         bool done_resizing) {
+  // Hiding a resize handle after pane removal can complete its old capture.
+  // That stale completion must not index a now-smaller split or mutate it.
+  if (!IsInSplitView() || divider >= visual_data_.split_dividers().size()) {
+    initial_start_size_on_resize_.reset();
+    resizing_divider_.reset();
+    return;
+  }
+  int total_size = 0;
+  int boundary = 0;
+  for (size_t i = 0; i < GetPaneCount(); ++i) {
+    const int size = GetResizeAxisComponent(contents_container_views_[i]->size());
+    total_size += size;
+    if (i <= divider) {
+      boundary += size;
+    }
+  }
+  if (total_size <= 0) {
+    return;
+  }
+  if (resizing_divider_ != divider || !initial_start_size_on_resize_) {
+    resizing_divider_ = divider;
+    initial_start_size_on_resize_ = boundary;
+  }
+  std::array<double, split_tabs::SplitTabVisualData::kMaxPanes - 1> storage{};
+  auto dividers = base::span(storage).first(
+      visual_data_.split_dividers().size());
+  dividers.copy_from(visual_data_.split_dividers());
+  const double lower = divider == 0 ? 0 : dividers[divider - 1];
+  const double upper = divider + 1 == dividers.size() ? 1
+                                                    : dividers[divider + 1];
+  const double min_fraction = std::min(50.0 / total_size,
+                                        (upper - lower) / 2);
+  const double next = CalculateRatioWithSnapPoints(
+      *initial_start_size_on_resize_ + resize_amount, total_size);
+  dividers[divider] = std::clamp(next, lower + min_fraction,
+                                upper - min_fraction);
+  views::ViewTracker alive(this);
+  if (dividers.size() == 1) {
+    delegate_->ResizeWebContents(dividers.front(), done_resizing);
+  } else {
+    delegate_->ResizeDividers(dividers, done_resizing);
+  }
+  if (!alive)
+    return;
+  if (!IsInSplitView() || divider >= visual_data_.split_dividers().size()) {
+    initial_start_size_on_resize_.reset();
+    resizing_divider_.reset();
+    return;
+  }
   if (done_resizing) {
