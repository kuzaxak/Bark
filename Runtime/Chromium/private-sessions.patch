+bool ChromeExtensionRegistrarDelegate::CanAddExtension(
+    const Extension* extension) {
+  // External/policy installs and themes must not use ShouldAlwaysLoad's
+  // exemptions. Only built-in components (e.g. PDF) enter a private session.
+  return !ProfileManager::IsPrivateSessionProfilePath(profile_->GetPath()) ||
+         extension->location() == mojom::ManifestLocation::kComponent;
+}
+
 bool ChromeExtensionRegistrarDelegate::CanEnableExtension(
     const Extension* extension) {
+  if (!CanAddExtension(extension)) {
+    return false;
+  }
   CHECK(system_->management_policy());
   return !system_->management_policy()->MustRemainDisabled(extension, nullptr);
 }
