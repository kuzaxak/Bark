+bool BrowserWidget::PresentBarcTabs(
+    base::span<tabs::TabInterface* const> panes,
+    const split_tabs::SplitTabVisualData& visual_data,
+    tabs::TabInterface* active) {
+  return PresentBarcTabsImpl(panes, visual_data, active, nullptr);
+}
+
+bool BrowserWidget::PresentBarcTabsImpl(
+    base::span<tabs::TabInterface* const> panes,
+    const split_tabs::SplitTabVisualData& visual_data,
+    tabs::TabInterface* active,
+    uint64_t* created_generation) {
+  if (created_generation) {
+    *created_generation = 0;
+  }
+#if !BUILDFLAG(IS_MAC)
+  return false;
+#else
+  auto mutation = barc::ProtectNativeViewMutation();
+  if (!barc::IsNativeApplicationRegistered() || IsClosed() ||
+      changing_barc_presentation_ || barc_presented_contents_ ||
+      panes.size() < 2 || panes.size() > split_tabs::SplitTabVisualData::kMaxPanes ||
+      visual_data.pane_count() != panes.size() ||
+      !std::ranges::contains(panes, active)) {
+    return false;
+  }
+  std::vector<ContentsContainerView*> containers;
+  for (auto* tab : panes) {
+    if (!tab || !tab->GetBrowserWindowInterface()) {
+      return false;
+    }
+    auto* owner = BrowserView::GetBrowserViewForBrowser(tab->GetBrowserWindowInterface());
+    if (!owner || owner->browser_widget() != this ||
+        owner->GetProfile()->IsOffTheRecord() ||
+        owner->browser()->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL ||
+        owner->browser()->IsDeleteScheduled()) {
+      return false;
+    }
+    auto* container = owner->GetContentsContainerViewFor(tab->GetContents());
+    if (!container || container->parent() != owner->multi_contents_view() ||
+        container->browser_view() != owner ||
+        std::ranges::contains(containers, container)) {
+      return false;
+    }
+    containers.push_back(container);
+  }
+  if (!selected_browser_view() || !active->IsActivated() ||
+      active->GetBrowserWindowInterface() != selected_browser_view()->browser()) {
+    return false;
+  }
+  auto alive = GetWeakPtr();
+  auto active_tab = active->GetWeakPtr();
+  const size_t active_index = std::ranges::find(panes, active) - panes.begin();
+  std::vector<base::WeakPtr<tabs::TabInterface>> requested;
+  std::vector<base::WeakPtr<BrowserView>> owners;
+  std::vector<std::unique_ptr<views::ViewTracker>> tracked_containers;
+  for (size_t i = 0; i < panes.size(); ++i) {
+    requested.push_back(panes[i]->GetWeakPtr());
+    owners.push_back(containers[i]->browser_view()->GetAsWeakPtr());
+    tracked_containers.push_back(
+        std::make_unique<views::ViewTracker>(containers[i]));
+  }
+  changing_barc_presentation_ = true;
+  base::ScopedClosureRunner reset_changing(base::BindOnce(
+      [](base::WeakPtr<views::Widget> widget) {
+        if (widget) {
+          static_cast<BrowserWidget*>(widget.get())->changing_barc_presentation_ = false;
+        }
+      }, alive));
+  // Clear must return borrowed panes immediately, but cannot destroy their
+  // physical parent inside AddChildView callbacks. Stack ownership also survives
+  // nested run loops and destruction of this Widget.
+  auto retirement = std::make_shared<std::unique_ptr<MultiContentsView>>();
+  barc_presentation_retirement_ = retirement;
+  auto presentation = std::make_unique<MultiContentsView>(
+      std::make_unique<BarcPresentedContentsDelegate>(this));
+  presentation->SetVisible(false);
+  views::ViewTracker mounted(presentation.get());
+  // Hierarchy callbacks may destroy the host even before any pane is borrowed.
+  // Do not assign a member through a destroyed host after AddChildView returns.
+  non_client_view()->AddChildView(std::move(presentation));
+  if (!alive || !mounted || mounted.view()->parent() != non_client_view()) {
+    return false;
+  }
+  barc_presented_contents_ = static_cast<MultiContentsView*>(mounted.view());
+  CHECK_NE(++barc_presentation_generation_, 0u);
+  if (created_generation) {
+    *created_generation = barc_presentation_generation_;
+  }
+  bool inputs_survive = active_tab && active_tab->IsActivated() &&
+      selected_browser_view() &&
+      active_tab->GetBrowserWindowInterface() == selected_browser_view()->browser();
+  for (size_t i = 0; inputs_survive && i < requested.size(); ++i) {
+    inputs_survive = requested[i] && owners[i] && tracked_containers[i]->view() &&
+        owners[i]->browser_widget() == this &&
+        requested[i]->GetBrowserWindowInterface() == owners[i]->browser() &&
+        containers[i]->parent() == owners[i]->multi_contents_view() &&
+        containers[i]->contents_view()->web_contents() == requested[i]->GetContents();
+  }
+  if (!inputs_survive) {
+    ClearBarcPresentedTabs();
+    return false;
+  }
+  for (const auto& tab : requested) {
+    barc_presented_tabs_.push_back(tab);
+    // Return borrowed containers before tab removal/discard can tear down their
+    // original feature/modal ownership. Close cancellation leaves them mounted.
+    barc_presented_subscriptions_.push_back(tab->RegisterWillDetach(
+        base::BindRepeating([](base::WeakPtr<views::Widget> widget,
+                               tabs::TabInterface*, tabs::TabInterface::DetachReason) {
+          if (widget) {
+            static_cast<BrowserWidget*>(widget.get())->ClearBarcPresentedTabs();
+          }
+        }, alive)));
+    barc_presented_subscriptions_.push_back(tab->RegisterWillDiscardContents(
+        base::BindRepeating([](base::WeakPtr<views::Widget> widget,
+                               tabs::TabInterface*, content::WebContents*, content::WebContents*) {
+          if (widget) {
+            static_cast<BrowserWidget*>(widget.get())->ClearBarcPresentedTabs();
+          }
+        }, alive)));
+  }
+  for (auto* container : containers) {
+    if (!barc_presented_contents_->AddPresentedContainer(container)) {
+      if (alive) {
+        ClearBarcPresentedTabs();
+      }
+      return false;
+    }
+    if (!alive || !mounted || barc_presented_contents_ != mounted.view()) {
+      return false;
+    }
+  }
+  for (auto* container : containers) {
+    container->browser_view()->multi_contents_view()->HideUnpresentedOwnerContainers();
+    if (!alive || !mounted || barc_presented_contents_ != mounted.view()) {
+      return false;
+    }
+  }
+  barc_presented_contents_->ShowSplitView(visual_data);
+  if (!alive || !mounted || barc_presented_contents_ != mounted.view()) {
+    return false;
+  }
+  barc_presented_contents_->SetActiveIndex(active_index);
+  if (!alive || !mounted || barc_presented_contents_ != mounted.view()) {
+    return false;
+  }
+  LayoutBarcPresentedContents();
+  if (!alive || !mounted || barc_presented_contents_ != mounted.view()) {
+    return false;
+  }
+  UpdateBarcPresentedScreenshotPolicy();
+  if (!alive || !mounted || barc_presented_contents_ != mounted.view()) {
+    return false;
+  }
+  barc_presented_contents_->SetVisible(true);
+  if (!alive || !mounted || barc_presented_contents_ != mounted.view()) {
+    return false;
+  }
+  reset_changing.RunAndReset();
+#if BUILDFLAG(IS_MAC)
+  barc::BrowserDiscoveryChanged();
+#endif
+  if (!alive || !mounted || !active_tab || !selected_browser_view() ||
+      barc_presented_contents_ != mounted.view() ||
+      mounted.view()->parent() != non_client_view() ||
+      selected_browser_view()->browser() != active_tab->GetBrowserWindowInterface() ||
+      barc_presented_contents_->GetActiveContentsView()->web_contents() != active_tab->GetContents() ||
+      barc_presented_tabs_.size() != requested.size()) {
+    return false;
+  }
+  for (size_t i = 0; i < requested.size(); ++i) {
+    if (!requested[i] || barc_presented_tabs_[i].get() != requested[i].get() ||
+        containers[i]->parent() != barc_presented_contents_) {
+      return false;
+    }
+  }
+  return true;
+#endif
+}
+
+bool BrowserWidget::RestoreBarcOwnerContents(BrowserView* owner) {
+  if (IsClosed() || !owner || owner->browser_widget() != this || owner->browser()->IsDeleteScheduled()) {
+    return false;
+  }
+  auto alive = GetWeakPtr();
+  auto owner_alive = owner->GetAsWeakPtr();
+  for (const auto& container : owner->GetContentsContainerViews()) {
+    if (container->parent() != owner->multi_contents_view()) {
+      // A newer physical presentation owns this container; never remap it.
+      return false;
+    }
+  }
+  auto* tab = owner->browser()->GetTabStripModel()->GetActiveTab();
+  if (!tab) {
+    return false;
+  }
+  auto active = tab->GetWeakPtr();
+  if (tab->GetSplit()) {
+    owner->ShowSplitView(false);
+  } else {
+    auto* local = owner->multi_contents_view();
+    local->CloseSplitView();
+    if (!alive || !owner_alive || !active ||
+        owner_alive->browser()->GetTabStripModel()->GetActiveTab() != active.get()) {
+      return false;
+    }
+    local->SetWebContentsAtIndex(active->GetContents(), 0);
+    if (!alive || !owner_alive || !active) {
+      return false;
+    }
+    local->contents_container_views()[0]->SetVisible(true);
+    if (!alive || !owner_alive || !active) {
+      return false;
+    }
+    local->SetActiveIndex(0);
+  }
+  return alive && owner_alive && active &&
+      owner_alive->browser()->GetTabStripModel()->GetActiveTab() == active.get();
+}
+
+bool BrowserWidget::SetBarcPresentedTabs(
+    base::span<tabs::TabInterface* const> panes,
+    const split_tabs::SplitTabVisualData& visual_data,
+    tabs::TabInterface* active) {
+#if !BUILDFLAG(IS_MAC)
+  return false;
+#else
+  if (!barc::IsNativeApplicationRegistered() || changing_barc_presentation_ ||
+      clearing_barc_presentation_ || IsClosed() ||
+      panes.size() < 2 || panes.size() > 4 || !selected_browser_view() ||
+      !active || !active->IsActivated() ||
+      active->GetBrowserWindowInterface() != selected_browser_view()->browser() ||
+      !std::ranges::contains(panes, active) || visual_data.pane_count() != panes.size()) {
+    return false;
+  }
+  auto mutation = barc::ProtectNativeViewMutation();
+  auto alive = GetWeakPtr();
+  const uint64_t selection = barc_selection_epoch_;
+  const uint64_t generation_before = barc_presentation_generation_;
+  std::vector<base::WeakPtr<tabs::TabInterface>> requested;
+  std::vector<base::WeakPtr<BrowserView>> owners;
+  std::vector<base::WeakPtr<content::WebContents>> contents_before;
+  std::vector<base::WeakPtr<tabs::TabInterface>> owner_active_before;
+  for (auto* tab : panes) {
+    auto* owner = tab ? BrowserView::GetBrowserViewForBrowser(tab->GetBrowserWindowInterface()) : nullptr;
+    if (!owner || owner->browser_widget() != this || owner->GetProfile()->IsOffTheRecord() ||
+        owner->browser()->IsDeleteScheduled() ||
+        owner->browser()->GetType() != BrowserWindowInterface::Type::TYPE_NORMAL ||
+        std::ranges::any_of(requested, [tab](const auto& existing) { return existing.get() == tab; })) {
+      return false;
+    }
+    auto* owner_active = owner->browser()->GetTabStripModel()->GetActiveTab();
+    if (!owner_active) {
+      return false;
+    }
+    requested.push_back(tab->GetWeakPtr());
+    owners.push_back(owner->GetAsWeakPtr());
+    contents_before.push_back(tab->GetContents()->GetWeakPtr());
+    owner_active_before.push_back(owner_active->GetWeakPtr());
+  }
+  auto active_tab = active->GetWeakPtr();
+  std::vector<tabs::TabInterface*> old_tabs;
+  split_tabs::SplitTabVisualData old_visual;
+  tabs::TabInterface* old_active = nullptr;
+  uint64_t old_generation = 0;
+  std::vector<base::WeakPtr<tabs::TabInterface>> old;
+  base::WeakPtr<tabs::TabInterface> old_active_weak;
+  if (GetBarcPresentedTabs(&old_tabs, &old_visual, &old_active, &old_generation)) {
+    if (old_tabs.size() == panes.size() && std::ranges::equal(old_tabs, panes) &&
+        old_visual == visual_data && old_active == active) {
+      return true;
+    }
+    for (auto* tab : old_tabs) {
+      old.push_back(tab->GetWeakPtr());
+    }
+    old_active_weak = old_active->GetWeakPtr();
+  } else if (barc_presented_contents_) {
+    return false;
+  }
+  ClearBarcPresentedTabs();
+  auto current = [&] {
+    if (!alive || selection != barc_selection_epoch_ || IsClosed() ||
+        !active_tab || !active_tab->IsActivated() || !selected_browser_view() ||
+        active_tab->GetBrowserWindowInterface() != selected_browser_view()->browser()) {
+      return false;
+    }
+    for (size_t i = 0; i < requested.size(); ++i) {
+      if (!requested[i] || !owners[i] || !contents_before[i] || !owner_active_before[i] ||
+          owners[i]->browser_widget() != this ||
+          owners[i]->browser()->GetTabStripModel()->GetActiveTab() != owner_active_before[i].get() ||
+          requested[i]->GetContents() != contents_before[i].get() ||
+          requested[i]->GetBrowserWindowInterface() != owners[i]->browser() ||
+          owners[i]->browser()->IsDeleteScheduled()) {
+        return false;
+      }
+    }
+    return true;
+  };
+  if (!current() || barc_presented_contents_ ||
+      barc_presentation_generation_ != generation_before) {
+    return false;
+  }
+#if BUILDFLAG(ENTERPRISE_SCREENSHOT_PROTECTION)
+  // Owner-view staging can expose a previously inactive document before the
+  // physical pane set exists. Remain conservative until actual readback.
+  SetAllowScreenshots(false);
+  base::ScopedClosureRunner refresh_capture_policy(base::BindOnce(
+      [](base::WeakPtr<views::Widget> widget) {
+        if (widget && !widget->IsClosed()) {
+          static_cast<BrowserWidget*>(widget.get())->UpdateBarcPresentedScreenshotPolicy();
+        }
+      }, alive));
+#endif
+  changing_barc_presentation_ = true;
+  base::ScopedClosureRunner finish_preparation(base::BindOnce(
+      [](base::WeakPtr<views::Widget> widget) {
+        if (widget) {
+          static_cast<BrowserWidget*>(widget.get())->changing_barc_presentation_ = false;
+        }
+      }, alive));
+  bool prepared = true;
+  std::vector<base::WeakPtr<BrowserView>> prepared_owners;
+  for (size_t i = 0; prepared && i < owners.size(); ++i) {
+    if (std::ranges::any_of(prepared_owners, [&](const auto& owner) { return owner.get() == owners[i].get(); })) {
+      continue;
+    }
+    auto owner = owners[i];
+    std::vector<content::WebContents*> contents;
+    for (size_t j = 0; j < requested.size(); ++j) {
+      if (owners[j].get() == owner.get()) {
+        contents.push_back(requested[j]->GetContents());
+      }
+    }
+    prepared_owners.push_back(owner);
+    auto* local = owner->multi_contents_view();
+    if (contents.size() == 1) {
+      local->CloseSplitView();
+      prepared = current();
+      if (prepared) {
+        local->SetWebContentsAtIndex(contents[0], 0);
+        prepared = current();
+      }
+      if (prepared) {
+        local->contents_container_views()[0]->SetVisible(true);
+        prepared = current();
+      }
+    } else {
+      const auto local_visual = split_tabs::SplitTabVisualData::EqualSplit(
+          visual_data.split_layout(), contents.size());
+      local->UpdateSplitVisualData(local_visual);
+      prepared = current();
+      if (prepared) {
+        local->SetSplitContents(contents);
+        prepared = current();
+      }
+      if (prepared) {
+        local->ShowSplitView(local_visual);
+        prepared = current();
+      }
+    }
+  }
+  finish_preparation.RunAndReset();
+  uint64_t created_generation = 0;
+  if (prepared && current() && PresentBarcTabsImpl(
+          panes, visual_data, active_tab.get(), &created_generation) && current()) {
+    return true;
+  }
+  const uint64_t owned_generation = created_generation ? created_generation : generation_before;
+  if (!alive || barc_presentation_generation_ != owned_generation ||
+      (barc_presented_contents_ && !created_generation)) {
+    return false;
+  }
+  // No callout may install another presentation while owner mappings are being
+  // reconciled. The generation check above excludes a newer mounted view.
+  changing_barc_presentation_ = true;
+  base::ScopedClosureRunner finish_rollback(base::BindOnce(
+      [](base::WeakPtr<views::Widget> widget) {
+        if (widget) {
+          static_cast<BrowserWidget*>(widget.get())->changing_barc_presentation_ = false;
+        }
+      }, alive));
+  if (barc_presented_contents_) {
+    ClearBarcPresentedTabs();
+  }
+  for (const auto& owner : prepared_owners) {
+    if (!alive || barc_presentation_generation_ != owned_generation || barc_presented_contents_) {
+      return false;
+    }
+    if (owner) {
+      RestoreBarcOwnerContents(owner.get());
+    }
+  }
+  finish_rollback.RunAndReset();
+  // Only restore the old physical layout while the same operation still owns
+  // selection. Any newer close, transfer or selection wins over this rollback.
+  if (current() && barc_presentation_generation_ == owned_generation && old_active_weak && old_active_weak->IsActivated() &&
+      std::ranges::all_of(old, [](const auto& tab) { return !!tab; }) &&
+      !old.empty() && !barc_presented_contents_) {
+    std::vector<tabs::TabInterface*> restored;
+    for (const auto& tab : old) {
+      restored.push_back(tab.get());
+    }
+    SetBarcPresentedTabs(restored, old_visual, old_active_weak.get());
+  }
+  return false;
+#endif
+}
+
+bool BrowserWidget::HasBarcPresentedTabs() const {
+  return barc_presented_contents_ != nullptr;
+}
+
+bool BrowserWidget::GetBarcPresentedTabs(
+    std::vector<tabs::TabInterface*>* panes,
+    split_tabs::SplitTabVisualData* visual_data,
+    tabs::TabInterface** active,
+    uint64_t* generation) const {
+  if (!panes || !visual_data || !active || !generation ||
+      changing_barc_presentation_ || clearing_barc_presentation_ ||
+      !barc_presented_contents_ || !barc_presented_contents_->GetVisible() ||
+      barc_presented_tabs_.size() < 2 ||
+      barc_presented_contents_->GetPaneCount() != barc_presented_tabs_.size() ||
+      !selected_browser_view()) {
+    return false;
+  }
+  std::vector<tabs::TabInterface*> result;
+  for (const auto& weak : barc_presented_tabs_) {
+    auto* tab = weak.get();
+    auto* owner = tab ? BrowserView::GetBrowserViewForBrowser(
+        tab->GetBrowserWindowInterface()) : nullptr;
+    auto* container = owner ? owner->GetContentsContainerViewFor(tab->GetContents()) : nullptr;
+    if (!owner || owner->browser_widget() != this || owner->GetProfile()->IsOffTheRecord() ||
+        !container || container->parent() != barc_presented_contents_ ||
+        container->contents_view()->web_contents() != tab->GetContents()) {
+      return false;
+    }
+    result.push_back(tab);
+  }
+  const int index = barc_presented_contents_->GetActiveIndex();
+  if (index < 0 || static_cast<size_t>(index) >= result.size() ||
+      !result[index]->IsActivated() ||
+      result[index]->GetBrowserWindowInterface() != selected_browser_view()->browser()) {
+    return false;
+  }
+  std::vector<double> cuts;
+  for (size_t i = 0; i + 1 < result.size(); ++i) {
+    cuts.push_back(barc_presented_contents_->GetDividerRatio(i));
+  }
+  *visual_data = split_tabs::SplitTabVisualData(barc_presented_contents_->GetSplitLayout(), cuts);
+  *active = result[index];
+  *panes = std::move(result);
+  *generation = barc_presentation_generation_;
+  return true;
+}
+
+bool BrowserWidget::HasBarcPresentedContents(const BrowserView* owner) const {
+  return owner && barc_presented_contents_ && std::ranges::any_of(
+      barc_presented_tabs_, [owner](const auto& tab) {
+        return tab && tab->GetBrowserWindowInterface() == owner->browser();
+      });
+}
+
+void BrowserWidget::ClearBarcPresentedTabs() {
+  ClearBarcPresentedTabsImpl(false);
+}
+
+void BrowserWidget::ClearBarcPresentedTabsImpl(bool native_destroying) {
+  if (!barc_presented_contents_ ||
+      (clearing_barc_presentation_ && !native_destroying)) {
+    return;
+  }
+#if BUILDFLAG(IS_MAC)
+  auto mutation = barc::ProtectNativeViewMutation();
+#endif
+  // Normal recursive clear is inert; logical close during hierarchy callbacks
+  // is deferred. Native destruction cannot wait: drain every still-parented
+  // container before any logical feature/view teardown, skipping ones already
+  // returned by an outer clear. Stack trackers make the outer pass inert.
+  clearing_barc_presentation_ = true;
+  auto alive = GetWeakPtr();
+  views::ViewTracker presentation(barc_presented_contents_);
+  auto* physical = barc_presented_contents_.get();
+  // Original logical owners still exist here: WillDetach and native-destroying
+  // call this before features/views disappear. Never substitute another profile.
+  std::vector<std::pair<std::unique_ptr<views::ViewTracker>, base::WeakPtr<BrowserView>>> returned;
+  for (const auto& container : physical->contents_container_views()) {
+    returned.emplace_back(std::make_unique<views::ViewTracker>(container.get()),
+                          container->browser_view()->GetAsWeakPtr());
+  }
+  physical->StopObservingPresentedContainers();
+  for (const auto& [container_tracker, owner] : returned) {
+    if (!alive || !presentation) {
+      return;
+    }
+    auto* container = static_cast<ContentsContainerView*>(container_tracker->view());
+    if (container && container->parent() == physical) {
+      CHECK(owner);
+      const bool restored = owner->multi_contents_view()->ReturnContainerFromPresentation(container);
+      if (!alive || !presentation) {
+        return;
+      }
+      if (barc_presented_contents_ != physical) {
+        return;
+      }
+      CHECK(restored);
+    }
+  }
+  if (!alive || !presentation) {
+    return;
+  }
+  barc_presented_contents_ = nullptr;
+  barc_presented_tabs_.clear();
+  barc_presented_subscriptions_.clear();
+  // No retained physical view may keep raw pointers into an owner that can now
+  // be destroyed. Containers have already been returned to their exact owners.
+  physical->ForgetReturnedPresentedContainers();
+  auto retirement = barc_presentation_retirement_.lock();
+  auto removed = non_client_view()->RemoveChildViewT(physical);
+  if (retirement) {
+    CHECK(!*retirement);
+    *retirement = std::move(removed);
+  } else {
+    removed.reset();
+  }
+  if (!alive) {
+    return;
+  }
+  if (!native_destroying) {
+    std::vector<base::WeakPtr<BrowserView>> restored_owners;
+    for (const auto& [container_tracker, owner] : returned) {
+      if (!alive) {
+        return;
+      }
+      if (owner && !std::ranges::any_of(restored_owners, [&](const auto& prior) { return prior.get() == owner.get(); })) {
+        restored_owners.push_back(owner);
+        RestoreBarcOwnerContents(owner.get());
+      }
+    }
+  }
+  if (!alive) {
+    return;
+  }
+  clearing_barc_presentation_ = false;
+#if BUILDFLAG(IS_MAC)
+  barc::BrowserDiscoveryChanged();
+#endif
+  if (!alive || changing_barc_presentation_ || !selected_browser_view()) {
+    return;
+  }
+#if BUILDFLAG(ENTERPRISE_SCREENSHOT_PROTECTION)
+  auto owner = selected_browser_view()->GetAsWeakPtr();
+  if (owner && !owner->browser()->IsDeleteScheduled()) {
+    if (auto* controller = enterprise_data_protection::DataProtectionUIController::From(owner->browser())) {
+      controller->MaybeUpdateScreenshotSettings();
+    }
+  }
+#endif
+}
+
+void BrowserWidget::SelectBarcPresentedContents(content::WebContents* contents) {
+  if (!barc_presented_contents_ || changing_barc_presentation_) {
+    return;
+  }
+#if BUILDFLAG(IS_MAC)
+  auto mutation = barc::ProtectNativeViewMutation();
+#endif
+  auto found = std::ranges::find_if(barc_presented_tabs_, [contents](const auto& tab) {
+    return tab && tab->GetContents() == contents;
+  });
+  if (found == barc_presented_tabs_.end()) {
+    return;
+  }
+  auto tab = *found;
+  auto* owner = BrowserView::GetBrowserViewForBrowser(tab->GetBrowserWindowInterface());
+  auto alive = GetWeakPtr();
+  changing_barc_presentation_ = true;
+  auto finished = [&] {
+    if (alive) {
+      changing_barc_presentation_ = false;
+    }
+  };
+  if (!SelectLogicalBrowserView(owner) || !alive || !tab || !barc_presented_contents_) {
+    finished();
+    return;
+  }
+  // The profile owner remains the real command/extension target. Reconcile
+  // its mounted active container before ActivateTabAt's observer callouts.
+  auto owner_alive = owner->GetAsWeakPtr();
+  auto* model = owner->browser()->GetTabStripModel();
+  const int index = model->GetIndexOfWebContents(tab->GetContents());
+  if (index == TabStripModel::kNoTab) {
+    finished();
+    return;
+  }
+  owner->multi_contents_view()->SetActiveContents(tab->GetContents());
+  model->ActivateTabAt(index);
+  if (!alive || !owner_alive || !tab || !barc_presented_contents_ ||
+      selected_browser_view() != owner_alive.get() ||
+      tab->GetBrowserWindowInterface() != owner_alive->browser() ||
+      owner_alive->browser()->GetTabStripModel()->GetActiveWebContents() != tab->GetContents()) {
+    finished();
+    return;
+  }
+  barc_presented_contents_->SetActiveContents(tab->GetContents());
+  finished();
+}
+
+void BrowserWidget::ReconcileBarcActiveTab(BrowserView* owner,
+                                           content::WebContents* contents) {
+  if (!barc_presented_contents_ || !HasBarcPresentedContents(owner)) {
+    return;
+  }
+  const auto shown = std::ranges::find_if(barc_presented_tabs_, [contents](const auto& tab) {
+    return tab && tab->GetContents() == contents;
+  });
+  if (shown == barc_presented_tabs_.end()) {
+    ClearBarcPresentedTabs();
+    return;
+  }
+  owner->multi_contents_view()->SetActiveContents(contents);
+  if (selected_browser_view() == owner) {
+    barc_presented_contents_->SetActiveContents(contents);
+  }
+}
+
+void BrowserWidget::ResizeBarcPresentedContents(base::span<const double> dividers) {
+  if (!barc_presented_contents_ || dividers.size() + 1 != barc_presented_tabs_.size() ||
+      !split_tabs::SplitTabVisualData::AreValidDividers(dividers)) {
+    return;
+  }
+#if BUILDFLAG(IS_MAC)
+  auto mutation = barc::ProtectNativeViewMutation();
+#endif
+  barc_presented_contents_->UpdateSplitVisualData(split_tabs::SplitTabVisualData(
+      barc_presented_contents_->GetSplitLayout(), dividers));
+#if BUILDFLAG(IS_MAC)
+  barc::BrowserDiscoveryChanged();
+#endif
+}
+
+void BrowserWidget::ReverseBarcPresentedContents() {
+  if (!barc_presented_contents_) {
+    return;
+  }
+#if BUILDFLAG(IS_MAC)
+  auto mutation = barc::ProtectNativeViewMutation();
+#endif
+  auto alive = GetWeakPtr();
+  views::ViewTracker presentation(barc_presented_contents_);
+  barc_presented_contents_->ReversePresentedContainers();
+  if (!alive || !presentation || barc_presented_contents_ != presentation.view()) {
+    return;
+  }
+  std::ranges::reverse(barc_presented_tabs_);
+#if BUILDFLAG(IS_MAC)
+  barc::BrowserDiscoveryChanged();
+#endif
+}
+
+void BrowserWidget::LayoutBarcPresentedContents() {
+  if (!barc_presented_contents_ || !selected_browser_view()) {
+    return;
+  }
+#if BUILDFLAG(IS_MAC)
+  auto mutation = barc::ProtectNativeViewMutation();
+#endif
+  auto alive = GetWeakPtr();
+  const bool previously_changing = changing_barc_presentation_;
+  changing_barc_presentation_ = true;
+  auto finished = [&] {
+    if (alive) {
+      changing_barc_presentation_ = previously_changing;
+    }
+  };
+  views::ViewTracker presentation(barc_presented_contents_);
+  LayoutRootViewIfNecessary();
+  if (!alive || !presentation || barc_presented_contents_ != presentation.view() ||
+      !selected_browser_view()) {
+    finished();
+    return;
+  }
+  auto* logical = selected_browser_view()->multi_contents_view();
+  const gfx::Rect bounds = views::View::ConvertRectToTarget(
+      logical, non_client_view(), logical->GetLocalBounds());
+  barc_presented_contents_->SetBoundsRect(bounds);
+  if (!alive || !presentation || barc_presented_contents_ != presentation.view()) {
+    finished();
+    return;
+  }
+  barc_presented_contents_->DeprecatedLayoutImmediately();
+  finished();
+}
+
+void BrowserWidget::OnNativeWidgetSizeChanged(const gfx::Size& new_size) {
+  auto alive = GetWeakPtr();
+  Widget::OnNativeWidgetSizeChanged(new_size);
+  if (alive) {
+    LayoutBarcPresentedContents();
+  }
+}
+
+void BrowserWidget::UpdateBarcPresentedScreenshotPolicy() {
+#if BUILDFLAG(ENTERPRISE_SCREENSHOT_PROTECTION)
+  if (!barc_presented_contents_) {
+    auto* owner = selected_browser_view();
+    if (owner && !owner->browser()->IsDeleteScheduled()) {
+      if (auto* controller = enterprise_data_protection::DataProtectionUIController::From(owner->browser())) {
+        controller->MaybeUpdateScreenshotSettings();
+      }
+    }
+    return;
+  }
+  bool allowed = true;
+  for (const auto& tab : barc_presented_tabs_) {
+    if (!tab || !tab->GetBrowserWindowInterface()) {
+      allowed = false;
+      break;
+    }
+    auto* controller = tab->GetTabFeatures()->data_protection_controller();
+    // Same per-tab policy used by the enrolled owner controller, limited to
+    // the actual physical panes rather than hidden/unpresented local siblings.
+    allowed &= controller && controller->screenshot_allowed();
+  }
+  SetAllowScreenshots(allowed);
+#endif
+}
