--- a/chrome/app/chrome_exe_main_mac.cc
+++ b/chrome/app/chrome_exe_main_mac.cc
@@ -219,7 +219,35 @@
   if (!chrome_main) {
     FatalError("dlsym %s: %s.", entry_symbol, dlerror());
   }
+#if !defined(HELPER_EXECUTABLE)
+  // The native Swift shell must load only after EarlyMallocZoneRegistration()
+  // and Chromium's allocator initialization in the framework. Keep the stock
+  // executable and helper bootstrap; no Swift/AppKit link dependency here.
+  static constexpr char native_relative_path[] =
+      "../Frameworks/NookNativeShell.dylib";
+  const size_t native_path_size =
+      parent_dir_len + sizeof(native_relative_path) + 1;
+  std::unique_ptr<char[]> native_path(new char[native_path_size]);
+  UNSAFE_TODO(snprintf(native_path.get(), native_path_size, "%s/%s", parent_dir,
+                       native_relative_path));
+  void* native_library =
+      dlopen(native_path.get(), RTLD_NOW | RTLD_LOCAL | RTLD_FIRST);
+  if (!native_library) {
+    FatalError("dlopen native shell %s: %s.", native_path.get(), dlerror());
+  }
+  using NativeMainPtr = int (*)(void*, int, const char**);
+  const auto native_main = reinterpret_cast<NativeMainPtr>(
+      dlsym(native_library, "barc_native_main"));
+  if (!native_main) {
+    FatalError("Native shell entry is missing.");
+  }
+  // Swift registers readiness and invokes ChromeMain exactly once with isolated
+  // arguments. Its argv and callback storage live until ChromeMain returns.
+  rv = native_main(library, argc, const_cast<const char**>(argv));
+  // Never dlclose: retain native code until the stock exit below.
+#else
   rv = chrome_main(argc, const_cast<const char**>(argv));
+#endif
 
   // exit, don't return from main, to avoid the apparent removal of main from
   // stack backtraces under tail call optimization.
