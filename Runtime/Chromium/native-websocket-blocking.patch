+void WebSocketConnectorImpl::ConnectAfterPolicyCheck(
+    const std::vector<std::string>& requested_protocols,
+    net::StorageAccessApiStatus storage_access_api_status,
+    const net::IsolationInfo& isolation_info,
+    const content::GlobalRenderFrameHostId& frame_id,
+    WeakDocumentPtr weak_document,
+    std::optional<base::UnguessableToken> devtools_worker_token,
+    const url::Origin& origin,
+    network::mojom::ClientSecurityStatePtr client_security_state,
+    uint32_t options,
+    std::optional<base::UnguessableToken> throttling_profile_id,
+    const base::UnguessableToken& network_restrictions_id,
+    network::mojom::IPAddressSpace target_address_space,
+    net::handles::NetworkHandle target_network,
+    const GURL& url,
+    std::vector<network::mojom::HttpHeaderPtr> additional_headers,
+    mojo::PendingRemote<network::mojom::WebSocketHandshakeClient>
+        handshake_client,
+    mojo::PendingRemote<network::mojom::WebSocketAuthenticationHandler>
+        auth_handler,
+    mojo::PendingRemote<network::mojom::TrustedHeaderClient>
+        trusted_header_client,
+    int error) {
+  auto* process = RenderProcessHost::FromID(frame_id.child_id);
+  auto* document = weak_document.AsRenderFrameHostIfValid();
+  if (!handshake_client.is_valid() ||
+      handshake_client.Pipe()->QuerySignalsState().peer_closed() ||
+      !process || process->GetBrowserContext()->ShutdownStarted() ||
+      (frame_id.frame_routing_id != IPC::mojom::kRoutingIdNone &&
+       (!document || !document->IsActive() ||
+        document != RenderFrameHost::FromID(frame_id)))) {
+    return;
+  }
+  if (error != net::OK) {
+    mojo::Remote<network::mojom::WebSocketHandshakeClient> client(
+        std::move(handshake_client));
+    client->OnFailure("WebSocket blocked by browser policy", error, -1);
     return;
   }
 
