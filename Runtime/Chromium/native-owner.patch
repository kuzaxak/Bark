+TEST_F(WidgetTest, RetainedClientDelegateLifetime) {
+  auto widget = base::WrapUnique(
+      CreateTopLevelPlatformWidget(Widget::InitParams::CLIENT_OWNS_WIDGET));
+  auto* owner = widget->non_client_view();
+  auto* primary_client = owner->client_view();
+  auto* primary_delegate = widget->widget_delegate();
+  auto secondary_delegate = std::make_unique<WidgetDelegate>();
+  int initialized = 0;
+  int closing = 0;
+  int client_closing = 0;
+  secondary_delegate->RegisterWidgetInitializedCallback(
+      base::BindLambdaForTesting([&] { ++initialized; }));
+  secondary_delegate->RegisterWindowClosingCallback(
+      base::BindLambdaForTesting([&] {
+        EXPECT_EQ(1, client_closing);
+        ++closing;
+      }));
+  class ClosingClient : public ClientView {
+   public:
+    ClosingClient(Widget* widget, base::OnceClosure on_close)
+        : ClientView(widget, new View()), on_close_(std::move(on_close)) {}
+    void WidgetClosing() override { std::move(on_close_).Run(); }
+
+   private:
+    base::OnceClosure on_close_;
+  };
+  auto client = std::make_unique<ClosingClient>(widget.get(),
+                                                base::BindLambdaForTesting([&] {
+                                                  EXPECT_EQ(0, closing);
+                                                  ++client_closing;
+                                                }));
+  auto* secondary_client = client.get();
+  widget->RetainClientFrame(std::make_unique<NativeFrameView>(widget.get()),
+                            std::move(client), secondary_delegate.get());
+  EXPECT_EQ(1, initialized);
+  EXPECT_EQ(widget.get(), secondary_delegate->GetWidget());
+  const auto native_window = widget->GetNativeWindow();
+  for (int i = 0; i < 3; ++i) {
+    widget->SelectClientDelegate(secondary_delegate.get());
+    ASSERT_TRUE(owner->SelectClientFrame(secondary_client));
+    EXPECT_EQ(secondary_delegate.get(), widget->widget_delegate());
+    widget->SelectClientDelegate(primary_delegate);
+    ASSERT_TRUE(owner->SelectClientFrame(primary_client));
+  }
+  EXPECT_EQ(1, initialized);
+  EXPECT_EQ(0, closing);
+  auto released = owner->ReleaseClientFrame(secondary_client);
+  ASSERT_TRUE(released);
+  widget->FinalizeClientDelegate(secondary_client, secondary_delegate.get());
+  EXPECT_EQ(nullptr, secondary_delegate->GetWidget());
+  EXPECT_EQ(1, closing);
+  EXPECT_EQ(1, client_closing);
+  released.reset();
+  secondary_delegate.reset();
+  EXPECT_FALSE(widget->IsClosed());
+  EXPECT_EQ(primary_delegate, widget->widget_delegate());
+  EXPECT_EQ(primary_client, owner->client_view());
+  EXPECT_EQ(native_window, widget->GetNativeWindow());
+}
+
+TEST_F(WidgetTest, PhysicalCloseFinalizesRetainedDelegates) {
+  int primary_closing = 0;
+  int secondary_closing = 0;
+  auto secondary_delegate = std::make_unique<WidgetDelegate>();
+  auto widget = base::WrapUnique(
+      CreateTopLevelPlatformWidget(Widget::InitParams::CLIENT_OWNS_WIDGET));
+  auto* owner = widget->non_client_view();
+  auto* primary_delegate = widget->widget_delegate();
+  primary_delegate->RegisterWindowClosingCallback(
+      base::BindLambdaForTesting([&] { ++primary_closing; }));
+  secondary_delegate->RegisterWindowClosingCallback(
+      base::BindLambdaForTesting([&] { ++secondary_closing; }));
+  auto client = std::make_unique<ClientView>(widget.get(), new View());
+  auto* secondary_client = client.get();
+  widget->RetainClientFrame(std::make_unique<NativeFrameView>(widget.get()),
+                            std::move(client), secondary_delegate.get());
+  // The delegate lifetime binding must survive active frame/theme replacement.
+  owner->SetFrameView(std::make_unique<NativeFrameView>(widget.get()));
+  widget->SelectClientDelegate(secondary_delegate.get());
+  ASSERT_TRUE(owner->SelectClientFrame(secondary_client));
+  widget->CloseNow();
+  EXPECT_EQ(1, primary_closing);
+  EXPECT_EQ(1, secondary_closing);
+  EXPECT_EQ(nullptr, secondary_delegate->GetWidget());
+  widget.reset();
+  // Both inactive and selected delegates were finalized before frames died.
+  // Destruction would CHECK otherwise; the physical host was closed only once.
+  secondary_delegate.reset();
+}
