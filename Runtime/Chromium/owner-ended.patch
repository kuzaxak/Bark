+void BrowserWidget::OnNativeWidgetDestroying() {
+  // Mark every logical owner before the first BrowserView observer destroys
+  // tabs and delivers foreign CLOSED callbacks that may query another owner.
+  for (BrowserView* view : GetLogicalBrowserViews()) {
+    UnloadController::From(view->browser())->OnNativeWindowDestroying();
+  }
+  Widget::OnNativeWidgetDestroying();
+}
