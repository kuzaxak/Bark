+TEST_F(WidgetTest, RetainedClientFramesShareOneWidget) {
+  auto widget = base::WrapUnique(
+      CreateTopLevelPlatformWidget(Widget::InitParams::CLIENT_OWNS_WIDGET));
+  widget->SetBounds(gfx::Rect(40, 40, 640, 480));
+  auto* owner = widget->non_client_view();
+  auto* first = owner->client_view();
+  auto* first_frame = owner->frame_view();
+  auto* first_field = first->AddChildView(std::make_unique<Textfield>());
+  first_field->SetText(u"first draft");
+  first_field->SetBounds(0, 0, 100, 30);
+  auto second_field = std::make_unique<Textfield>();
+  auto* second_field_ptr = second_field.get();
+  second_field->SetText(u"second draft");
+  auto second = std::make_unique<RetainedClientTestClient>(
+      widget.get(), second_field.release());
+  auto* second_ptr = second.get();
+  auto frame = std::make_unique<NativeFrameView>(widget.get());
+  auto* second_frame = frame.get();
+  ClientFrameVisibilityObserver shown(second_frame);
+  owner->RetainClientFrame(std::move(frame), std::move(second));
+  const auto native_window = widget->GetNativeWindow();
+  widget->Show();
+  RunScheduledLayout(owner);
+  EXPECT_EQ(widget.get(), second_ptr->GetWidget());
+  EXPECT_FALSE(second_field_ptr->IsDrawn());
+  EXPECT_FALSE(second_field_ptr->IsFocusable());
+  for (int i = 0; i < 3; ++i) {
+    widget->SetBounds(gfx::Rect(40, 40, 700 + i * 20, 500 + i * 20));
+    RunScheduledLayout(owner);
+    // An inactive frame must lay out and query its own client, even though
+    // Widget::client_view() still returns the first selected client.
+    const gfx::Rect first_bounds = first->bounds();
+    const gfx::Rect inactive_bounds(0, 0, 431 + i, 337 + i);
+    second_frame->SetBoundsRect(inactive_bounds);
+    second_frame->DeprecatedLayoutImmediately();
+    EXPECT_EQ(first_bounds, first->bounds());
+    EXPECT_EQ(inactive_bounds, second_ptr->bounds());
+    EXPECT_EQ(gfx::Size(263, 197), second_frame->GetPreferredSize({}));
+    EXPECT_EQ(gfx::Size(171, 183), second_frame->GetMinimumSize());
+    EXPECT_EQ(gfx::Size(901, 811), second_frame->GetMaximumSize());
+    EXPECT_EQ(HTCAPTION, second_frame->NonClientHitTest(gfx::Point(5, 5)));
+    ASSERT_TRUE(owner->SelectClientFrame(second_ptr));
+    RunScheduledLayout(owner);
+    EXPECT_TRUE(second_field_ptr->IsDrawn());
+    EXPECT_FALSE(first_field->IsDrawn());
+    EXPECT_FALSE(first_field->IsFocusable());
+    second_field_ptr->RequestFocus();
+    EXPECT_EQ(second_field_ptr, widget->GetFocusManager()->GetFocusedView());
+    EXPECT_TRUE(second_frame->Contains(
+        owner->GetEventHandlerForPoint(gfx::Point(5, 5))));
+    ASSERT_TRUE(owner->SelectClientFrame(first));
+    EXPECT_FALSE(second_field_ptr->IsFocusable());
+    EXPECT_EQ(widget.get(), second_ptr->GetWidget());
+    EXPECT_EQ(native_window, widget->GetNativeWindow());
+    EXPECT_EQ(first_frame, owner->frame_view());
+  }
+  EXPECT_EQ(3, shown.shows);
+  EXPECT_EQ(u"first draft", first_field->GetText());
+  EXPECT_EQ(u"second draft", second_field_ptr->GetText());
+  // Replacing the active theme frame must leave the inactive pair attached.
+  owner->SetFrameView(std::make_unique<RetainedClientTestFrame>());
+  EXPECT_EQ(widget.get(), second_ptr->GetWidget());
+  ASSERT_TRUE(owner->SelectClientFrame(second_ptr));
+  // The outgoing native frame is unbound before its client is reparented.
