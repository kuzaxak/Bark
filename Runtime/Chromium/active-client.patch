+class UnboundClientFrameObserver : public ViewObserver {
+ public:
+  UnboundClientFrameObserver(FrameView* frame, ClientView* inactive)
+      : inactive_(inactive), observation_(this) {
+    observation_.Observe(frame);
+  }
+  void OnChildViewRemoved(View* view, View* child) override {
+    auto* frame = static_cast<FrameView*>(view);
+    EXPECT_EQ(nullptr, frame->client_view());
+    EXPECT_EQ(gfx::Size(), frame->GetPreferredSize());
+    EXPECT_EQ(gfx::Size(), frame->GetMinimumSize());
+    EXPECT_EQ(gfx::Size(), frame->GetMaximumSize());
+    EXPECT_EQ(HTNOWHERE, frame->NonClientHitTest(gfx::Point(5, 5)));
+    const gfx::Rect inactive_bounds = inactive_->bounds();
+    const gfx::Rect moved_bounds = child->bounds();
+    frame->SetBoundsRect(gfx::Rect(0, 0, 287, 219));
+    frame->DeprecatedLayoutImmediately();
+    EXPECT_EQ(inactive_bounds, inactive_->bounds());
+    EXPECT_EQ(moved_bounds, child->bounds());
+    ++removals;
+  }
+  void OnViewIsDeleting(View* view) override { observation_.Reset(); }
+  int removals = 0;
+
+ private:
+  raw_ptr<ClientView> inactive_;
+  base::ScopedObservation<View, ViewObserver> observation_;
+};
